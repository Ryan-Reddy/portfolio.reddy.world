{
  "name": "portfolio.reddy.world",
  "version": "1.0.0",
  "private": true,
  "description": "Selected visual archive of Ryan Reddy: ReddyMaekers, RRproductions and modelling work",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node --import ./scripts/lib/json-imports.mjs scripts/keyword-ratings.mjs && astro build && node scripts/watermark.mjs && node scripts/check-watermark.mjs && node scripts/firebase-config.mjs",
    "mark:make": "node scripts/watermark/make-mark.mjs",
    "preview": "astro preview",
    "import": "python scripts/parse_wordpress.py",
    "media:self-host": "node scripts/self-host-wordpress.mjs",
    "media:capture": "node scripts/wordpress-capture.mjs",
    "keywords:import": "node scripts/import-image-keywords.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "keywords:rate": "node --import ./scripts/lib/json-imports.mjs scripts/keyword-ratings.mjs",
    "media:videos": "node scripts/wordpress-videos.mjs",
    "media:inventory": "node scripts/wordpress-inventory.mjs",
    "media:unused": "node scripts/wordpress-unused.mjs"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "playwright": "1.61.0",
    "qrcode": "1.5.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "firebase": "^13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
