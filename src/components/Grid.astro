---
import Card from './Card.astro';

// rows: [{ name, key, label, chips: [{ label, value }] }]. Each row is one question
// ("What", "Where", "Portfolio"); one chip per row can be on, and the rows combine.
// key 'kinds' matches a card's kinds (a card can have several); key 'portfolio'
// matches its portfolio. ?what=signage&where=clubs (one parameter per row name)
// opens the page with those chips on, so a filtered view can be linked.
// series: [{ label, href }] links to client and series pages, folded away under one line.
const { posts, rows = [], series = [], showPortfolio = false } = Astro.props;
const shown = rows.filter((r) => r.chips.length > 1);
---
<div class="toolbar-wrapper">
  <div class="toolbar-inner">
    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none"/>
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2"/>
      </svg>
      <input type="search" id="search-input" placeholder="Search projects, festivals, materials..." aria-label="Search projects">
    </div>
    {shown.map((row) => (
      <div class="filter-row">
        <span class="filter-label" id={`filter-${row.name}`}>{row.label}</span>
        <div class="categories-scroll" role="toolbar" aria-labelledby={`filter-${row.name}`} data-row={row.name} data-key={row.key}>
          <button type="button" class="chip-btn active" data-value="" aria-pressed="true">All</button>
          {row.chips.map((c) => <button type="button" class="chip-btn" data-value={c.value} aria-pressed="false">{c.label}</button>)}
        </div>
      </div>
    ))}
    {series.length > 0 && (
      <details class="series-links">
        <summary>Clients &amp; series</summary>
        <ul>{series.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </details>
    )}
  </div>
</div>

<section class="gallery-section" aria-label="Projects">
  <div class="gallery-container" id="projects-grid">
    {posts.map((post) => <Card post={post} showPortfolio={showPortfolio} />)}
  </div>
  <div class="empty-state" id="empty-state" hidden>
    <p>No projects match your search or filter.</p>
    <button type="button" class="btn-reset" id="btn-reset-filters">Clear filters</button>
  </div>
</section>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const bars = [...document.querySelectorAll<HTMLElement>('.categories-scroll')];
  const cards = [...document.querySelectorAll<HTMLElement>('#projects-grid .card')];
  const empty = document.getElementById('empty-state')!;
  const chosen = new Map<HTMLElement, string>();

  function matches(card: HTMLElement, key: string, value: string) {
    return key === 'portfolio'
      ? card.dataset.portfolio === value
      : (card.dataset.kinds ?? '').split('|').includes(value);
  }

  function apply() {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const ok = bars.every((bar) => !chosen.get(bar) || matches(card, bar.dataset.key!, chosen.get(bar)!))
        && (!q || (card.dataset.search ?? '').includes(q));
      card.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
  }

  function select(bar: HTMLElement, btn: HTMLButtonElement) {
    chosen.set(bar, btn.dataset.value ?? '');
    bar.querySelectorAll('.chip-btn').forEach((b) => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-pressed', String(b === btn));
    });
    // keep the choice in the address, so the filtered view can be shared
    const url = new URL(location.href);
    url.searchParams.delete('tag');
    if (btn.dataset.value) url.searchParams.set(bar.dataset.row!, btn.dataset.value);
    else url.searchParams.delete(bar.dataset.row!);
    history.replaceState(null, '', url);
    apply();
  }

  for (const bar of bars) {
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip-btn');
      if (btn) select(bar, btn);
    });
  }
  input.addEventListener('input', apply);
  document.getElementById('btn-reset-filters')!.addEventListener('click', () => {
    input.value = '';
    for (const bar of bars) select(bar, bar.querySelector<HTMLButtonElement>('.chip-btn')!);
  });

  // ?what=signage&where=clubs; the older ?tag=signage still works
  const params = new URLSearchParams(location.search);
  if (params.has('tag') && !params.has('what')) params.set('what', params.get('tag')!);
  for (const bar of bars) {
    const value = params.get(bar.dataset.row!);
    const btn = value && bar.querySelector<HTMLButtonElement>(`.chip-btn[data-value="${CSS.escape(value)}"]`);
    if (btn) select(bar, btn);
  }
</script>
