---
// One article's page (src/content/articles/<slug>.md): an interview, a story, a case study, a project,
// a recipe, writing or a poem, on the case studies' paper layout. Started as the interview page of
// portfolio.reddy.world#65 (reddy.world#176).
import Base from '../layouts/Base.astro';
import {pageLayout,bannerVideo,bannerFocus} from '../lib/page-layout.js';
import {videoFigure} from '../lib/article-video.js';
import '../styles/page-layout.css';
import { getEntry, render } from 'astro:content';
import { PERSON_ID, ORIGIN, SITE, BASE } from '../lib/portfolios.js';
import { pictureAt } from '../lib/software.js';
import { imageRights } from '../lib/image-rights.js';
import { httpUrl } from '../lib/safe-output.js';
import { KINDS, articlePath, articleImages } from '../lib/article-kinds.js';
import {CRAFTS} from '../lib/piece-fields.js';
import '../styles/software.css';

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const kind = KINDS[d.kind];
const pageUrl = `${SITE}/${articlePath(d.kind, entry.id)}`;
const related = d.related ? await getEntry(d.related) : null;
const relatedUrl = related && `${SITE}/software/${related.id}/`;
const who = d.person;
// the intro is Ryan's own words, one paragraph per blank line
const intro = d.intro?.text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const hero = d.hero && { ...(await pictureAt(articleImages(entry.id), d.hero.file)), alt: d.hero.alt };
// the link card (LinkedIn and others): the JPEG copy when there is one, else the picture itself
const card = d.hero?.share && (await pictureAt(articleImages(entry.id), d.hero.share));
const shareImage = hero && (card
  ? { url: `${ORIGIN}${card.url}`, width: card.width, height: card.height, alt: hero.alt }
  : { url: `${ORIGIN}${hero.url}`, width: hero.width, height: hero.height, alt: hero.alt });
// the role's own words, the ones in `roleLinks` linked to where they stand (first time each appears)
function linkedParts(text, links = {}) {
  const parts = [];
  let rest = text;
  const keys = Object.keys(links);
  while (rest) {
    const hits = keys.map((key) => [key, rest.indexOf(key)]).filter(([, at]) => at >= 0).sort((a, b) => a[1] - b[1] || b[0].length - a[0].length);
    if (!hits.length) { parts.push({ text: rest }); break; }
    const [key, at] = hits[0];
    if (at) parts.push({ text: rest.slice(0, at) });
    parts.push({ text: key, href: links[key] });
    keys.splice(keys.indexOf(key), 1);
    rest = rest.slice(at + key.length);
  }
  return parts;
}
const roleParts = who ? linkedParts(who.role, who.roleLinks) : [];
// the pictures in the text, for the structured data
const figures = await Promise.all((d.figures ?? []).map(async (f) => ({ ...f, ...(await pictureAt(articleImages(entry.id), f.file)) })));
// a picture as an ImageObject: Ryan's own carry his rights; one he credited to a photographer is theirs
// (as on a project's page, src/pages/[portfolio]/[slug].astro)
const imageObject = (p) => {
  const object = {
    '@type': 'ImageObject',
    contentUrl: `${ORIGIN}${p.url}`,
    url: `${ORIGIN}${p.url}`,
    width: p.width,
    height: p.height,
    caption: p.alt,
    keywords: p.keywords?.length ? p.keywords.join(', ') : undefined,
    ...imageRights(p.url, PERSON_ID),
  };
  return p.credit?.name
    ? { ...object, creator: { '@type': 'Person', name: p.credit.name, url: httpUrl(p.credit.url) }, creditText: p.credit.name, copyrightNotice: undefined }
    : object;
};
const heroImage = hero && imageObject({ ...hero, keywords: d.hero.keywords, credit: d.hero.credit });
const heroCredit = d.hero?.credit;
const day = (date) => date.toISOString().slice(0, 10);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    // a poem is a creative work; everything else reads as an article
    '@type': d.kind === 'poem' ? 'CreativeWork' : 'Article',
    '@id': `${pageUrl}#work`,
    headline: d.title,
    name: d.title,
    genre: kind.label,
    keywords: d.tags.length ? d.tags.join(', ') : undefined,
    about: CRAFTS[d.craft],
    description: d.description,
    inLanguage: d.lang,
    dateCreated: String(d.year),
    datePublished: d.published ? day(d.published) : undefined,
    dateModified: day(d.updated),
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    author: { '@type': 'Person', '@id': PERSON_ID, name: 'Ryan Reddy', url: `${ORIGIN}/` },
    contributor: who ? {
      '@type': 'Person',
      name: who.name,
      jobTitle: who.role,
      url: who.profile,
      sameAs: who.profile ? [who.profile] : undefined,
      worksFor: who.org ? { '@type': 'Organization', name: who.org, url: who.orgUrl, sameAs: who.orgSameAs } : undefined,
    } : undefined,
    isPartOf: related ? { '@type': 'CreativeWork', '@id': `${relatedUrl}#work`, name: related.data.title, url: relatedUrl } : undefined,
    // the lead first: search engines take the first as the article's picture
    image: figures.length ? [heroImage, ...figures.map(imageObject)].filter(Boolean) : heroImage || undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: `${SITE}/` },
      ...(related ? [
        { '@type': 'ListItem', position: 2, name: 'Software', item: `${SITE}/software/` },
        { '@type': 'ListItem', position: 3, name: related.data.title, item: relatedUrl },
      ] : []),
      { '@type': 'ListItem', position: related ? 4 : 2, name: d.title, item: pageUrl },
    ],
  },
];
---
<Base
  title={`${d.seoTitle ?? d.title} · reddy.world`}
  description={d.description}
  image={shareImage}
  active={related ? 'software' : undefined}
  jsonLd={jsonLd}
  type="article"
  article={{ published: d.published ? day(d.published) : undefined, modified: day(d.updated), section: kind.label }}
  theme="paper"
  lang={d.lang}
  footnote={related ? 'Software and websites by Ryan Reddy.' : undefined}
>
  <article data-page-layout={pageLayout(d.pageLayout)} data-has-banner={Boolean(hero || bannerVideo(d.bannerVideo))} style={`--banner-focus:${bannerFocus(d.bannerFocus)}`} class:list={['case', 'article','page-layout', `article-${d.kind}`, { interview: d.kind === 'interview' }]} data-desk-article={entry.id}>
    <nav class="breadcrumb" aria-label="Breadcrumb" lang="en">
      <a href={`${BASE}/`}>Portfolio</a>
      {related && <Fragment> <span aria-hidden="true">/</span> <a href={`${BASE}/software/`}>Software</a> <span aria-hidden="true">/</span> <a href={`${BASE}/software/${related.id}/`}>{related.data.title}</a></Fragment>}
    </nav>

    <header class="case-head">
      <p class="eyebrow">{kind.label}{d.published && <Fragment> · <time datetime={day(d.published)}>{d.published.toLocaleDateString(d.lang === 'nl' ? 'nl-NL' : 'en-GB', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></Fragment>}</p>
      <h1 lang={d.titleLang}>{d.title}</h1>
      {who && <p class="dek">{d.byline} {who.profile ? <a href={who.profile} rel="noopener">{who.name}</a> : who.name},{' '}<span lang={who.roleLang}>{roleParts.map((part) => (part.href ? <a href={part.href} rel="noopener">{part.text}</a> : part.text))}</span></p>}
      {d.summary && <p class="dek">{d.summary}</p>}
    </header>

    {bannerVideo(d.bannerVideo) && <div class="case-hero page-banner" set:html={videoFigure(bannerVideo(d.bannerVideo))} />}
    {hero && !bannerVideo(d.bannerVideo) && (
      <figure class="case-hero">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 1152px) 100vw, 1120px" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" decoding="async">
        {heroCredit && <figcaption><span class="photo-credit">Photo: {httpUrl(heroCredit.url) ? <a href={httpUrl(heroCredit.url)} rel="noopener">{heroCredit.name}</a> : heroCredit.name}</span></figcaption>}
      </figure>
    )}

    {intro && <div class="intro" lang={d.intro.lang}>{intro.map((p) => <p>{p}</p>)}</div>}

    <div class="story"><Content /></div>

    <aside class="doors" aria-label="More" lang="en">
      {related && <a href={`${BASE}/software/${related.id}/`}>{related.data.title}</a>}
      <a href="/">See all my work →</a>
    </aside>
  </article>
</Base>

<script>
  // a video's player loads only when the visitor presses play (src/lib/article-video.js)
  for (const figure of document.querySelectorAll<HTMLElement>('.article-video[data-player]')) {
    const play = figure.querySelector('.video-play');
    play?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = figure.dataset.player ?? '';
      frame.title = play.getAttribute('aria-label')?.replace(/^Play the /, '') ?? 'video';
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.allowFullscreen = true;
      figure.querySelector('.video-frame')?.replaceChildren(frame);
    }, { once: true });
  }
</script>
