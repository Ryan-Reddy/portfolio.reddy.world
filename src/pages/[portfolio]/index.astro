---
import WallRedirect from '../../components/WallRedirect.astro';
import { portfolios } from '../../lib/portfolios.js';

export function getStaticPaths() {
  return portfolios.map((p) => ({ params: { portfolio: p.id }, props: { label: p.name } }));
}

const { label } = Astro.props;
---
<WallRedirect label={label} />
