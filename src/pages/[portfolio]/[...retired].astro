---
// No-index pages at retired addresses, so an old link never lands on a blank page:
// - a hidden post (archive-curation.js) hands the visitor to the wall, or to the post its words moved to;
// - a source kept but not shown (Maup) has no pages: its old addresses go to reddy.world.
// None of them is in the sitemap (sitemap-images.js isRetired) or linked from the site.
import WallRedirect from '../../components/WallRedirect.astro';
import { isPublicArchivePost, KEPT_NOT_SHOWN, MOVED } from '../../lib/archive-curation.js';
import { portfolios } from '../../lib/portfolios.js';
import { titleCase } from '../../lib/portfolios.js';
import rmaekers from '../../data/rmaekers.json';
import rrproductions from '../../data/rrproductions.json';
import vaguelyvulgar from '../../data/vaguelyvulgar.json';
import maup from '../../data/maup.json';

export function getStaticPaths() {
  const name = Object.fromEntries(portfolios.map((p) => [p.id, p.name]));
  const hidden = [rmaekers, rrproductions, vaguelyvulgar].flatMap((data) => data.posts
    .filter((post) => !isPublicArchivePost(data.id, post))
    .map((post) => {
      const moved = MOVED[data.id]?.[String(post.id)];
      const to = moved && data.posts.find((other) => other.slug === moved);
      return {
        params: { portfolio: data.id, retired: post.slug },
        props: to
          ? { moved: { target: `https://reddy.world/portfolio/${data.id}/${to.slug}/`, title: `${titleCase(to.title)} — Ryan Reddy`, link: titleCase(to.title) } }
          // each old page keeps a title of its own; no words about the page itself (Ryan, 2026-10-25)
          : { label: name[data.id], title: `${titleCase(post.title.replace(/^\(untitled\)$/i, '') || post.slug)} — Ryan Reddy` },
      };
    }));
  const kept = [maup].filter((data) => KEPT_NOT_SHOWN.includes(data.id)).flatMap((data) => [undefined, ...data.posts.map((post) => post.slug)]
    .map((slug) => ({ params: { portfolio: data.id, retired: slug }, props: { home: true } })));
  return [...hidden, ...kept];
}

const { label, title, home, moved } = Astro.props;
---
{moved
  ? <WallRedirect {...moved} canonical={moved.target} />
  : home
  ? <WallRedirect target="https://reddy.world/" title="reddy.world" />
  : <WallRedirect label={label} title={title} />}
