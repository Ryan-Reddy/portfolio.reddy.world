---
import Base from '../../layouts/Base.astro';
import { renderContent } from '../../lib/content.js';
import { absUrl } from '../../lib/media-url.js';
import { imageRights } from '../../lib/image-rights.js';
import { subjectImageObject } from '../../lib/model-page.js';
import { httpUrl } from '../../lib/safe-output.js';
import { fitTitle, fitDescription, DESCRIPTION_MIN } from '../../lib/snippet.js';
import { portfolios, formatDate, photos, altFor, contextOf, picture, contactUrl, titleCase, PERSON_ID, ORIGIN, SITE, BASE, themeByTag, KIND_LABEL, portfolioLabel } from '../../lib/portfolios.js';

export function getStaticPaths() {
  return portfolios.flatMap((p) =>
    p.posts.map((post) => ({ params: { portfolio: p.id, slug: post.slug }, props: { p, post } })),
  );
}

const { p, post } = Astro.props;
const imgs = photos(post);
const videos = post.media.filter((m) => m.type === 'video');
const files = post.media.filter((m) => m.type === 'file');
const name = titleCase(post.title);
// the summary in Ryan's words (the desk's, else WordPress's excerpt), then what kind of work it was, under which name, and when,
// cut at a word to what a search result shows (src/lib/snippet.js). Too short: a short summary takes the
// excerpt after it, then the month joins the year; whatever fits first.
const context = contextOf(post);
const withMonth = context.replace(/, \d{4}$/, `, ${formatDate(post.date)}`);
const summaryAndExcerpt = post.summary && post.excerpt ? `${post.summary.trim().replace(/[.!?…]?$/, (stop) => stop || '.')} ${post.excerpt}` : '';
const tries = [[post.summary, post.excerpt, name], [summaryAndExcerpt, post.excerpt, name]].flatMap((words) => [fitDescription(words, context), ...(post.undated ? [] : [fitDescription(words, withMonth)])]);
const description = tries.find((text) => text.length >= DESCRIPTION_MIN) ?? tries.reduce((a, b) => (b.length > a.length ? b : a));
const pageUrl = `${SITE}${post.path}`;

const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
// the photographer Ryan credited on the image desk: "Photo: Name", linked to their site when he gave one
// (a site links only when it is an http(s) address)
const creditHtml = (c) => c?.name ? `<span class="photo-credit">Photo: ${httpUrl(c.url) ? `<a href="${esc(httpUrl(c.url))}" rel="noopener">${esc(c.name)}</a>` : esc(c.name)}</span>` : '';
const captionHtml = (m) => (m.caption || m.credit?.name ? `<figcaption>${m.caption ? esc(m.caption) : ''}${m.caption && m.credit?.name ? ' · ' : ''}${creditHtml(m.credit)}</figcaption>` : '');
// in the structured data the credited photographer is the picture's creator, and Ryan claims no copyright on it
const credited = (m, object) => (m.credit?.name
  ? { ...object, creator: { '@type': 'Person', name: m.credit.name, url: httpUrl(m.credit.url) }, creditText: m.credit.name, copyrightNotice: undefined }
  : object);

// Every picture is one lightbox slide, numbered in reading order: the ones placed in the text first
let slide = 0;
const shown = new Set();
function item(i, sizes) {
  const m = post.media[i];
  shown.add(m.url);
  const pic = picture(m);
  const alt = altFor(post, m, i);
  const dims = pic.width ? ` width="${pic.width}" height="${pic.height}"` : '';
  const set = pic.srcset ? ` srcset="${pic.srcset}" sizes="${sizes}"` : '';
  // the picture's aspect ratio sizes it in its row (see .post-figure in global.css)
  const ratio = pic.width && pic.height ? ` style="--r: ${(pic.width / pic.height).toFixed(3)}"` : '';
  return (
    `<figure class="gallery-item"${ratio}>` +
    `<button type="button" class="gallery-thumb" data-index="${slide++}" data-full="${esc(m.url)}" aria-label="Enlarge: ${esc(alt)}">` +
    `<img src="${esc(pic.src)}"${set}${dims} alt="${esc(alt)}" loading="lazy" decoding="async"></button>` +
    captionHtml(m) +
    `</figure>`
  );
}
// Rows of up to three, balanced (5 pictures: 3 + 2); each row fills the width at one height
function rows(ids) {
  const count = Math.ceil(ids.length / 3);
  const out = [];
  for (let r = 0, start = 0; r < count; r++) {
    const size = Math.ceil((ids.length - start) / (count - r));
    out.push(`<div class="post-row">${ids.slice(start, start + size).map((i) => item(i, '(max-width: 600px) 50vw, 420px')).join('')}</div>`);
    start += size;
  }
  return out.join('');
}
function figure(indices) {
  const ids = indices.filter((i) => post.media[i]?.type === 'image' && post.media[i].duplicate_of === undefined);
  if (ids.length === 1) return `<div class="post-figure single">${item(ids[0], '(max-width: 900px) 100vw, 852px')}</div>`;
  return ids.length ? `<div class="post-figure">${rows(ids)}</div>` : '';
}

// The modelling page is a comp card: the lead picture large with the measurements beside it,
// the other pictures in a grid at their own shape. Its text only placed the pictures.
const comp = post.layout === 'comp-card';
const lead = comp ? (imgs.find((m) => m.url === post.featured?.url) ?? imgs[0]) : null;
// the lead is the page's largest picture: loaded first, not lazily
const leadHtml = lead ? item(post.media.indexOf(lead), '(max-width: 720px) 100vw, 640px').replace(' loading="lazy"', ' fetchpriority="high"') : '';
const gridHtml = comp ? imgs.filter((m) => m !== lead).map((m) => item(post.media.indexOf(m), '(max-width: 720px) 50vw, 360px')).join('') : '';
const leadRatio = lead?.width && lead?.height ? (lead.width / lead.height).toFixed(3) : '0.667';

const body = comp ? '' : renderContent(post.content, { title: name, figure });
// Pictures the text did not place: only posts that never placed any keep their uploads here
const rest = comp ? [] : imgs.filter((m) => !shown.has(m.url));
const restHtml = rows(rest.map((m) => post.media.indexOf(m)));

// The chosen featured image heads the page, unless the post already shows it
const featured = post.featured;
const hero = featured && !comp && !shown.has(featured.url) ? { ...picture(featured), alt: altFor(post, featured, 0) } : null;

const shareImage = featured && { url: absUrl(featured.url), width: featured.width, height: featured.height, alt: altFor(post, featured, 0) };
const words = body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const imageObject = (m, i) => credited(m, {
  '@type': 'ImageObject',
  contentUrl: absUrl(m.url),
  url: absUrl(m.url),
  width: m.width || undefined,
  height: m.height || undefined,
  caption: m.alt || m.caption ? `${m.alt || m.caption} — ${name}, ${context}` : `${name}, photo ${i + 1} — ${context}`,
  keywords: m.keywords?.length ? m.keywords.join(', ') : undefined,
  // creator, credit and copyright only on Ryan's own pictures (src/lib/image-rights.js)
  ...imageRights(m.url, PERSON_ID),
});

// WordPress posts are blog posts; its pages (about, contact, press kit) are plain web pages
const isPost = post.type === 'post';
// the featured image first: search engines take the first as the post's picture
const images = [featured, ...imgs.filter((m) => m.url !== featured?.url)].filter(Boolean);

// on the modelling page Ryan is in the pictures: what they are about, not who took them
const pictureObject = (m, i) => (p.subject ? subjectImageObject(imageObject(m, i), m, PERSON_ID) : imageObject(m, i));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': isPost ? 'BlogPosting' : 'WebPage',
    '@id': `${pageUrl}#post`,
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    headline: name.slice(0, 110),
    description,
    datePublished: post.published,
    dateModified: post.modified,
    author: { '@type': 'Person', '@id': PERSON_ID, name: 'Ryan Reddy', url: `${ORIGIN}/` },
    publisher: { '@type': 'Person', '@id': PERSON_ID, name: 'Ryan Reddy', url: `${ORIGIN}/` },
    articleSection: post.categories[0] || p.name,
    keywords: [...new Set([...post.categories, ...post.tags, ...(post.keywords ?? [])])].join(', ') || undefined,
    wordCount: words || undefined,
    isPartOf: { '@type': 'Blog', name: portfolioLabel(p), url: `${SITE}/${p.id}/` },
    image: images.length ? images.map((m) => pictureObject(m, Math.max(0, post.media.indexOf(m)))) : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: p.name, item: `${SITE}/${p.id}/` },
      { '@type': 'ListItem', position: 3, name, item: pageUrl },
    ],
  },
];
const article = isPost ? { published: post.published, modified: post.modified, section: post.categories[0] || p.name, tags: post.tags } : undefined;
---
<Base title={fitTitle(`${name} — ${p.brand} | Ryan Reddy`, `${name} — ${p.brand}`, name)} description={description} image={shareImage} active={p.id} jsonLd={jsonLd} type={isPost ? 'article' : 'website'} article={article}>
  <article class:list={['project-page', { 'comp-card': comp }]} data-desk-project={`${p.id}/${post.slug}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}/`}>Portfolio</a> <span aria-hidden="true">/</span> <a href={`${BASE}/${p.id}/`}>{p.name}</a>
    </nav>

    {comp && (
      <div class="comp-lead" style={`--lead-r: ${leadRatio}`}>
        <header class="comp-title"><h1 class="modal-title">{post.title.trim()}</h1>{post.summary && <p class="post-summary">{post.summary}</p>}</header>
        <div class="comp-photo" set:html={leadHtml} />
        {post.measurements?.length > 0 && (
          <section class="comp-facts" aria-labelledby="measurements">
            <h2 class="modal-gallery-title" id="measurements">Measurements</h2>
            <dl class="measurements">{post.measurements.map(([label, value]) => <Fragment><dt>{label}</dt><dd>{value}</dd></Fragment>)}</dl>
          </section>
        )}
      </div>
    )}
    {comp && gridHtml && <div class="comp-grid" set:html={gridHtml} />}

    {!comp && <header class="modal-header">
      <div class="modal-meta">
        <time datetime={post.published}>{formatDate(post.date)}</time>
        {post.kinds.length > 0 && <span>&bull; {post.kinds.map((k) => KIND_LABEL[k]).join(', ')}</span>}
      </div>
      <h1 class="modal-title">{post.title.trim()}</h1>
      {post.summary && <p class="post-summary">{post.summary}</p>}
      {post.tags.length > 0 && (
        <div class="card-tags">{post.tags.map((t) => themeByTag[t]
          ? <a class="card-tag" href={`${BASE}/theme/${t}/`}>#{themeByTag[t].label}</a>
          : <span class="card-tag">#{t}</span>)}</div>
      )}
    </header>}

    {hero && (
      <figure class="post-hero">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 900px) 100vw, 852px" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" decoding="async" data-desk-picture={featured.url}>
        {(featured.caption || featured.credit?.name) && <Fragment set:html={captionHtml(featured)} />}
      </figure>
    )}

    {body && <div class="modal-body-text" set:html={body} />}

    {rest.length > 0 && (
      <section class="modal-gallery-section" aria-labelledby="gallery-title">
        <h2 class="modal-gallery-title" id="gallery-title">Photographs ({rest.length})</h2>
        <div class="post-figure" set:html={restHtml} />
      </section>
    )}

    {post.films.length > 0 && (
      <section class="modal-gallery-section film" aria-labelledby="film-title">
        <h2 class="modal-gallery-title" id="film-title">Film</h2>
        <div class="film-grid">
          {post.films.map((v) => (
            <figure class="video-embed">
              <div class="video-frame">
                {post.filmsLinkOnly?.includes(v.id)
                  ? <a href={v.url} rel="noopener"><img src={v.thumbnail} alt={v.title} loading="lazy" decoding="async"></a>
                  : <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}${v.start ? `?start=${v.start}` : ''}`} title={v.title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>}
              </div>
              <figcaption><a href={v.url} rel="noopener">{v.title}</a> · {v.channel}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <aside class="cta">
      <p>{p.cta.line}</p>
      <div class="cta-links">
        <a class="btn-cta" href={contactUrl({ project: post.slug })}>{p.cta.button}</a>
        <a class="door" href="/">See all my work →</a>
      </div>
    </aside>

    {videos.length > 0 && (
      <section class="modal-gallery-section" aria-label="Videos">
        <h2 class="modal-gallery-title">Video</h2>
        {videos.map((v) => (
          <figure class="video-embed">
            <video class="project-video" src={v.url} controls playsinline preload="metadata"></video>
            <figcaption>Does not play? <a href={v.url} download>Download the video</a></figcaption>
          </figure>
        ))}
      </section>
    )}

    {files.length > 0 && (
      <section class="modal-gallery-section" aria-label="Documents">
        <h2 class="modal-gallery-title">Documents</h2>
        <ul>{files.map((f) => <li><a href={f.url}>{f.title || f.url.split('/').pop()}</a></li>)}</ul>
      </section>
    )}
  </article>

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="lightbox-prev" aria-label="Previous photo">&#10094;</button>
    <button type="button" class="lightbox-next" aria-label="Next photo">&#10095;</button>
    <div class="lightbox-stage">
      <!-- A valid inert image keeps the closed dialog valid for crawlers. The
           selected photograph replaces it only when a visitor opens this. -->
      <img id="lightbox-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="">
      <div class="lightbox-caption">
        <span id="lightbox-count"></span>
      </div>
    </div>
  </div>
</Base>

<script>
  const box = document.getElementById('lightbox')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const count = document.getElementById('lightbox-count')!;
  const items = [...document.querySelectorAll<HTMLElement>('.gallery-item')];
  let index = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    index = (i + items.length) % items.length;
    const thumb = items[index].querySelector<HTMLButtonElement>('.gallery-thumb')!;
    img.src = thumb.dataset.full!;
    img.alt = thumb.querySelector('img')!.alt;
    count.textContent = `${index + 1} / ${items.length}`;
  }
  function open(i: number, from: HTMLElement) {
    opener = from;
    show(i);
    box.hidden = false;
    box.classList.add('open');
    box.querySelector<HTMLButtonElement>('.lightbox-close')!.focus();
  }
  function close() {
    box.classList.remove('open');
    box.hidden = true;
    opener?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((b) =>
    b.addEventListener('click', () => open(Number(b.dataset.index), b)),
  );
  box.querySelector('.lightbox-close')!.addEventListener('click', close);
  box.querySelector('.lightbox-prev')!.addEventListener('click', () => show(index - 1));
  box.querySelector('.lightbox-next')!.addEventListener('click', () => show(index + 1));
  box.addEventListener('click', (e) => {
    if (e.target === box || (e.target as HTMLElement).classList.contains('lightbox-stage')) close();
  });
  window.addEventListener('keydown', (e) => {
    if (box.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
