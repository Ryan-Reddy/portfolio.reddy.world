---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { PERSON_ID, ORIGIN, SITE, BASE } from '../../lib/portfolios.js';
import { pictureAt } from '../../lib/software.js';
import { imageRights } from '../../lib/image-rights.js';
import '../../styles/software.css';

export async function getStaticPaths() {
  const entries = await getCollection('interviews');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const pageUrl = `${SITE}/interviews/${entry.id}/`;
const related = await getEntry(d.related);
const relatedUrl = `${SITE}/software/${related.id}/`;
const who = d.interviewee;
// the intro is Ryan's own words, one paragraph per blank line
const intro = d.intro?.text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const hero = d.hero && { ...(await pictureAt(`interviews/${entry.id}`, d.hero.file)), alt: d.hero.alt };
// the link card (LinkedIn and others): the JPEG copy when there is one, else the picture itself
const card = d.hero?.share && (await pictureAt(`interviews/${entry.id}`, d.hero.share));
const shareImage = hero && (card
  ? { url: `${ORIGIN}${card.url}`, width: card.width, height: card.height, alt: hero.alt }
  : { url: `${ORIGIN}${hero.url}`, width: hero.width, height: hero.height, alt: hero.alt });
// the role's own words, the ones in `roleLinks` linked to where they stand (first time each appears)
function linkedParts(text, links = {}) {
  const parts = [];
  let rest = text;
  const keys = Object.keys(links);
  while (rest) {
    const hits = keys.map((key) => [key, rest.indexOf(key)]).filter(([, at]) => at >= 0).sort((a, b) => a[1] - b[1] || b[0].length - a[0].length);
    if (!hits.length) { parts.push({ text: rest }); break; }
    const [key, at] = hits[0];
    if (at) parts.push({ text: rest.slice(0, at) });
    parts.push({ text: key, href: links[key] });
    keys.splice(keys.indexOf(key), 1);
    rest = rest.slice(at + key.length);
  }
  return parts;
}
const roleParts = linkedParts(who.role, who.roleLinks);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name: d.title,
    description: d.description,
    inLanguage: d.lang,
    dateCreated: String(d.year),
    dateModified: d.updated.toISOString().slice(0, 10),
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    author: { '@type': 'Person', '@id': PERSON_ID, name: 'Ryan Reddy', url: `${ORIGIN}/` },
    contributor: {
      '@type': 'Person',
      name: who.name,
      jobTitle: who.role,
      url: who.profile,
      sameAs: who.profile ? [who.profile] : undefined,
      worksFor: { '@type': 'Organization', name: who.org, url: who.orgUrl, sameAs: who.orgSameAs },
    },
    isPartOf: { '@type': 'CreativeWork', '@id': `${relatedUrl}#work`, name: related.data.title, url: relatedUrl },
    image: hero ? {
      '@type': 'ImageObject',
      contentUrl: `${ORIGIN}${hero.url}`,
      url: `${ORIGIN}${hero.url}`,
      width: hero.width,
      height: hero.height,
      caption: hero.alt,
      ...imageRights(hero.url, PERSON_ID),
    } : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Software', item: `${SITE}/software/` },
      { '@type': 'ListItem', position: 3, name: related.data.title, item: relatedUrl },
      { '@type': 'ListItem', position: 4, name: d.title, item: pageUrl },
    ],
  },
];
---
<Base
  title={`${d.seoTitle ?? d.title} · reddy.world`}
  description={d.description}
  image={shareImage}
  active="software"
  jsonLd={jsonLd}
  type="article"
  article={{ modified: d.updated.toISOString().slice(0, 10), section: 'Interviews' }}
  theme="paper"
  lang={d.lang}
  footnote="Software and websites by Ryan Reddy."
>
  <article class="case interview">
    <nav class="breadcrumb" aria-label="Breadcrumb" lang="en">
      <a href={`${BASE}/`}>Portfolio</a> <span aria-hidden="true">/</span> <a href={`${BASE}/software/`}>Software</a> <span aria-hidden="true">/</span> <a href={`${BASE}/software/${related.id}/`}>{related.data.title}</a>
    </nav>

    <header class="case-head">
      <h1 lang={d.titleLang}>{d.title}</h1>
      <p class="dek">{d.byline} {who.profile ? <a href={who.profile} rel="noopener">{who.name}</a> : who.name},{' '}<span lang={who.roleLang}>{roleParts.map((part) => (part.href ? <a href={part.href} rel="noopener">{part.text}</a> : part.text))}</span></p>
    </header>

    {hero && (
      <figure class="case-hero">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 1152px) 100vw, 1120px" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" decoding="async">
      </figure>
    )}

    {intro && <div class="intro" lang={d.intro.lang}>{intro.map((p) => <p>{p}</p>)}</div>}

    <div class="story"><Content /></div>

    <aside class="doors" aria-label="More" lang="en">
      <a href={`${BASE}/software/${related.id}/`}>{related.data.title}</a>
      <a href="/">See all my work →</a>
    </aside>
  </article>
</Base>
