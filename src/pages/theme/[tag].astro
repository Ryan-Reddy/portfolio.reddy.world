---
import WallRedirect from '../../components/WallRedirect.astro';
import { THEME_TAGS } from '../../lib/portfolios.js';

export function getStaticPaths() {
  return THEME_TAGS.map((theme) => ({ params: { tag: theme.tag }, props: { label: theme.label } }));
}

const { label } = Astro.props;
---
<WallRedirect label={label} />
