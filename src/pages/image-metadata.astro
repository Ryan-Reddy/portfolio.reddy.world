---
import { deskProjects, ratingCandidates } from '../lib/desk-keywords.js';
import { ratedFor, stems } from '../lib/keyword-ratings.js';
import ratings from '../data/keyword-ratings.json';

// the third column: the project's words with a rating, plus related words that rate higher (scripts/keyword-ratings.mjs)
const deskList = deskProjects();
const vocabulary = new Set(deskList.flatMap((project) => ratingCandidates(project).flatMap(stems)));
const projects = deskList.map((project) => ({...project, rated: ratedFor(ratingCandidates(project), ratings, {vocabulary, relatedFrom: project.intent})}));
const ratingsInfo = {updatedAt: ratings.updatedAt, bing: Object.keys(ratings.bing ?? {}).length > 0};
const count = projects.reduce((sum, project) => sum + project.images.length, 0);
const queue = JSON.stringify({ projects, count, ratingsInfo }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Image SEO focus mode — reddy.world</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, system-ui, sans-serif; background: #0f0f0f; color: #f5f5f0; --gold: #c7a86d; --line: #41413e; }
    * { box-sizing: border-box; }
    body { margin: 0; overflow: hidden; }
    button, input, textarea, select { font: inherit; }
    :global(button), .project-link { min-height: 2.75rem; border: 1px solid var(--gold); padding: .65rem .9rem; color: var(--gold); background: transparent; cursor: pointer; text-decoration: none; }
    :global(button.primary) { color: #0f0f0f; background: var(--gold); font-weight: 750; }
    :global(button:hover), :global(button:focus-visible), .project-link:hover, .project-link:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .top { height: 4.5rem; padding: .7rem 1rem; display: grid; grid-template-columns: minmax(10rem, 1fr) minmax(12rem, 2fr) auto; gap: 1rem; align-items: center; border-bottom: 1px solid var(--line); }
    .brand { min-width: 0; }
    .brand strong { display: block; font-family: Georgia, serif; font-size: 1.3rem; }
    .brand small, #score { color: #aaa; }
    .progress { display: grid; grid-template-columns: 1fr auto; gap: .35rem .75rem; align-items: center; }
    .bar { grid-column: 1 / -1; height: .35rem; background: #2a2a28; }
    .bar span { display: block; height: 100%; width: 0; background: var(--gold); transition: width .2s ease; }
    .top-actions { display: flex; gap: .5rem; }
    .workbench { height: calc(100dvh - 4.5rem); display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(22rem, .8fr); }
    .stage { position: relative; min-width: 0; display: grid; place-items: center; padding: 1.25rem 1.25rem 6.25rem; background: #090909; }
    .stage > img { display: block; max-width: 100%; max-height: calc(100dvh - 12rem); object-fit: contain; background: #151515; }
    .counter { position: absolute; top: 1rem; left: 1rem; padding: .35rem .55rem; color: #eee; background: rgba(0,0,0,.75); font-variant-numeric: tabular-nums; }
    .hero-pick { position: absolute; top: .75rem; right: 1rem; min-height: 2.5rem; background: rgba(0,0,0,.75); }
    .hero-pick[aria-pressed="true"] { color: #0f0f0f; background: var(--gold); font-weight: 750; }
    :global(.filmstrip button[data-hero="true"]) { position: relative; border-color: var(--gold); }
    :global(.filmstrip button[data-hero="true"])::after { content: '★'; position: absolute; top: .1rem; right: .25rem; color: var(--gold); font-size: .9rem; text-shadow: 0 0 3px #000; }
    .filmstrip { position: absolute; inset: auto 0 0; min-width: 0; height: 5.25rem; padding: .55rem .75rem; display: flex; align-items: center; gap: .45rem; overflow-x: auto; overflow-y: hidden; background: rgba(10,10,10,.94); border-top: 1px solid var(--line); }
    :global(.filmstrip button) { flex: 0 0 auto; width: 4.25rem; height: 4.05rem; min-height: 0; padding: .15rem; overflow: hidden; border-color: #555; }
    :global(.filmstrip button[aria-current="true"]) { border-color: var(--gold); outline: 2px solid var(--gold); outline-offset: -3px; }
    :global(.filmstrip img) { display: block; width: 100%; height: 100%; object-fit: cover; }
    .panel { min-width: 0; overflow-y: auto; border-left: 1px solid var(--line); padding: 1.1rem; display: grid; align-content: start; gap: .85rem; }
    .project-head { display: grid; gap: .55rem; }
    .project-head h1 { margin: 0; font-family: Georgia, serif; font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.05; }
    .project-row { display: flex; gap: .6rem; align-items: center; }
    #project-picker { min-width: 0; width: 100%; color: #f5f5f0; background: #1a1a1a; border: 1px solid #666; padding: .65rem; }
    label { display: grid; gap: .4rem; font-weight: 700; }
    label small, .hint { color: #aaa; font-weight: 400; line-height: 1.35; }
    input, textarea { width: 100%; color: #f5f5f0; background: #1a1a1a; border: 1px solid #666; padding: .75rem; }
    input:focus, textarea:focus, select:focus { outline: 2px solid var(--gold); outline-offset: 2px; }
    textarea { min-height: 5.5rem; resize: vertical; line-height: 1.45; }
    .inherited { min-height: 1.5rem; display: flex; flex-wrap: wrap; gap: .35rem; }
    :global(.chip) { padding: .2rem .45rem; background: #2b251a; color: #e7cf9d; font-size: .8rem; }
    .suggestion-block { display: grid; gap: .4rem; }
    .suggestion-head { display: flex; justify-content: space-between; gap: .75rem; color: #aaa; font-size: .78rem; }
    .suggestion-head + .suggestion-head { margin-top: .35rem; }
    .mini-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
    .suggestions { display: flex; flex-wrap: wrap; gap: .35rem; }
    :global(.suggestion-set) { display: inline-flex; align-items: stretch; border: 1px solid #555; border-radius: 999px; overflow: hidden; }
    :global(button.suggestion) { min-height: 0; padding: .3rem .5rem; border: 0; color: #d7d7d1; font-size: .78rem; }
    :global(button.suggestion[aria-pressed="true"]) { border-color: var(--gold); color: #111; background: var(--gold); }
    :global(button.scope) { min-height: 0; padding: .25rem .38rem; border: 0; border-left: 1px solid #555; color: #bbb; font-size: .68rem; }
    :global(button.scope:hover), :global(button.scope:focus-visible) { color: #111; background: var(--gold); outline: 0; }
    button.add-all { min-height: 0; padding: 0; border: 0; color: var(--gold); font-size: .78rem; }
    :global(.rating) { display: inline-flex; align-items: center; padding: 0 .45rem; border-left: 1px solid #555; color: var(--gold); font-size: .68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    :global(.rating[data-level="none"]) { color: #888; }
    :global(.rating-empty) { color: #888; font-size: .78rem; }
    details.rated-ideas > summary { cursor: pointer; margin-bottom: .4rem; color: #aaa; font-size: .78rem; }
    details.how-to-pick { color: #bbb; font-size: .78rem; line-height: 1.4; }
    details.how-to-pick summary { cursor: pointer; color: var(--gold); }
    details.how-to-pick ul { margin: .4rem 0; padding-left: 1.1rem; display: grid; gap: .25rem; }
    details.how-to-pick small { color: #888; }
    .effective { color: #aaa; font-size: .78rem; line-height: 1.4; }
    .nearby { display: grid; gap: .3rem; color: #bbb; font-size: .78rem; line-height: 1.35; }
    :global(.nearby q) { color: #ddd; }
    details.description { border-block: 1px solid #292927; padding-block: .45rem; }
    details.description summary { cursor: pointer; color: #ddd; font-weight: 700; }
    details.description label { margin-top: .6rem; }
    .controls { display: grid; grid-template-columns: 1fr 1fr 1.35fr; gap: .55rem; }
    .celebrate { min-height: 1.5rem; color: var(--gold); font-weight: 700; }
    kbd { border: 1px solid #555; padding: .1rem .3rem; font-size: .78rem; color: #bbb; }
    dialog { max-width: 34rem; color: #f5f5f0; background: #151515; border: 1px solid var(--gold); }
    dialog.map-dialog { width: min(64rem, calc(100% - 2rem)); max-width: none; max-height: calc(100dvh - 2rem); }
    .map-tools { position: sticky; top: 0; display: flex; gap: .6rem; padding-bottom: .75rem; background: #151515; }
    .map-tools input { flex: 1; }
    .keyword-map { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .45rem; }
    :global(.keyword-row) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .3rem; padding: .45rem; border: 1px solid #3a3a38; }
    :global(.keyword-row strong), :global(.keyword-row small) { display: block; overflow-wrap: anywhere; }
    :global(.keyword-row small) { margin-top: .15rem; color: #aaa; }
    dialog::backdrop { background: rgba(0,0,0,.75); }
    @media (max-width: 760px) {
      body { overflow: auto; }
      .top { height: auto; grid-template-columns: 1fr; }
      .top-actions { flex-wrap: wrap; }
      .workbench { height: auto; grid-template-columns: 1fr; }
      .stage { min-height: 55dvh; }
      .stage > img { max-height: 43dvh; }
      .filmstrip { height: 4.75rem; }
      .panel { overflow: visible; border: 0; border-top: 1px solid var(--line); }
    }
    @media (prefers-reduced-motion: reduce) { .bar span { transition: none; } }
  </style>
</head>
<body>
  <header class="top">
    <div class="brand"><strong>Project SEO pass</strong><small id="score">One set of words per project</small></div>
    <div class="progress"><span id="progress-label">0 of {projects.length} projects</span><span id="remaining">{projects.length} to go</span><div class="bar"><span id="bar"></span></div></div>
    <div class="top-actions"><button id="map" type="button">Keyword map</button><button id="help" type="button">Keys</button><button id="load" type="button">Load export</button><input id="load-file" type="file" accept=".json,application/json" hidden><button id="export" class="primary" type="button">Export</button></div>
  </header>

  <main class="workbench">
    <section class="stage" aria-label="Picture being described">
      <span class="counter" id="image-counter"></span>
      <img id="picture" alt="Picture to describe">
      <button id="make-hero" class="hero-pick" type="button" aria-pressed="false">☆ Make this the lead picture</button>
      <nav class="filmstrip" id="filmstrip" aria-label="All images in this project"></nav>
    </section>
    <form class="panel" id="editor">
      <div class="project-head">
        <small id="portfolio"></small>
        <h1 id="project-title"></h1>
        <div class="project-row"><select id="project-picker" aria-label="Jump to project"></select><a id="project-link" class="project-link" target="_blank" rel="noreferrer">Open ↗</a></div>
      </div>

      <label>Shared keywords · added to every image in this project
        <input id="project-tags" autocomplete="off" placeholder="stage, night, Amsterdam, wood">
        <small id="project-scope-help">Choose these once; every image in this project inherits them.</small>
      </label>
      <div class="suggestion-block">
        <div class="suggestion-head"><span>Your handwritten vocabulary from this post</span><button class="add-all" id="add-original-suggestions" type="button">Add your words</button></div>
        <div class="suggestions" id="project-original-suggestions"></div>
        <div class="suggestion-head"><span>Customer-search ideas for this project</span></div>
        <div class="suggestions" id="project-search-suggestions"></div>
      </div>
      <details class="rated-ideas" open>
        <summary>Search-rated ideas · ●●● = most read about</summary>
        <div class="suggestion-block">
        <div class="suggestions" id="project-rated-suggestions"></div>
        <div class="suggestion-head"><span>Related, more read about</span></div>
        <div class="suggestions" id="project-rated-related"></div>
        <details class="how-to-pick">
          <summary>How to pick · what the dots mean</summary>
          <ul>
            <li>The right people over many people: a word a client types when they need you (festival decor Amsterdam) beats a big, broad word (festival).</li>
            <li>Local: put Amsterdam in one or two words, and add the Dutch word where clients search in Dutch.</li>
            <li>Few and accurate: four to eight words that are true of every picture in the project.</li>
            <li>Dots: readers of the topic's Wikipedia page in 30 days, English and Dutch (● 100+, ●● 1,000+, ●●● 10,000+). Interest in the topic, not searches for these exact words; a big number also means more competition.</li>
          </ul>
          <small id="rated-source"></small>
        </details>
        </div>
      </details>
      <div class="inherited" id="inherited" aria-label="Project tags applied to this picture"></div>

      <details class="description" id="description-panel">
        <summary>Later round · star or outlier image</summary>
        <label>What is visible in this picture?
          <textarea id="description" placeholder="A concise description for someone who cannot see it…"></textarea>
        </label>
        <label>Extra keywords only for this image
          <input id="image-tags" autocomplete="off" placeholder="close-up, blue light, Ryan welding">
          <small>Optional for a standout image or one that differs from the rest.</small>
        </label>
        <div class="suggestion-block">
          <div class="suggestion-head"><span>Your nearest handwritten descriptions</span><span class="mini-actions"><button class="add-all" id="add-nearby-suggestions" type="button">Add nearby words</button><button class="add-all" id="clear-image-tags" type="button">Clear image tags</button></span></div>
          <div class="nearby" id="nearby"></div>
          <div class="suggestion-head"><span>Nearby vocabulary + visual choices</span></div>
          <div class="suggestions" id="image-suggestions"></div>
        </div>
      </details>
      <div class="effective" id="effective" aria-live="polite"></div>

      <div class="controls"><button id="previous" type="button">← Previous project</button><button id="skip" type="button">Skip project</button><button id="next" class="primary" type="submit">Project tagged + next →</button></div>
      <div class="celebrate" id="celebrate" aria-live="polite"></div>
      <p class="hint"><kbd>Enter</kbd> in shared keywords or <kbd>Ctrl</kbd> + <kbd>Enter</kbd>: finish project + next · click thumbnails to inspect the set · everything autosaves</p>
    </form>
  </main>

  <dialog id="keyword-map" class="map-dialog"><h2>Current keyword map</h2><p>Words already present in the archive plus anything saved in this browser. Counts show how many projects currently use each phrase.</p><div class="map-tools"><input id="map-filter" type="search" placeholder="Filter keywords…" aria-label="Filter keyword map"><button id="close-map" type="button">Close</button></div><div class="keyword-map" id="map-list"></div></dialog>
  <dialog id="keys"><h2>One clean pass</h2><p>Choose shared words for the whole project, then press <kbd>Enter</kbd> or <strong>Project tagged + next</strong>. Every image in that project inherits them.</p><p>Use the thumbnails to understand the full set. Individual descriptions and extra tags remain under <strong>Later round · star or outlier image</strong>; you can ignore those for now.</p><p>Suggestions are optional. A smaller accurate set is better than keyword stuffing.</p><p>The ★ marks the project's lead picture. Open another thumbnail and press <strong>Make this the lead picture</strong> to choose it; it heads the project page, its card and the wall after the next import.</p><button id="close-keys" class="primary" type="button">Got it</button></dialog>
  <script type="application/json" id="queue-data" set:html={queue}></script>
  <script is:inline>
    const DATA = JSON.parse(document.querySelector('#queue-data').textContent);
    const STORE = 'reddy-world-image-metadata-v4';
    const PREVIOUS = 'reddy-world-image-metadata-v3';
    const OLDER = 'reddy-world-image-metadata-v2';
    const LEGACY = 'reddy-world-image-descriptions-v1';
    const empty = {projects: {}, images: {}, cursor: 0, session: 0};
    const read = () => {
      try {
        const saved = localStorage.getItem(STORE) || localStorage.getItem(PREVIOUS) || localStorage.getItem(OLDER) || '{}';
        return {...empty, ...JSON.parse(saved)};
      } catch { return {...empty}; }
    };
    const state = read();
    if (!Object.keys(state.images).length) {
      try { const old = JSON.parse(localStorage.getItem(LEGACY) || '{}'); for (const [key, description] of Object.entries(old)) state.images[key] = {description, tags: ''}; } catch {}
    }
    const flat = DATA.projects.flatMap((project, projectIndex) => project.images.map((image, imageIndex) => ({project, projectIndex, image, imageIndex})));
    const $ = (id) => document.querySelector(`#${id}`);
    const tags = (value = '') => [...new Map(value.split(',').map((tag) => tag.trim()).filter(Boolean).map((tag) => [tag.toLowerCase(), tag])).values()];
    const putTags = (id, values) => { $(id).value = tags(values.join(', ')).join(', '); };
    const save = () => localStorage.setItem(STORE, JSON.stringify(state));
    const current = () => flat[state.cursor] ?? flat[0];
    const recordFor = (image) => state.images[image.key] ?? state.images[image.url] ?? {};
    // the lead picture: Ryan's choice on this desk, else the one the post has today
    const heroOf = (project) => state.projects[project.id]?.hero || project.hero;
    for (const project of DATA.projects) {
      if (state.projects[project.id]?.reviewed === undefined && project.images.every((image) => recordFor(image).reviewed)) {
        state.projects[project.id] = {...state.projects[project.id], reviewed: true};
      }
    }
    const completed = () => DATA.projects.filter((project) => state.projects[project.id]?.reviewed).length;
    const firstIncomplete = () => {
      const projectIndex = DATA.projects.findIndex((project) => !state.projects[project.id]?.reviewed);
      return projectIndex < 0 ? 0 : flat.findIndex((item) => item.projectIndex === projectIndex);
    };
    if (!Number.isInteger(state.cursor) || !flat[state.cursor]) state.cursor = Math.max(0, firstIncomplete());

    for (const [index, project] of DATA.projects.entries()) $('project-picker').add(new Option(`${project.title} · ${project.images.length}`, String(index)));

    function collect() {
      const item = current();
      state.projects[item.project.id] = {...state.projects[item.project.id], tags: $('project-tags').value.trim()};
      state.images[item.image.key] = {...recordFor(item.image), description: $('description').value.trim(), tags: $('image-tags').value.trim()};
      save();
    }
    function changeTag(inputId, tag, toggle = false) {
      const values = tags($(inputId).value);
      const at = values.findIndex((value) => value.toLowerCase() === tag.toLowerCase());
      if (at >= 0 && toggle) values.splice(at, 1);
      else if (at < 0) values.push(tag);
      putTags(inputId, values);
      collect();
      refreshKeywords();
    }
    function renderTagButtons(containerId, suggestions, inputId) {
      const projectSelected = new Set(tags($('project-tags').value).map((tag) => tag.toLowerCase()));
      const imageSelected = new Set(tags($('image-tags').value).map((tag) => tag.toLowerCase()));
      $(containerId).replaceChildren(...suggestions.map((tag) => {
        const wrap = Object.assign(document.createElement('span'), {className: 'suggestion-set'});
        const button = Object.assign(document.createElement('button'), {type: 'button', className: 'suggestion', textContent: tag});
        button.setAttribute('aria-pressed', String((inputId === 'project-tags' ? projectSelected : imageSelected).has(tag.toLowerCase())));
        button.title = `Toggle “${tag}” in ${inputId === 'project-tags' ? 'every image in this project' : 'this image only'}`;
        button.addEventListener('click', () => {
          changeTag(inputId, tag, true);
          $(inputId).focus({preventScroll: true});
        });
        wrap.append(button);
        return wrap;
      }));
    }
    // the third column: like renderTagButtons, with each word's rating beside it (src/lib/keyword-ratings.js)
    function renderRatedButtons(containerId, items, emptyText) {
      const selected = new Set(tags($('project-tags').value).map((tag) => tag.toLowerCase()));
      if (!items.length) {
        $(containerId).replaceChildren(Object.assign(document.createElement('span'), {className: 'rating-empty', textContent: emptyText}));
        return;
      }
      $(containerId).replaceChildren(...items.map((item) => {
        const wrap = Object.assign(document.createElement('span'), {className: 'suggestion-set'});
        const button = Object.assign(document.createElement('button'), {type: 'button', className: 'suggestion', textContent: item.tag});
        button.setAttribute('aria-pressed', String(selected.has(item.tag.toLowerCase())));
        button.title = `Toggle “${item.tag}” in every image in this project · ${item.title}`;
        button.addEventListener('click', () => {
          changeTag('project-tags', item.tag, true);
          $('project-tags').focus({preventScroll: true});
        });
        const badge = Object.assign(document.createElement('span'), {className: 'rating', textContent: item.badge, title: item.title});
        badge.dataset.level = item.level === null ? 'none' : String(item.level);
        if (item.bing !== null && item.bing !== undefined) badge.textContent += ` · Bing ${item.bing}`;
        wrap.append(button, badge);
        return wrap;
      }));
    }
    function renderFilmstrip(project, projectIndex, imageIndex) {
      const start = flat.findIndex((item) => item.projectIndex === projectIndex);
      $('filmstrip').replaceChildren(...project.images.map((image, index) => {
        const button = Object.assign(document.createElement('button'), {type: 'button', title: `Open image ${index + 1} of ${project.images.length}`});
        const lead = image.url === heroOf(project);
        button.dataset.hero = String(lead);
        button.setAttribute('aria-label', `Open image ${index + 1} of ${project.images.length}${lead ? ', the lead picture' : ''}`);
        button.setAttribute('aria-current', String(index === imageIndex));
        const thumbnail = Object.assign(document.createElement('img'), {src: image.src, alt: '', loading: 'lazy'});
        button.append(thumbnail);
        button.addEventListener('click', () => { collect(); state.cursor = start + index; render(); });
        return button;
      }));
      requestAnimationFrame(() => $('filmstrip').querySelector('[aria-current="true"]')?.scrollIntoView({block: 'nearest', inline: 'center'}));
    }
    function refreshKeywords() {
      const {project, image} = current();
      const projectTags = tags($('project-tags').value);
      const imageTags = tags($('image-tags').value);
      $('inherited').replaceChildren(...projectTags.map((tag) => Object.assign(document.createElement('span'), {className: 'chip', textContent: tag})));
      renderTagButtons('project-original-suggestions', project.originalSuggestions, 'project-tags');
      renderTagButtons('project-search-suggestions', project.searchSuggestions, 'project-tags');
      renderRatedButtons('project-rated-suggestions', project.rated?.hasData ? project.rated.rated : [], 'No data yet: the ratings come with the next build.');
      renderRatedButtons('project-rated-related', project.rated?.related ?? [], project.rated?.hasData ? 'None that more people read about.' : 'No data yet.');
      renderTagButtons('image-suggestions', image.suggestions, 'image-tags');
      $('nearby').replaceChildren(...(image.nearby.length
        ? image.nearby.map(({image: number, text}) => {
          const line = document.createElement('span');
          line.append(`Image ${number}: `, Object.assign(document.createElement('q'), {textContent: text}));
          return line;
        })
        : [Object.assign(document.createElement('span'), {textContent: 'No other handwritten description in this post yet.'})]));
      const effective = tags([...projectTags, ...imageTags].join(', '));
      $('effective').textContent = effective.length ? `Every image in this project exports with ${projectTags.length} shared keyword${projectTags.length === 1 ? '' : 's'}${imageTags.length ? `; this image has ${imageTags.length} extra` : ''}: ${effective.join(' · ')}` : 'No keywords yet. Pick a small, accurate shared set for this project.';
    }
    function updateProgress() {
      const done = completed();
      $('progress-label').textContent = `${done} of ${DATA.projects.length} projects`;
      $('remaining').textContent = done === DATA.projects.length ? 'Complete!' : `${DATA.projects.length - done} to go`;
      $('bar').style.width = `${done / DATA.projects.length * 100}%`;
      $('score').textContent = state.session ? `${state.session} project${state.session === 1 ? '' : 's'} tagged this session` : 'One set of words per project';
      document.title = `${done}/${DATA.projects.length} projects · ${current().project.title}`;
    }
    function render({focus = true} = {}) {
      const {project, projectIndex, image, imageIndex} = current();
      const record = recordFor(image);
      const projectRecord = state.projects[project.id] ?? {};
      $('picture').src = image.src;
      $('picture').srcset = image.srcset;
      $('picture').width = image.width || 1;
      $('picture').height = image.height || 1;
      $('picture').alt = `${project.title}, picture ${imageIndex + 1}, ready to describe`;
      $('portfolio').textContent = project.portfolio;
      $('project-title').textContent = project.title;
      $('project-picker').value = String(projectIndex);
      $('project-link').href = project.href;
      $('project-scope-help').textContent = `Choose these once; ${project.images.length === 1 ? 'the image' : `all ${project.images.length} images`} in this project inherit${project.images.length === 1 ? 's' : ''} them.`;
      $('project-tags').value = projectRecord.tags ?? '';
      $('description').value = record.description ?? image.existingDescription ?? '';
      $('description-panel').querySelector('summary').textContent = image.existingDescription ? 'Later round · original description loaded' : 'Later round · star or outlier image';
      $('image-tags').value = record.tags ?? '';
      $('image-counter').textContent = `${imageIndex + 1} / ${project.images.length}`;
      const lead = image.url === heroOf(project);
      $('make-hero').setAttribute('aria-pressed', String(lead));
      $('make-hero').textContent = lead ? '★ Lead picture of this project' : '☆ Make this the lead picture';
      renderFilmstrip(project, projectIndex, imageIndex);
      refreshKeywords();
      updateProgress();
      save();
      if (focus) $('project-tags').focus({preventScroll: true});
    }
    function moveProject(delta, complete = false) {
      const {project, projectIndex} = current();
      collect();
      const projectRecord = state.projects[project.id];
      if (complete && !projectRecord.reviewed) {
        projectRecord.reviewed = true;
        state.session++;
        const cheers = ['Project locked in.', 'One whole image set made findable.', 'Nice. Keep rolling.', 'Shared words saved.', 'That project is tagged.'];
        $('celebrate').textContent = cheers[state.session % cheers.length];
      } else $('celebrate').textContent = '';
      save();
      const nextProject = (projectIndex + delta + DATA.projects.length) % DATA.projects.length;
      state.cursor = flat.findIndex((item) => item.projectIndex === nextProject);
      render();
    }
    function keywordRows() {
      const map = new Map();
      const add = (tag, projectId, imageKey) => {
        const key = tag.toLowerCase();
        const entry = map.get(key) ?? {tag, projects: new Set(), images: new Set()};
        entry.projects.add(projectId);
        if (imageKey) entry.images.add(imageKey);
        map.set(key, entry);
      };
      for (const project of DATA.projects) {
        for (const tag of [...project.currentKeywords, ...tags(state.projects[project.id]?.tags)]) add(tag, project.id);
        for (const image of project.images) for (const tag of tags(recordFor(image).tags)) add(tag, project.id, image.key);
      }
      return [...map.values()].sort((a, b) => b.projects.size - a.projects.size || b.images.size - a.images.size || a.tag.localeCompare(b.tag));
    }
    function renderMap() {
      const query = $('map-filter').value.trim().toLowerCase();
      $('map-list').replaceChildren(...keywordRows().filter(({tag}) => tag.toLowerCase().includes(query)).map(({tag, projects, images}) => {
        const row = Object.assign(document.createElement('div'), {className: 'keyword-row'});
        const label = document.createElement('div');
        label.append(Object.assign(document.createElement('strong'), {textContent: tag}), Object.assign(document.createElement('small'), {textContent: `${projects.size} project${projects.size === 1 ? '' : 's'}${images.size ? ` · ${images.size} individually tagged image${images.size === 1 ? '' : 's'}` : ''}`}));
        const project = Object.assign(document.createElement('button'), {type: 'button', textContent: '+ project', title: `Add “${tag}” to every image in this project`});
        project.addEventListener('click', () => { changeTag('project-tags', tag); renderMap(); });
        row.append(label, project);
        return row;
      }));
    }

    $('editor').addEventListener('input', (event) => {
      collect();
      updateProgress();
      if (event.target.id === 'project-tags' || event.target.id === 'image-tags') refreshKeywords();
    });
    $('editor').addEventListener('submit', (event) => { event.preventDefault(); moveProject(1, true); });
    $('previous').addEventListener('click', () => moveProject(-1));
    $('skip').addEventListener('click', () => moveProject(1));
    $('project-picker').addEventListener('change', (event) => { collect(); state.cursor = flat.findIndex(({projectIndex}) => projectIndex === Number(event.target.value)); render(); });
    $('add-original-suggestions').addEventListener('click', () => { putTags('project-tags', [...tags($('project-tags').value), ...current().project.originalSuggestions]); collect(); refreshKeywords(); });
    $('add-nearby-suggestions').addEventListener('click', () => { putTags('image-tags', [...tags($('image-tags').value), ...current().image.nearbySuggestions]); collect(); refreshKeywords(); $('image-tags').focus({preventScroll: true}); });
    $('clear-image-tags').addEventListener('click', () => { $('image-tags').value = ''; collect(); refreshKeywords(); $('image-tags').focus({preventScroll: true}); });
    addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); moveProject(1, true); }
      if (event.altKey && event.key === 'ArrowLeft') { event.preventDefault(); moveProject(-1); }
      if (event.altKey && event.key === 'ArrowRight') { event.preventDefault(); moveProject(1); }
    });
    $('export').addEventListener('click', () => {
      collect();
      const images = Object.fromEntries(flat.map(({project, image}) => {
        const record = recordFor(image);
        const projectKeywords = tags(state.projects[project.id]?.tags);
        const imageKeywords = tags(record.tags);
        return [image.key, {
          projectId: project.id,
          url: image.url,
          description: record.description ?? image.existingDescription ?? '',
          projectKeywords,
          imageKeywords,
          keywords: tags([...projectKeywords, ...imageKeywords].join(', ')),
          reviewed: Boolean(state.projects[project.id]?.reviewed || record.reviewed),
        }];
      }));
      const output = {version: 4, exportedAt: new Date().toISOString(), projects: state.projects, images};
      const blob = new Blob([JSON.stringify(output, null, 2) + '\n'], {type: 'application/json'});
      const link = Object.assign(document.createElement('a'), {href: URL.createObjectURL(blob), download: 'reddy-world-image-metadata.json'});
      link.click();
      URL.revokeObjectURL(link.href);
    });
    // An export from another address (a PR preview, another browser) carries the work over:
    // the projects in it and their pictures replace what this browser has for them
    $('load').addEventListener('click', () => $('load-file').click());
    $('load-file').addEventListener('change', async (event) => {
      const file = event.target.files?.[0];
      event.target.value = '';
      if (!file) return;
      try {
        const loaded = JSON.parse(await file.text());
        if (loaded.version !== 4 || typeof loaded.images !== 'object') throw new Error('not a version 4 export');
        collect();
        const opened = Object.keys(loaded.projects ?? {});
        for (const id of opened) state.projects[id] = {...state.projects[id], ...loaded.projects[id]};
        for (const [key, entry] of Object.entries(loaded.images)) {
          if (!opened.includes(entry.projectId ?? key.split('::')[0])) continue;
          state.images[key] = {...state.images[key], description: entry.description ?? '', tags: (entry.imageKeywords ?? []).join(', '), reviewed: Boolean(entry.reviewed)};
        }
        state.cursor = Math.max(0, firstIncomplete());
        save();
        render();
        $('celebrate').textContent = `Loaded ${opened.length} projects from ${file.name}.`;
      } catch (error) {
        $('celebrate').textContent = `Could not load ${file.name}: ${error.message}.`;
      }
    });
    $('make-hero').addEventListener('click', () => {
      const {project, image} = current();
      collect();
      state.projects[project.id] = {...state.projects[project.id], hero: image.url};
      save();
      render({focus: false});
      $('celebrate').textContent = 'Lead picture chosen: it heads the project, its card and the wall.';
    });
    $('rated-source').textContent = DATA.ratingsInfo?.updatedAt
      ? `Ratings from Wikipedia and Datamuse${DATA.ratingsInfo.bing ? ' and Bing Webmaster Tools' : ''}, fetched ${DATA.ratingsInfo.updatedAt.slice(0, 10)} when the site was built.`
      : 'No ratings fetched yet.';
    $('help').addEventListener('click', () => $('keys').showModal());
    $('close-keys').addEventListener('click', () => $('keys').close());
    $('map').addEventListener('click', () => { collect(); renderMap(); $('keyword-map').showModal(); $('map-filter').focus(); });
    $('map-filter').addEventListener('input', renderMap);
    $('close-map').addEventListener('click', () => $('keyword-map').close());
    render();
  </script>
</body>
</html>
