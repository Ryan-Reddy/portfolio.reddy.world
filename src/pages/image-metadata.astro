---
import { deskProjects, ratingCandidates, WORD_BANK } from '../lib/desk-keywords.js';
import { ideasFor, normalize, stems, RISING } from '../lib/keyword-ratings.js';
import ratings from '../data/keyword-ratings.json';
import { archiveCredits } from '../lib/desk-credits.js';

// Every word idea in one list, each rated (scripts/keyword-ratings.mjs fetches the numbers at build time):
// per project the words and where they came from; each word's rating once, in `ratings`.
const deskList = deskProjects();
const vocabulary = new Set(deskList.flatMap((project) => ratingCandidates(project).flatMap(stems)));
const ideaRatings = {};
const bank = WORD_BANK.flatMap((list) => list.words);
const projects = deskList.map((project) => {
  const ideas = ideasFor([
    { source: 'yours', words: project.originalSuggestions },
    { source: 'search', words: project.searchSuggestions },
    { source: 'bank', words: bank },
  ], ratings, { vocabulary, relatedFrom: project.intent });
  for (const { sources, ...rating } of ideas) ideaRatings[normalize(rating.tag)] ??= rating;
  return { ...project, ideas: ideas.map((idea) => [idea.tag, idea.sources]) };
});
const ratingsInfo = {updatedAt: ratings.updatedAt, bing: Object.keys(ratings.bing ?? {}).length > 0, rising: RISING};
const count = projects.reduce((sum, project) => sum + project.images.length, 0);
const queue = JSON.stringify({ projects, count, ratingsInfo, ratings: ideaRatings }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Portfolio desk — reddy.world</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap">
  <style is:global>
    /* The desk: the picture on the left, one tab at a time on the right (Project · Picture · Preview).
       Colours and type follow reddy.world (public/css/mainCSS.css there), so the previews look like the wall. */
    :root {
      color-scheme: dark;
      --bg: #0f0f0f; --surface: #1a1a1a; --raised: #222220; --fg: #f5f5f0; --muted: #a9a69f; --line: #3a3a37;
      --gold: #c7a86d; --gold-ink: #0f0f0f; --chip: #2b251a; --chip-ink: #e7cf9d;
      --display: 'Cormorant Garamond', Georgia, serif; --body: Inter, system-ui, sans-serif;
      font-family: var(--body); background: var(--bg); color: var(--fg);
    }
    * { box-sizing: border-box; }
    body { margin: 0; overflow: hidden; }
    button, input, textarea, select { font: inherit; color: inherit; }
    button { min-height: 2.5rem; border: 1px solid var(--gold); padding: .5rem .85rem; color: var(--gold); background: transparent; cursor: pointer; }
    button.primary { color: var(--gold-ink); background: var(--gold); font-weight: 650; }
    button:disabled { opacity: .45; cursor: not-allowed; }
    button.quiet { border-color: var(--line); color: var(--fg); }
    button.link { min-height: 0; padding: 0; border: 0; color: var(--gold); font-size: .8rem; text-decoration: underline; text-underline-offset: 2px; }
    button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, [contenteditable]:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    a { color: var(--gold); }
    input, textarea, select { width: 100%; background: var(--surface); border: 1px solid #5a5a56; padding: .6rem .7rem; }
    textarea { min-height: 4.5rem; resize: vertical; line-height: 1.45; }
    label { display: grid; gap: .35rem; font-weight: 600; font-size: .9rem; }
    .hint { color: var(--muted); font-size: .8rem; line-height: 1.4; font-weight: 400; margin: 0; }

    /* header */
    .top { height: 4rem; padding: .5rem 1rem; display: flex; align-items: center; gap: .75rem; border-bottom: 1px solid var(--line); }
    .top .brand { font-family: var(--display); font-size: 1.35rem; font-weight: 600; white-space: nowrap; }
    .nav { display: flex; align-items: center; gap: .4rem; min-width: 0; flex: 1 1 26rem; }
    .nav select { min-width: 0; }
    .nav button { flex: 0 0 auto; padding-inline: .6rem; }
    .progress { display: grid; gap: .2rem; min-width: 11rem; font-size: .82rem; }
    .bar { height: .3rem; background: #2a2a28; }
    .bar span { display: block; height: 100%; width: 0; background: var(--gold); transition: width .2s ease; }
    .saved { color: var(--muted); font-size: .72rem; display: flex; gap: .4rem; align-items: center; }
    .saved button { min-height: 0; padding: .05rem .4rem; font-size: .72rem; }
    .actions { display: flex; gap: .4rem; align-items: center; margin-left: auto; }
    details.more { position: relative; }
    details.more > summary { list-style: none; cursor: pointer; border: 1px solid var(--line); padding: .5rem .8rem; min-height: 2.5rem; display: flex; align-items: center; }
    details.more > summary::-webkit-details-marker { display: none; }
    details.more[open] > .menu { position: absolute; right: 0; top: calc(100% + .3rem); z-index: 5; display: grid; gap: .3rem; padding: .5rem; min-width: 12rem; background: var(--raised); border: 1px solid var(--line); }
    .menu button { text-align: left; border-color: var(--line); color: var(--fg); }

    /* workbench */
    .workbench { height: calc(100dvh - 4rem); display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(24rem, 1fr); grid-template-rows: minmax(0, 1fr); }
    .stage { min-width: 0; min-height: 0; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: #090909; }
    .stage-bar { display: flex; align-items: center; gap: .6rem; padding: .55rem .8rem; border-bottom: 1px solid var(--line); font-size: .85rem; }
    .stage-bar .count { color: var(--muted); font-variant-numeric: tabular-nums; }
    .stage-bar .spacer { flex: 1; }
    .stage-bar a { white-space: nowrap; }
    button.lead[aria-pressed="true"] { color: var(--gold-ink); background: var(--gold); font-weight: 650; }
    /* the picture fits the space left between the bar and the filmstrip, whatever its shape */
    .picture { position: relative; min-height: 0; overflow: hidden; }
    .picture img { position: absolute; inset: 0; margin: auto; display: block; max-width: calc(100% - 2rem); max-height: calc(100% - 2rem); object-fit: contain; background: #151515; }
    .filmstrip { display: flex; gap: .4rem; padding: .5rem .75rem; overflow-x: auto; border-top: 1px solid var(--line); }
    .filmstrip button { flex: 0 0 auto; width: 4.2rem; height: 3.6rem; min-height: 0; padding: .12rem; border-color: #555; position: relative; }
    .filmstrip button[aria-current="true"] { border-color: var(--gold); outline: 2px solid var(--gold); outline-offset: -3px; }
    .filmstrip button[data-lead="true"]::after { content: '★'; position: absolute; top: .05rem; right: .2rem; color: var(--gold); text-shadow: 0 0 3px #000; font-size: .85rem; }
    .filmstrip img { display: block; width: 100%; height: 100%; object-fit: cover; }

    /* panel and tabs */
    .panel { min-width: 0; min-height: 0; display: grid; grid-template-rows: auto auto minmax(0, 1fr); border-left: 1px solid var(--line); }
    .head { padding: .8rem 1rem .4rem; display: grid; gap: .2rem; }
    .head small { color: var(--muted); }
    .head h1 { margin: 0; font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 600; line-height: 1.05; text-wrap: balance; }
    .head .meta { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; color: var(--muted); font-size: .8rem; }
    .state { padding: .1rem .5rem; border: 1px solid var(--line); font-size: .75rem; }
    .state[data-done="true"] { border-color: var(--gold); color: var(--gold); }
    .tabs { display: flex; gap: 0; padding: 0 1rem; border-bottom: 1px solid var(--line); }
    .tabs button { border: 0; border-bottom: 2px solid transparent; color: var(--muted); min-height: 2.6rem; padding: .4rem .9rem; }
    .tabs button[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--gold); font-weight: 600; }
    .tab { overflow-y: auto; padding: 1rem; display: grid; align-content: start; gap: 1.1rem; }
    .tab[hidden] { display: none; }
    section.block { display: grid; gap: .5rem; }
    section.block > h2 { margin: 0; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }

    /* keyword chips */
    .chips { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; padding: .4rem; min-height: 2.8rem; background: var(--surface); border: 1px solid #5a5a56; }
    .chip { display: inline-flex; align-items: center; gap: .25rem; padding: .2rem .25rem .2rem .55rem; background: var(--chip); color: var(--chip-ink); font-size: .82rem; }
    .chip button { min-height: 0; padding: 0 .3rem; border: 0; color: var(--chip-ink); font-size: .95rem; line-height: 1; }
    .chip.inherited { background: transparent; border: 1px dashed #5a5a56; color: var(--muted); padding-right: .55rem; }
    .chips input { flex: 1 1 8rem; min-width: 8rem; border: 0; padding: .3rem; background: transparent; }
    .chips input:focus-visible { outline: 0; }
    .ideas { display: flex; flex-wrap: wrap; gap: .35rem; }
    .idea { display: inline-flex; align-items: stretch; border: 1px solid #555; border-radius: 999px; overflow: hidden; }
    .idea button { min-height: 0; padding: .28rem .55rem; border: 0; color: #d7d7d1; font-size: .78rem; }
    .idea button[aria-pressed="true"] { color: var(--gold-ink); background: var(--gold); }
    .idea .rating { display: inline-flex; align-items: center; padding: 0 .45rem; border-left: 1px solid #555; color: var(--gold); font-size: .68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .idea .rating[data-level="none"] { color: #888; }
    .idea[data-rising="true"] { border-color: var(--gold); }
    .subtabs button:disabled { opacity: .4; }
    details.drawer { border: 1px solid var(--line); }
    details.drawer > summary { cursor: pointer; padding: .55rem .7rem; font-size: .85rem; font-weight: 600; }
    details.drawer > div { padding: 0 .7rem .7rem; display: grid; gap: .55rem; }
    .subtabs { display: flex; flex-wrap: wrap; gap: .3rem; }
    .subtabs button { min-height: 0; padding: .25rem .6rem; font-size: .78rem; border-color: var(--line); color: var(--muted); }
    .subtabs button[aria-pressed="true"] { border-color: var(--gold); color: var(--gold); }
    .row-label { color: var(--muted); font-size: .75rem; }

    /* the post's own text */
    .story { min-height: 10rem; max-height: 26rem; overflow-y: auto; padding: .7rem .85rem; background: var(--surface); border: 1px solid #5a5a56; line-height: 1.55; font-size: .92rem; }
    .story p { margin: 0 0 .7em; }
    .story h2, .story h3, .story h4 { font-family: var(--display); margin: .6em 0 .3em; }
    .pics { display: inline-flex; gap: .2rem; align-items: center; margin: .15rem 0; padding: .2rem; border: 1px solid var(--line); background: #111; user-select: none; vertical-align: middle; }
    .pics img { width: 2.4rem; height: 1.8rem; object-fit: cover; display: block; }

    /* what WordPress had */
    dl.wp { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: .35rem .6rem; font-size: .82rem; align-items: baseline; }
    dl.wp dt { color: var(--muted); }
    dl.wp dd { margin: 0; overflow-wrap: anywhere; }
    .bottom { display: flex; gap: .5rem; flex-wrap: wrap; }
    .note { color: var(--gold); min-height: 1.2rem; font-size: .85rem; }

    /* previews: reddy.world's own look (overview.ts .tile/.work/.cap and .lead-row; [slug].astro) */
    .preview { display: grid; gap: .5rem; }
    .preview > h3 { margin: 0; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
    .wall { background: #0f0f0f; border: 1px solid var(--line); padding: 1rem; display: grid; gap: 1rem; }
    .tile { position: relative; width: min(100%, 20rem); overflow: hidden; background: #1a1a1a; }
    .tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .tile .cap { position: absolute; inset: auto 0 0; padding: 1.6rem .7rem .55rem; background: linear-gradient(transparent, rgba(0,0,0,.82)); display: grid; gap: .1rem; }
    .tile .cap .t { font-family: var(--display); font-size: 1.15rem; font-weight: 600; line-height: 1.1; color: #f5f5f0; }
    .tile .cap .m { font-size: .72rem; color: rgba(245,245,240,.75); }
    .lead-row { display: grid; grid-template-columns: 3fr 2fr; gap: 1rem; border-top: 2px solid #f5f5f0; border-bottom: 1px solid rgba(245,245,240,.25); padding: .8rem 0; }
    .lead-row .lead-pic { overflow: hidden; background: #1a1a1a; }
    .lead-row .lead-pic img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .lead-text { display: grid; align-content: start; gap: .35rem; }
    .lead-text .kicker { font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(245,245,240,.6); }
    .lead-text .title { font-family: var(--display); font-size: 1.7rem; font-weight: 600; line-height: 1.05; margin: 0; }
    .lead-text .line { font-family: var(--display); font-style: italic; font-size: 1.1rem; }
    .lead-text .desc { color: rgba(245,245,240,.7); font-size: .85rem; line-height: 1.45; margin: 0; }
    .lead-text .go { color: var(--gold); font-size: .82rem; }
    .panel-lines { display: grid; gap: .25rem; border-left: 2px solid var(--gold); padding-left: .7rem; }
    .panel-lines strong { font-family: var(--display); font-size: 1.35rem; font-weight: 600; }
    .panel-lines span { color: rgba(245,245,240,.7); font-size: .82rem; }
    .page { background: #0f0f0f; border: 1px solid var(--line); padding: 1rem; display: grid; gap: .45rem; }
    .page .crumb { font-size: .72rem; color: rgba(245,245,240,.6); }
    .page .when { font-family: ui-monospace, Consolas, monospace; font-size: .75rem; color: rgba(245,245,240,.7); }
    .page h4 { margin: 0; font-family: var(--display); font-size: 2rem; font-weight: 600; line-height: 1.05; color: var(--gold); }
    .page .sum { margin: 0; font-size: .95rem; line-height: 1.5; }
    .page figure { margin: .3rem 0 0; }
    .page figure img { display: block; width: 100%; max-height: 18rem; object-fit: cover; }
    .page figcaption { font-size: .75rem; color: rgba(245,245,240,.7); margin-top: .3rem; }
    .empty-note { color: #888; font-style: italic; }

    /* an article: how it reads on the left, the editor on the right */
    .workbench[hidden] { display: none; }
    .reading { overflow-y: auto; padding: 1.5rem clamp(1rem, 4vw, 3rem); display: grid; align-content: start; gap: .6rem; max-width: 48rem; }
    .reading .when { font-family: ui-monospace, Consolas, monospace; font-size: .75rem; color: rgba(245,245,240,.7); }
    .reading-title { margin: 0; font-family: var(--display); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; line-height: 1.15; color: var(--gold); }
    .reading .sum { margin: 0; font-size: 1.15rem; line-height: 1.6; }
    .reading-text { font-size: 1.05rem; line-height: 1.8; }
    .reading-text h2, .reading-text h3, .reading-text h4 { font-family: var(--display); }
    .panel.article-panel { grid-template-rows: auto minmax(0, 1fr); }
    .ov-articles ul { list-style: none; margin: .4rem 0; padding: 0; display: grid; gap: .3rem; }
    .ov-articles h3 { margin: .6rem 0 0; font-family: var(--display); font-size: 1.35rem; font-weight: 600; }

    dialog { max-width: 36rem; color: var(--fg); background: #151515; border: 1px solid var(--gold); }
    dialog.map-dialog { width: min(64rem, calc(100% - 2rem)); max-width: none; max-height: calc(100dvh - 2rem); }
    .map-tools { position: sticky; top: 0; display: flex; gap: .6rem; padding-bottom: .75rem; background: #151515; }
    .keyword-map { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .45rem; }
    .keyword-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .3rem; padding: .45rem; border: 1px solid #3a3a38; }
    .keyword-row small { display: block; color: var(--muted); }
    dialog::backdrop { background: rgba(0,0,0,.75); }

    /* the overview (src/lib/desk-sync.js draws it) */
    .overview { position: fixed; inset: 0; z-index: 10; overflow-y: auto; background: var(--bg); }
    .overview[hidden] { display: none; }
    .ov-wrap { max-width: 44rem; margin: 0 auto; padding: 1.5rem 1rem 4rem; display: grid; gap: .9rem; }
    .ov-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .ov-head h2 { margin: 0; font-family: var(--display); font-size: 2rem; font-weight: 600; }
    .ov-next { min-height: 4rem; font-size: 1.25rem; text-align: left; }
    .ov-big { margin: .5rem 0 0; font-size: 1.15rem; font-weight: 600; }
    .ov-line { margin: 0; color: #ccc; line-height: 1.45; }
    .ov-bar { display: flex; height: .7rem; background: #2a2a28; }
    .ov-bar .ov-done { background: var(--gold); }
    .ov-bar .ov-started { background: #7a6a48; }
    .ov-portfolio { border-top: 1px solid var(--line); padding: .7rem 0; }
    .ov-portfolio summary { cursor: pointer; display: grid; gap: .45rem; }
    .ov-portfolio summary span { display: flex; justify-content: space-between; gap: 1rem; }
    .ov-portfolio summary small { color: var(--muted); }
    .ov-portfolio ul { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .3rem; }
    .ov-row { width: 100%; min-height: 0; display: grid; grid-template-columns: .8rem 1fr; gap: .1rem .6rem; text-align: left; border-color: #3a3a38; color: var(--fg); }
    .ov-row small { grid-column: 2; color: var(--muted); }
    .ov-dot { width: .7rem; height: .7rem; margin-top: .3rem; border: 1px solid var(--gold); border-radius: 50%; }
    .ov-dot.ov-done { background: var(--gold); }
    .ov-dot.ov-started { background: #7a6a48; }

    @media (max-width: 900px) {
      body { overflow: auto; }
      .top { height: auto; flex-wrap: wrap; row-gap: .5rem; }
      .top .brand { display: none; }
      .nav { flex: 1 1 100%; }
      .progress { flex: 1 1 10rem; min-width: 0; }
      .workbench { height: auto; grid-template-columns: 1fr; grid-template-rows: auto; }
      .stage { height: 52dvh; }
      .stage-bar { padding: .4rem .6rem; gap: .5rem; }
      .stage-bar .count { white-space: nowrap; }
      .stage-bar button.lead { min-height: 2.2rem; padding: .3rem .6rem; font-size: .82rem; }
      .panel { border-left: 0; border-top: 1px solid var(--line); }
      .tab { overflow: visible; }
      .lead-row { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) { .bar span { transition: none; } }
  </style>
</head>
<body>
  <header class="top">
    <span class="brand">Portfolio desk</span>
    <nav class="nav" aria-label="Projects">
      <button id="previous" class="quiet" type="button" title="Previous project (Alt+←)">←</button>
      <select id="project-picker" aria-label="Project"></select>
      <button id="next-project" class="quiet" type="button" title="Next project (Alt+→)">→</button>
      <button id="new-article" class="quiet" type="button" title="A new article for the wall, kept as a draft">＋ Article</button>
    </nav>
    <div class="progress">
      <span id="progress-label"></span>
      <div class="bar"><span id="bar"></span></div>
      <span class="saved"><span data-desk-saved aria-live="polite">Saved in this browser</span><button data-desk-signin type="button" hidden>Sign in</button></span>
    </div>
    <div class="actions">
      <button id="open-overview" type="button">Overview</button>
      <button id="send" class="primary" type="button">Send to site</button>
      <details class="more"><summary>More</summary>
        <div class="menu">
          <button id="map" type="button">Keyword map</button>
          <button id="help" type="button">How this desk works</button>
          <button id="export" type="button">Export a copy</button>
          <button id="load" type="button">Load an export</button>
          <input id="load-file" type="file" accept=".json,application/json" hidden>
        </div>
      </details>
    </div>
  </header>

  <main class="workbench" id="project-bench">
    <section class="stage" aria-label="Pictures of this project">
      <div class="stage-bar">
        <span class="count" id="image-counter"></span>
        <span class="spacer"></span>
        <button id="make-hero" class="lead" type="button" aria-pressed="false">☆ Make this the lead picture</button>
        <a id="project-link" target="_blank" rel="noreferrer">Open the page ↗</a>
      </div>
      <div class="picture"><img id="picture" alt=""></div>
      <nav class="filmstrip" id="filmstrip" aria-label="All pictures in this project"></nav>
    </section>

    <section class="panel" aria-label="This project">
      <div class="head">
        <small id="portfolio"></small>
        <h1 id="project-title"></h1>
        <div class="meta"><span id="project-when"></span><span class="state" id="project-state"></span></div>
      </div>
      <div class="tabs" role="tablist" aria-label="What to work on">
        <button role="tab" id="tab-project" aria-controls="pane-project" aria-selected="true" type="button">Project</button>
        <button role="tab" id="tab-picture" aria-controls="pane-picture" aria-selected="false" type="button">Picture</button>
        <button role="tab" id="tab-preview" aria-controls="pane-preview" aria-selected="false" type="button">Preview</button>
      </div>

      <div class="tab" role="tabpanel" id="pane-project" aria-labelledby="tab-project">
        <section class="block">
          <label for="summary">Short summary</label>
          <textarea id="summary" placeholder="One or two lines in your own words"></textarea>
          <p class="hint" id="summary-hint"></p>
        </section>

        <section class="block">
          <h2>Keywords for every picture in this project</h2>
          <div class="chips" id="project-chips"></div>
          <p class="hint" id="project-keywords-hint"></p>
          <details class="drawer" id="ideas">
            <summary>Ideas</summary>
            <div>
              <div class="subtabs" id="idea-tabs"></div>
              <div id="idea-list" class="ideas"></div>
              <p class="hint" id="idea-hint"></p>
            </div>
          </details>
        </section>

        <section class="block">
          <h2>The post's text</h2>
          <div class="story" id="story" contenteditable="true" role="textbox" aria-multiline="true" aria-label="The post's text"></div>
          <p class="hint">Edit the words; the picture blocks keep the pictures in place. <button class="link" id="story-reset" type="button">Undo my changes to the text</button></p>
        </section>

        <details class="drawer">
          <summary>From WordPress</summary>
          <div><dl class="wp" id="wp-project"></dl></div>
        </details>

        <div class="bottom">
          <button id="done" class="primary" type="button">Done, next project →</button>
          <button id="reopen" class="quiet" type="button" hidden>Not done yet</button>
        </div>
        <p class="note" id="note" aria-live="polite"></p>
      </div>

      <div class="tab" role="tabpanel" id="pane-picture" aria-labelledby="tab-picture" hidden>
        <section class="block">
          <label for="description">What someone who can't see this picture should hear</label>
          <textarea id="description" placeholder="Who or what is in it, and where"></textarea>
          <p class="hint">This is the picture's alt text on the site.</p>
        </section>
        <section class="block">
          <h2>Keywords for this picture only</h2>
          <div class="chips" id="image-chips"></div>
          <p class="hint">Dashed: the project's keywords, which every picture already has.</p>
          <div class="ideas" id="image-ideas"></div>
        </section>
        <details class="drawer" id="credit-panel">
          <summary id="credit-summary">Photographer</summary>
          <div>
            <label>This picture by <input id="credit-image-name" autocomplete="off" placeholder="Name as it should appear"></label>
            <label>Their site <input id="credit-image-url" inputmode="url" autocomplete="off" placeholder="https://…"></label>
            <label>Every picture in this project by <input id="credit-project-name" autocomplete="off" placeholder="Name as it should appear"></label>
            <label>Their site <input id="credit-project-url" inputmode="url" autocomplete="off" placeholder="https://…"></label>
            <p class="hint" id="credit-shown" aria-live="polite"></p>
            <button id="next-uncredited" type="button">Next picture without a photographer →</button>
          </div>
        </details>
        <details class="drawer" open>
          <summary>From WordPress</summary>
          <div><dl class="wp" id="wp-picture"></dl></div>
        </details>
      </div>

      <div class="tab" role="tabpanel" id="pane-preview" aria-labelledby="tab-preview" hidden>
        <div class="preview">
          <h3>On the wall</h3>
          <div class="wall" id="preview-wall"></div>
        </div>
        <div class="preview">
          <h3>On its page</h3>
          <div class="page" id="preview-page"></div>
        </div>
      </div>
    </section>
  </main>

  <main class="workbench" id="article-bench" hidden>
    <section class="stage" aria-label="How the article reads">
      <div class="stage-bar"><span class="count">How it reads on its page</span><span class="spacer"></span><button id="back-to-projects" class="quiet" type="button">← Back to the projects</button></div>
      <article class="reading" id="reading"></article>
    </section>
    <section class="panel article-panel" aria-label="This article">
      <div class="head">
        <small>Article</small>
        <h1 id="article-heading"></h1>
        <div class="meta"><span id="article-when"></span><span class="state">Draft: only you see it</span></div>
      </div>
      <div class="tab">
        <section class="block">
          <label for="article-title">Title</label>
          <input id="article-title" autocomplete="off" placeholder="The article's title">
        </section>
        <section class="block">
          <label for="article-summary">Short summary</label>
          <textarea id="article-summary" placeholder="One or two lines in your own words: shown on the wall and under the title"></textarea>
        </section>
        <section class="block">
          <h2>The text</h2>
          <div class="story" id="article-text" contenteditable="true" role="textbox" aria-multiline="true" aria-label="The article's text"></div>
          <p class="hint">Paragraphs, headings, bold, italic, links and lists are kept. Ctrl+B and Ctrl+I work.</p>
        </section>
        <section class="block">
          <h2>Publishing</h2>
          <p class="hint">A draft is saved to your account and never goes to the site, not even with Send to site.</p>
          <button id="publish-article" type="button" disabled>Publish</button>
          <p class="hint">Publishing comes with the place for stories on the site: <a href="https://github.com/Ryan-Reddy/reddy.world/issues/183" target="_blank" rel="noreferrer">decision 4 on #183</a>.</p>
        </section>
        <div class="bottom"><button id="delete-article" class="quiet" type="button">Delete this draft</button></div>
        <p class="note" id="article-note" aria-live="polite"></p>
      </div>
    </section>
  </main>

  <dialog id="keyword-map" class="map-dialog"><h2>Keyword map</h2><p class="hint">Every keyword in the archive and on this desk, and how many projects use it.</p><div class="map-tools"><input id="map-filter" type="search" placeholder="Filter keywords…" aria-label="Filter keywords"><button id="close-map" type="button">Close</button></div><div class="keyword-map" id="map-list"></div></dialog>
  <dialog id="sent" aria-labelledby="sent-title">
    <h2 id="sent-title">Send to site</h2>
    <p id="sent-text"></p>
    <p><a id="sent-link" target="_blank" rel="noreferrer"></a></p>
    <button id="close-sent" class="primary" type="button">Close</button>
  </dialog>
  <dialog id="keys">
    <h2>How this desk works</h2>
    <p>Each project opens on what the site has today. Change anything; it saves by itself, to your account when you are signed in.</p>
    <p><strong>Project</strong>: the short summary, the keywords every picture gets, and the post's text. <strong>Picture</strong>: what the picture shows, its own keywords and its photographer. <strong>Preview</strong>: how it looks on the wall and on its page.</p>
    <p>The ★ is the lead picture: it heads the page, the card and the wall. Keys: Alt+← and Alt+→ change project, Ctrl+Enter marks it done.</p>
    <p><strong>＋ Article</strong> starts a new piece for the wall. It stays a draft, only for you and saved to your account, until you publish it.</p>
    <button id="close-keys" class="primary" type="button">Got it</button>
  </dialog>
  <script type="application/json" id="queue-data" set:html={queue}></script>
  <script type="application/json" id="credit-data" set:html={archiveCredits()}></script>
  <script is:inline>
    const DATA = JSON.parse(document.querySelector('#queue-data').textContent);
    const STORE = 'reddy-world-image-metadata-v4';
    const PREVIOUS = 'reddy-world-image-metadata-v3';
    const OLDER = 'reddy-world-image-metadata-v2';
    // no saved place yet: the desk opens on the first project that is not done (set below)
    const empty = {projects: {}, images: {}, session: 0};
    const read = () => {
      try {
        const saved = localStorage.getItem(STORE) || localStorage.getItem(PREVIOUS) || localStorage.getItem(OLDER) || '{}';
        return {...empty, ...JSON.parse(saved)};
      } catch { return {...empty}; }
    };
    const state = read();
    const flat = DATA.projects.flatMap((project, projectIndex) => project.images.map((image, imageIndex) => ({project, projectIndex, image, imageIndex})));
    const $ = (id) => document.getElementById(id);
    const el = (tag, props = {}, ...children) => { const node = Object.assign(document.createElement(tag), props); node.append(...children.filter((c) => c !== null && c !== undefined && c !== false)); return node; };
    const tags = (value = '') => [...new Map(String(value).split(',').map((tag) => tag.trim()).filter(Boolean).map((tag) => [tag.toLowerCase(), tag])).values()];
    const same = (a, b) => a.toLowerCase() === b.toLowerCase();
    // desk-sync.js (below) stamps each change and copies it to Ryan's account when he is signed in
    const save = () => { window.deskSync?.stamp(state); try { localStorage.setItem(STORE, JSON.stringify(state)); } catch {} window.deskSync?.saved(); };
    const current = () => flat[state.cursor] ?? flat[0];
    const projectRecord = (project) => state.projects[project.id] ?? {};
    const recordFor = (image) => state.images[image.key] ?? state.images[image.url] ?? {};

    // What the desk shows: Ryan's change when he made one, else what the archive has today.
    // A record is only written once he changes something, so opening a project changes nothing.
    // A blank field counts as unchanged: earlier desks wrote blanks just by showing a project (and
    // "Send to site" reads blanks the same way). A field Ryan empties on purpose is named in `cleared`.
    const isCleared = (record, field) => Array.isArray(record?.cleared) && record.cleared.includes(field);
    const pick = (record, field, base) => (isCleared(record, field) ? '' : String(record[field] ?? '').trim() ? record[field] : base);
    // the record with its new value, `cleared` kept in step: emptying a field the archive fills clears it on purpose
    function withValue(record, field, value, base) {
      const cleared = (record?.cleared ?? []).filter((name) => name !== field);
      if (!String(value ?? '').trim() && String(base ?? '').trim()) cleared.push(field);
      const next = {...record, [field]: value};
      if (cleared.length) next.cleared = cleared;
      else delete next.cleared;
      return next;
    }
    const projectTags = (project) => tags(pick(projectRecord(project), 'tags', project.keywords.join(', ')));
    const isDone = (project) => Boolean(projectRecord(project).reviewed ?? project.done);
    const summaryOf = (project) => pick(projectRecord(project), 'summary', project.summary);
    const ownKeywords = (project, image) => image.keywords.filter((word) => !project.keywords.some((shared) => same(shared, word)));
    const imageTags = (project, image) => tags(pick(recordFor(image), 'tags', ownKeywords(project, image).join(', ')));
    const descriptionOf = (image) => pick(recordFor(image), 'description', image.description || image.existingDescription || image.alt || '');
    const heroOf = (project) => projectRecord(project).hero || project.hero;
    function setProject(project, field, value, base) {
      const record = state.projects[project.id];
      if (!record && value === base) return;
      state.projects[project.id] = withValue(record, field, value, base);
      save();
    }
    function setImage(image, field, value, base) {
      const record = state.images[image.key] ?? state.images[image.url];
      if (!record && value === base) return;
      state.images[image.key] = withValue(record, field, value, base);
      save();
    }
    const completed = () => DATA.projects.filter(isDone).length;
    const firstIncomplete = () => {
      const projectIndex = DATA.projects.findIndex((project) => !isDone(project));
      return projectIndex < 0 ? 0 : flat.findIndex((item) => item.projectIndex === projectIndex);
    };
    if (!Number.isInteger(state.cursor) || !flat[state.cursor]) state.cursor = Math.max(0, firstIncomplete());
    window.imageDesk = {DATA, STORE, state, flat, render: (options) => render(options)};

    // ---------- tabs ----------
    let tab = 'project';
    function showTab(name) {
      tab = name;
      for (const t of ['project', 'picture', 'preview']) {
        $(`tab-${t}`).setAttribute('aria-selected', String(t === name));
        $(`pane-${t}`).hidden = t !== name;
      }
      if (name === 'preview') renderPreview();
    }
    for (const t of ['project', 'picture', 'preview']) $(`tab-${t}`).addEventListener('click', () => showTab(t));

    // ---------- keyword chips ----------
    // The callers bind onAdd and onRemove to the project or picture the chips were drawn for, so a word still
    // in the box when Ryan moves on lands where he typed it, not on the next project.
    function renderChips(containerId, words, {inherited = [], onRemove, onAdd, placeholder}) {
      const input = el('input', {type: 'text', placeholder, autocomplete: 'off'});
      input.setAttribute('aria-label', placeholder);
      const refocus = () => $(containerId).querySelector('input')?.focus();
      input.addEventListener('keydown', (event) => {
        if ((event.key === 'Enter' || event.key === ',') && input.value.trim()) {
          event.preventDefault();
          const word = input.value.trim();
          input.value = '';
          onAdd(word);
          refocus();
        } else if (event.key === 'Backspace' && !input.value && words.length) {
          onRemove(words.at(-1));
          refocus();
        }
      });
      // leaving the box keeps the word, but quietly: no redraw under the pointer (a click on × or an idea
      // still lands) and the focus stays where Ryan put it
      input.addEventListener('blur', () => {
        const word = input.value.trim();
        if (!word) return;
        input.value = '';
        onAdd(word, {quiet: true});
      });
      $(containerId).replaceChildren(
        ...inherited.map((word) => el('span', {className: 'chip inherited', textContent: word, title: 'From the project'})),
        ...words.map((word) => {
          const remove = el('button', {type: 'button', textContent: '×', title: `Remove “${word}”`});
          remove.setAttribute('aria-label', `Remove ${word}`);
          remove.addEventListener('click', () => { onRemove(word); refocus(); });
          return el('span', {className: 'chip'}, word, remove);
        }),
        input,
      );
      return input;
    }
    const toggled = (words, word) => (words.some((w) => same(w, word)) ? words.filter((w) => !same(w, word)) : [...words, word]);
    // a quiet change is drawn a moment later, unless Ryan is typing in those chips again
    const later = (containerId, draw) => setTimeout(() => { if (!$(containerId).contains(document.activeElement)) draw(); }, 300);
    function setProjectTags(list, project = current().project, {quiet = false} = {}) {
      setProject(project, 'tags', list.join(', '), project.keywords.join(', '));
      const draw = () => { if (current().project === project) { renderProjectWords(); renderPreview(); } };
      if (quiet) later('project-chips', draw);
      else draw();
    }
    function setImageTags(list, project = current().project, image = current().image, {quiet = false} = {}) {
      setImage(image, 'tags', list.join(', '), ownKeywords(project, image).join(', '));
      const draw = () => { if (current().image === image) renderImageWords(); };
      if (quiet) later('image-chips', draw);
      else draw();
    }
    function ideaButton(word, pressed, onClick, rating) {
      const button = el('button', {type: 'button', textContent: word});
      button.setAttribute('aria-pressed', String(pressed));
      button.addEventListener('click', onClick);
      const wrap = el('span', {className: 'idea'}, button);
      if (rating) {
        const badge = el('span', {className: 'rating', textContent: rating.badge + (rating.bing != null ? ` · Bing ${rating.bing}` : ''), title: rating.title});
        badge.dataset.level = rating.level === null ? 'none' : String(rating.level);
        wrap.append(badge);
        wrap.dataset.rising = String(typeof rating.trend === 'number' && rating.trend >= (DATA.ratingsInfo?.rising ?? 0.25));
      }
      return wrap;
    }

    // ---------- the Project tab ----------
    // Every idea in one list, all rated, most searched or read first (Ryan, 2026-10-26: "why seperated?
    // bring them together, and please can we get them all rated?"). The filters only narrow it.
    const IDEA_FILTERS = [
      {id: 'all', label: 'All'},
      {id: 'rising', label: 'Rising ↑'},
      {id: 'yours', label: 'Your words'},
      {id: 'search', label: 'Clients search'},
      {id: 'related', label: 'Related'},
      {id: 'bank', label: 'Word bank'},
    ];
    const FROM = {yours: 'from your captions', search: 'what clients search for', related: 'related, more read', bank: 'your word lists'};
    const key = (word) => String(word).toLowerCase().replace(/\s+/g, ' ').trim();
    let ideaFilter = 'all';
    function renderIdeas() {
      const {project} = current();
      const chosen = projectTags(project);
      const has = (word) => chosen.some((w) => same(w, word));
      const add = (word) => () => setProjectTags(toggled(projectTags(current().project), word));
      const ideas = project.ideas.map(([tag, sources]) => ({...(DATA.ratings[key(tag)] ?? {tag, badge: '', level: null, trend: null}), tag, sources}));
      const rising = (idea) => typeof idea.trend === 'number' && idea.trend >= DATA.ratingsInfo.rising;
      $('idea-tabs').replaceChildren(...IDEA_FILTERS.map((f) => {
        const n = f.id === 'all' ? ideas.length : f.id === 'rising' ? ideas.filter(rising).length : ideas.filter((idea) => idea.sources.includes(f.id)).length;
        const button = el('button', {type: 'button', textContent: `${f.label} ${n}`});
        button.setAttribute('aria-pressed', String(f.id === ideaFilter));
        button.disabled = !n && f.id !== 'all';
        button.addEventListener('click', () => { ideaFilter = f.id; renderIdeas(); });
        return button;
      }));
      const shown = ideas.filter((idea) => ideaFilter === 'all' || (ideaFilter === 'rising' ? rising(idea) : idea.sources.includes(ideaFilter)));
      $('idea-list').replaceChildren(...(shown.length
        ? shown.map((idea) => ideaButton(idea.tag, has(idea.tag), add(idea.tag), idea.badge ? {...idea, title: [idea.title, idea.sources.map((s) => FROM[s]).join(', ')].filter(Boolean).join(' · ')} : null))
        : [el('span', {className: 'hint', textContent: 'Nothing here for this project.'})]));
      $('idea-hint').textContent = `Dots: readers of the topic on Wikipedia in 30 days (● 100+, ●● 1,000+, ●●● 10,000+). ≈: a phrase rated by its closest page. ↑: rising, a quarter or more above a year before, against Wikipedia as a whole${DATA.ratingsInfo.bing ? '; Bing: searches in the Netherlands in 4 weeks' : ''}.${DATA.ratingsInfo.updatedAt ? ` Numbers from ${new Date(DATA.ratingsInfo.updatedAt).toLocaleDateString('en-GB', {day: 'numeric', month: 'short'})}.` : ''}`;
    }
    function renderProjectWords() {
      const {project} = current();
      const words = projectTags(project);
      const input = renderChips('project-chips', words, {
        placeholder: 'Add a keyword',
        onRemove: (word) => setProjectTags(projectTags(project).filter((w) => !same(w, word)), project),
        onAdd: (word, options) => {
          const now = projectTags(project);
          setProjectTags([...now, ...tags(word).filter((w) => !now.some((x) => same(x, w)))], project, options);
        },
      });
      const record = projectRecord(project);
      const changed = isCleared(record, 'tags') || Boolean(String(record.tags ?? '').trim());
      $('project-keywords-hint').textContent = words.length
        ? (changed ? 'Your keywords on this desk. Every picture in the project gets them.' : 'The keywords the site has for this project today.')
        : 'No keywords yet. Four to eight accurate words are better than many.';
      renderIdeas();
      return input;
    }

    // A post's text keeps the tags src/lib/safe-output.js storyHtml keeps on the server: an h1 becomes an h2
    // and an h5 or h6 an h4, as the page shows them; a block of text (a div, a table cell) becomes a
    // paragraph, so lines don't run together; pictures, scripts and pasted styles go; other tags go, their words stay.
    const ALLOWED = new Set(['P', 'H2', 'H3', 'H4', 'STRONG', 'B', 'EM', 'I', 'A', 'UL', 'OL', 'LI', 'BR', 'BLOCKQUOTE', 'HR']);
    const RENAME = {H1: 'H2', H5: 'H4', H6: 'H4'};
    const BLOCKS = new Set(['DIV', 'SECTION', 'ARTICLE', 'HEADER', 'FOOTER', 'ADDRESS', 'PRE', 'TABLE', 'THEAD', 'TBODY', 'TFOOT', 'TR', 'TD', 'TH', 'FIGCAPTION', 'DL', 'DT', 'DD']);
    const DROP = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'TEMPLATE', 'SVG', 'MATH', 'IMG', 'PICTURE', 'VIDEO', 'AUDIO', 'CANVAS', 'NOSCRIPT', 'FORM', 'INPUT', 'BUTTON', 'SELECT', 'TEXTAREA']);
    // a link goes to a web address or to a page of this site; nothing that a browser could read as another host
    const safeHref = (href) => {
      const value = String(href ?? '').trim();
      if (/[\u0000-\u001f\u007f\\]/.test(value)) return false;
      return /^https?:\/\/[^/]/i.test(value) || /^\/(?!\/)/.test(value);
    };
    const holdsBlocks = (node) => [...node.children].some((c) => /^(P|H[1-6]|UL|OL|BLOCKQUOTE|HR|FIGURE|TABLE|DIV)$/.test(c.tagName) || c.classList.contains('pics'));
    // `pictures(media)`: what a <figure data-media> becomes (the desk's picture block); without it the figure stays, empty
    function tidy(root, pictures = null) {
      for (const child of [...root.childNodes]) {
        if (child.nodeType === 8) { child.remove(); continue; }
        if (child.nodeType !== 1) continue;
        const tag = child.tagName.toUpperCase();
        const media = child.dataset?.media;
        if ((tag === 'FIGURE' || child.classList.contains('pics')) && media !== undefined && /^[\d,\s]+$/.test(media)) {
          if (pictures) child.replaceWith(pictures(media));
          else if (tag === 'FIGURE') { child.replaceChildren(); for (const attr of [...child.attributes]) if (attr.name !== 'data-media') child.removeAttribute(attr.name); }
          continue;
        }
        if (DROP.has(tag)) { child.remove(); continue; }
        tidy(child, pictures);
        if (RENAME[tag]) {
          const next = document.createElement(RENAME[tag]);
          next.append(...child.childNodes);
          child.replaceWith(next);
        } else if (BLOCKS.has(tag)) {
          if (holdsBlocks(child) || child.parentNode?.closest?.('p, li, h2, h3, h4, blockquote')) child.replaceWith(...child.childNodes, ...(holdsBlocks(child) ? [] : [document.createElement('br')]));
          else { const p = document.createElement('p'); p.append(...child.childNodes); child.replaceWith(p); }
        } else if (!ALLOWED.has(tag)) child.replaceWith(...child.childNodes);
        else for (const attr of [...child.attributes]) if (!(tag === 'A' && attr.name === 'href' && safeHref(attr.value))) child.removeAttribute(attr.name);
      }
    }
    // the post's own text: WordPress HTML shown as paragraphs; <figure data-media> become fixed picture blocks
    function storyHtml(project, html) {
      const blocks = String(html).replace(/\r\n/g, '\n').split(/\n{2,}/).map((chunk) => chunk.trim()).filter((chunk) => chunk && chunk !== '&nbsp;');
      const wrapped = blocks.map((chunk) => (/^<(p|h[1-6]|ul|ol|blockquote|figure|div|hr|table)\b/i.test(chunk) ? chunk : `<p>${chunk.replace(/\n/g, '<br>')}</p>`)).join('');
      const template = document.createElement('template');
      template.innerHTML = wrapped;
      tidy(template.content, (media) => {
        const block = el('span', {className: 'pics', contentEditable: 'false'});
        block.dataset.media = media;
        for (const index of media.split(',')) {
          const src = project.thumbs[index.trim()];
          block.append(src ? el('img', {src, alt: '', loading: 'lazy'}) : el('span', {textContent: `picture ${Number(index) + 1}`}));
        }
        return block;
      });
      return template.innerHTML;
    }
    // back to what the archive stores: paragraphs as HTML, picture blocks as <figure data-media>, nothing pasted along
    function storyToContent() {
      const copy = $('story').cloneNode(true);
      for (const block of copy.querySelectorAll('.pics')) { const figure = document.createElement('figure'); figure.dataset.media = block.dataset.media; block.replaceWith(figure); }
      tidy(copy);
      return copy.innerHTML.replace(/<figure data-media="([^"]*)"><\/figure>/g, '\n\n<figure data-media="$1"></figure>\n\n').replace(/<\/p>/g, '</p>\n\n').replace(/\n{3,}/g, '\n\n').trim();
    }
    let storyPictures = 0;
    function renderStory() {
      const {project} = current();
      const record = projectRecord(project);
      // a field Ryan is typing in keeps his caret, also when a copy from his account arrives meanwhile
      if (document.activeElement !== $('story')) $('story').innerHTML = storyHtml(project, record.content !== undefined ? record.content : project.content);
      storyPictures = (String(project.content).match(/<figure data-media=/g) ?? []).length;
      $('story-reset').hidden = record.content === undefined;
    }
    try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch {}
    $('story').addEventListener('input', () => {
      const {project} = current();
      state.projects[project.id] = {...state.projects[project.id], content: storyToContent()};
      $('story-reset').hidden = false;
      save();
      const left = $('story').querySelectorAll('.pics').length;
      $('note').textContent = left < storyPictures ? 'A picture block left the text. “Undo my changes to the text” brings it back.' : '';
    });
    $('story-reset').addEventListener('click', () => {
      const {project} = current();
      const record = {...state.projects[project.id]};
      delete record.content;
      state.projects[project.id] = record;
      save();
      renderStory();
    });

    function wpRows(containerId, rows) {
      $(containerId).replaceChildren(...rows.flatMap(({label, value, use}) => {
        const text = Array.isArray(value) ? value.join(', ') : value;
        const button = use && text ? el('button', {type: 'button', className: 'link', textContent: 'use this'}) : el('span');
        if (use && text) button.addEventListener('click', use);
        return [el('dt', {textContent: label}), el('dd', {textContent: text || '—'}), button];
      }));
    }
    function renderProject() {
      const {project} = current();
      const summary = summaryOf(project);
      if (document.activeElement !== $('summary')) $('summary').value = summary;
      $('summary-hint').textContent = summary
        ? 'Shown on the wall and under the title on the page.'
        : (project.excerpt ? `Without one, the wall shows WordPress's excerpt: “${project.excerpt.slice(0, 140)}${project.excerpt.length > 140 ? '…' : ''}”` : 'Shown on the wall and under the title on the page.');
      renderProjectWords();
      renderStory();
      wpRows('wp-project', [
        {label: 'Categories', value: project.wordpress.categories, use: () => setProjectTags([...projectTags(project), ...project.wordpress.categories.filter((w) => !projectTags(project).some((x) => same(x, w)))])},
        {label: 'Tags', value: project.wordpress.tags, use: () => setProjectTags([...projectTags(project), ...project.wordpress.tags.filter((w) => !projectTags(project).some((x) => same(x, w)))])},
        {label: 'Excerpt', value: project.wordpress.excerpt, use: () => { $('summary').value = project.wordpress.excerpt; $('summary').dispatchEvent(new Event('input')); }},
      ]);
      const done = isDone(project);
      $('done').textContent = done ? 'Next project →' : 'Done, next project →';
      $('reopen').hidden = !done;
    }
    $('summary').addEventListener('input', () => {
      const {project} = current();
      setProject(project, 'summary', $('summary').value.trim(), project.summary);
      $('summary-hint').textContent = 'Shown on the wall and under the title on the page.';
    });

    // ---------- the Picture tab ----------
    function renderImageWords() {
      const {project, image} = current();
      const words = imageTags(project, image);
      renderChips('image-chips', words, {
        inherited: projectTags(project),
        placeholder: 'Add a keyword for this picture',
        onRemove: (word) => setImageTags(imageTags(project, image).filter((w) => !same(w, word)), project, image),
        onAdd: (word, options) => {
          const now = imageTags(project, image);
          setImageTags([...now, ...tags(word).filter((w) => !now.some((x) => same(x, w)))], project, image, options);
        },
      });
      $('image-ideas').replaceChildren(...image.suggestions.map((w) => ideaButton(w, words.some((x) => same(x, w)), () => setImageTags(toggled(imageTags(current().project, current().image), w)))));
    }
    function renderPicture() {
      const {image} = current();
      if (document.activeElement !== $('description')) $('description').value = descriptionOf(image);
      renderImageWords();
      renderCredit();
      wpRows('wp-picture', [
        {label: 'File', value: image.wordpress.file},
        {label: 'Title', value: image.wordpress.title, use: () => useDescription(image.wordpress.title)},
        {label: 'Caption', value: image.wordpress.caption, use: () => useDescription(image.wordpress.caption)},
        {label: 'Alt', value: image.wordpress.alt, use: () => useDescription(image.wordpress.alt)},
      ]);
    }
    function useDescription(text) { $('description').value = text; $('description').dispatchEvent(new Event('input')); }
    $('description').addEventListener('input', () => {
      const {image} = current();
      setImage(image, 'description', $('description').value.trim(), image.description || image.existingDescription || image.alt || '');
    });

    // photographer credits: one for the picture, or one for the whole project
    const ARCHIVE_CREDITS = JSON.parse(document.querySelector('#credit-data').textContent);
    const isModelling = (project) => project.id.startsWith('vaguelyvulgar/');
    const creditFor = (project, image) => [recordFor(image).credit, projectRecord(project).credit, ARCHIVE_CREDITS[image.key]].find((credit) => credit?.name?.trim());
    const isWebAddress = (value) => { try { return ['http:', 'https:'].includes(new URL(value).protocol); } catch { return false; } };
    const uncredited = () => flat.filter(({project, image}) => isModelling(project) && !creditFor(project, image));
    function renderCredit() {
      const {project, image} = current();
      const own = recordFor(image).credit ?? {};
      const shared = projectRecord(project).credit ?? {};
      const fill = (id, value) => { if (document.activeElement !== $(id)) $(id).value = value; };
      fill('credit-image-name', own.name ?? '');
      fill('credit-image-url', own.url ?? '');
      fill('credit-project-name', shared.name ?? '');
      fill('credit-project-url', shared.url ?? '');
      $('credit-image-name').placeholder = ARCHIVE_CREDITS[image.key]?.name || shared.name || 'Name as it should appear';
      $('credit-panel').open = isModelling(project) || Boolean(creditFor(project, image));
      refreshCredit();
    }
    function refreshCredit() {
      const {project, image} = current();
      const credit = creditFor(project, image);
      const all = flat.filter(({project: p}) => isModelling(p)).length;
      const open = uncredited().length;
      $('credit-summary').textContent = credit ? `Photographer: ${credit.name.trim()}` : (isModelling(project) ? `Photographer · ${open} of ${all} modelling pictures still open` : 'Photographer');
      const site = credit?.url?.trim() ?? '';
      $('credit-shown').textContent = credit ? `Caption on the site: Photo: ${credit.name.trim()}${site && isWebAddress(site) ? `, linked to ${site}` : ''}` : 'No photographer for this picture yet.';
      if (['credit-project-url', 'credit-image-url'].some((id) => $(id).value.trim() && !isWebAddress($(id).value.trim()))) $('credit-shown').textContent += ' A site needs to start with https://.';
      $('next-uncredited').hidden = !isModelling(project) || !open;
    }
    $('credit-panel').addEventListener('input', (event) => {
      const {project, image} = current();
      const scope = event.target.id.startsWith('credit-project') ? 'project' : 'image';
      const credit = {name: $(`credit-${scope}-name`).value.trim(), url: $(`credit-${scope}-url`).value.trim()};
      if (scope === 'project') state.projects[project.id] = {...state.projects[project.id], credit};
      else state.images[image.key] = {...recordFor(image), credit};
      save();
      refreshCredit();
    });
    $('credit-panel').addEventListener('keydown', (event) => { if (event.key === 'Enter' && event.target.tagName === 'INPUT') event.preventDefault(); });
    $('next-uncredited').addEventListener('click', () => {
      const todo = new Set(uncredited().map(({image}) => image.key));
      const after = flat.findIndex((item, index) => index > state.cursor && todo.has(item.image.key));
      const next = after >= 0 ? after : flat.findIndex((item) => todo.has(item.image.key));
      if (next < 0) return;
      state.cursor = next;
      render();
      $('credit-image-name').focus({preventScroll: true});
    });

    // ---------- the Preview tab: the wall's tile and lead row, and the page's top ----------
    function renderPreview() {
      if (tab !== 'preview') return;
      const {project} = current();
      const lead = project.images.find((image) => image.url === heroOf(project)) ?? project.images[0];
      const summary = summaryOf(project) || project.excerpt;
      const ratio = lead.width && lead.height ? lead.width / lead.height : 4 / 3;
      const kicker = [project.kinds[0], project.year].filter(Boolean).join(' · ');
      const tile = el('div', {className: 'tile'}, el('img', {src: lead.src, alt: ''}), el('span', {className: 'cap'}, el('span', {className: 't', textContent: project.title}), el('span', {className: 'm', textContent: project.label})));
      tile.style.aspectRatio = String(ratio);
      const leadPic = el('div', {className: 'lead-pic'}, el('img', {src: lead.src, alt: ''}));
      leadPic.style.aspectRatio = String(ratio);
      $('preview-wall').replaceChildren(
        el('span', {className: 'hint', textContent: 'As a tile'}), tile,
        el('span', {className: 'hint', textContent: 'As a lead row (when you pick it as one of the year’s two leads)'}),
        el('article', {className: 'lead-row'}, leadPic, el('div', {className: 'lead-text'},
          el('span', {className: 'kicker', textContent: kicker}),
          el('h4', {className: 'title', textContent: project.title}),
          el('span', {className: 'line', textContent: project.label}),
          summary ? el('p', {className: 'desc', textContent: summary}) : el('p', {className: 'desc empty-note', textContent: 'No summary yet.'}),
          el('span', {className: 'go', textContent: 'The project page →'}))),
        el('span', {className: 'hint', textContent: 'In the panel that opens on a click'}),
        el('div', {className: 'panel-lines'}, el('strong', {textContent: project.title}), el('span', {textContent: [project.label, project.year, project.kinds[0]].filter(Boolean).join(' · ')}), summary ? el('span', {textContent: summary}) : null),
      );
      const credit = creditFor(project, lead);
      const caption = [lead.wordpress.caption, credit ? `Photo: ${credit.name.trim()}` : ''].filter(Boolean).join(' · ');
      const own = summaryOf(project);
      $('preview-page').replaceChildren(
        el('span', {className: 'crumb', textContent: `Portfolio / ${project.portfolio}`}),
        el('span', {className: 'when', textContent: [project.dateLabel, project.kinds.join(', ')].filter(Boolean).join(' • ')}),
        el('h4', {textContent: project.title}),
        own ? el('p', {className: 'sum', textContent: own}) : el('p', {className: 'sum empty-note', textContent: 'The page shows your summary here once you write one.'}),
        el('figure', {}, el('img', {src: lead.src, alt: descriptionOf(lead)}), caption ? el('figcaption', {textContent: caption}) : null),
      );
    }

    // ---------- the stage and moving around ----------
    function renderStage() {
      const {project, projectIndex, image, imageIndex} = current();
      $('picture').src = image.src;
      $('picture').srcset = image.srcset;
      $('picture').alt = descriptionOf(image) || `${project.title}, picture ${imageIndex + 1}`;
      $('image-counter').textContent = `Picture ${imageIndex + 1} of ${project.images.length}`;
      const lead = image.url === heroOf(project);
      $('make-hero').setAttribute('aria-pressed', String(lead));
      $('make-hero').textContent = lead ? '★ The lead picture' : '☆ Make this the lead picture';
      $('project-link').href = project.href;
      const start = flat.findIndex((item) => item.projectIndex === projectIndex);
      $('filmstrip').replaceChildren(...project.images.map((img, index) => {
        const button = el('button', {type: 'button'}, el('img', {src: img.src, alt: '', loading: 'lazy'}));
        const isLead = img.url === heroOf(project);
        button.dataset.lead = String(isLead);
        button.setAttribute('aria-label', `Picture ${index + 1} of ${project.images.length}${isLead ? ', the lead picture' : ''}`);
        button.setAttribute('aria-current', String(index === imageIndex));
        button.addEventListener('click', () => { state.cursor = start + index; render({keepTab: true}); });
        return button;
      }));
      requestAnimationFrame(() => $('filmstrip').querySelector('[aria-current="true"]')?.scrollIntoView({block: 'nearest', inline: 'center'}));
    }
    function updateProgress() {
      const done = completed();
      $('progress-label').textContent = `${done} of ${DATA.projects.length} projects done`;
      $('bar').style.width = `${(done / DATA.projects.length) * 100}%`;
      const {project} = current();
      $('project-state').textContent = isDone(project) ? 'Done' : 'Not done yet';
      $('project-state').dataset.done = String(isDone(project));
      document.title = `${done}/${DATA.projects.length} · ${project.title} — Portfolio desk`;
    }
    function render({keepTab = true} = {}) {
      fillPicker();
      const article = openArticleRecord();
      $('article-bench').hidden = !article;
      $('project-bench').hidden = Boolean(article);
      if (article) {
        updateProgress();
        renderArticleMode();
        return;
      }
      const {project, projectIndex} = current();
      $('portfolio').textContent = project.portfolio;
      $('project-title').textContent = project.title;
      $('project-when').textContent = [project.dateLabel, project.kinds.join(', ')].filter(Boolean).join(' · ');
      $('project-picker').value = String(projectIndex);
      renderStage();
      renderProject();
      renderPicture();
      updateProgress();
      if (keepTab) showTab(tab);
    }
    function goProject(delta) {
      // from an article, the arrows go back to the project you were on
      if (openArticleRecord()) return leaveArticle();
      const {projectIndex} = current();
      const next = (projectIndex + delta + DATA.projects.length) % DATA.projects.length;
      state.cursor = flat.findIndex((item) => item.projectIndex === next);
      save();
      $('note').textContent = '';
      render();
    }
    function markDone() {
      const {project} = current();
      if (!isDone(project)) {
        state.projects[project.id] = {...state.projects[project.id], reviewed: true};
        state.session = (state.session ?? 0) + 1;
        save();
      }
      goProject(1);
      $('note').textContent = `${project.title} is done.`;
    }
    $('done').addEventListener('click', markDone);
    // reopening is work too: `reopenedAt` makes the record count as changed, so it is stamped and wins merges
    $('reopen').addEventListener('click', () => { const {project} = current(); state.projects[project.id] = {...state.projects[project.id], reviewed: false, reopenedAt: Date.now()}; save(); render(); });
    $('previous').addEventListener('click', () => goProject(-1));
    $('next-project').addEventListener('click', () => goProject(1));
    $('project-picker').addEventListener('change', (event) => {
      const value = event.target.value;
      if (value.startsWith('article:')) return openArticle(value.slice('article:'.length));
      state.article = null;
      state.cursor = flat.findIndex(({projectIndex}) => projectIndex === Number(value));
      save();
      render();
    });
    $('make-hero').addEventListener('click', () => {
      const {project, image} = current();
      state.projects[project.id] = {...state.projects[project.id], hero: image.url};
      save();
      render();
      $('note').textContent = 'Lead picture chosen: it heads the page, the card and the wall.';
    });
    addEventListener('keydown', (event) => {
      // not while a dialog or the overview is open: the desk behind it is out of sight
      if (document.querySelector('dialog[open]') || $('overview')?.hidden === false) return;
      if ((event.ctrlKey || event.metaKey) && event.key === 'Enter' && !openArticleRecord()) { event.preventDefault(); markDone(); }
      if (event.altKey && event.key === 'ArrowLeft') { event.preventDefault(); goProject(-1); }
      if (event.altKey && event.key === 'ArrowRight') { event.preventDefault(); goProject(1); }
    });

    // ---------- keyword map ----------
    function keywordRows() {
      const map = new Map();
      const add = (word, projectId) => {
        const entry = map.get(word.toLowerCase()) ?? {word, projects: new Set()};
        entry.projects.add(projectId);
        map.set(word.toLowerCase(), entry);
      };
      for (const project of DATA.projects) for (const word of projectTags(project)) add(word, project.id);
      return [...map.values()].sort((a, b) => b.projects.size - a.projects.size || a.word.localeCompare(b.word));
    }
    function renderMap() {
      const query = $('map-filter').value.trim().toLowerCase();
      $('map-list').replaceChildren(...keywordRows().filter(({word}) => word.toLowerCase().includes(query)).map(({word, projects}) => {
        const add = el('button', {type: 'button', textContent: '+ this project', title: `Add “${word}” to this project`});
        add.addEventListener('click', () => { setProjectTags([...projectTags(current().project).filter((w) => !same(w, word)), word]); renderMap(); });
        return el('div', {className: 'keyword-row'}, el('div', {}, el('strong', {textContent: word}), el('small', {textContent: `${projects.size} project${projects.size === 1 ? '' : 's'}`})), add);
      }));
    }
    $('map').addEventListener('click', () => { renderMap(); $('keyword-map').showModal(); $('map-filter').focus(); });
    $('map-filter').addEventListener('input', renderMap);
    $('close-map').addEventListener('click', () => $('keyword-map').close());
    $('help').addEventListener('click', () => $('keys').showModal());

    // ---------- send to site: a pull request with your changes and a preview; it goes live when you merge it ----------
    const SENT = {
      sent: {title: 'Sent', text: 'Your changes are on their way as a pull request with a preview, in about five minutes. Look at the preview, then merge it: that puts them live.', link: 'Your desk pull requests'},
      manual: {title: 'Send from GitHub', text: 'This address cannot send by itself. On the page below, click "Run workflow": it reads the desk in your account and opens a pull request with a preview.', link: 'The Send to site workflow'},
      signin: {title: 'Sign in first', text: 'Sending reads the desk saved in your account. Sign in (next to the save status), then send again.'},
      unsaved: {title: 'Not saved to your account yet', text: 'Sending reads the desk saved in your account, and the newest work is not there yet.'},
      failed: {title: 'Not sent', text: 'Something went wrong. The workflow page below can send it by hand.', link: 'The Send to site workflow'},
    };
    $('send').addEventListener('click', async () => {
      $('send').disabled = true;
      $('send').textContent = 'Sending…';
      let result;
      try { result = window.deskSync ? await window.deskSync.send() : {kind: 'failed', message: 'the desk is still starting'}; }
      catch (error) { result = {kind: 'failed', message: error.message}; }
      $('send').disabled = false;
      $('send').textContent = 'Send to site';
      const copy = SENT[result.kind];
      $('sent-title').textContent = copy.title;
      $('sent-text').textContent = copy.text + (result.line ? ` (${result.line})` : '') + (result.message ? ` (${result.message})` : '');
      $('sent-link').hidden = !copy.link;
      $('sent-link').textContent = copy.link ?? '';
      $('sent-link').href = result.prs ?? result.url ?? '#';
      $('sent').showModal();
    });
    $('close-sent').addEventListener('click', () => $('sent').close());
    $('close-keys').addEventListener('click', () => $('keys').close());

    // ---------- a copy as a file, and loading one (kept for safety; the desk saves by itself) ----------
    $('export').addEventListener('click', () => {
      const images = Object.fromEntries(flat.map(({project, image}) => {
        const projectKeywords = projectTags(project);
        const imageKeywords = imageTags(project, image);
        const entry = {projectId: project.id, url: image.url, description: descriptionOf(image), projectKeywords, imageKeywords, keywords: tags([...projectKeywords, ...imageKeywords].join(', ')), reviewed: isDone(project)};
        const credit = recordFor(image).credit;
        if (credit) entry.credit = {name: credit.name ?? '', url: credit.url ?? ''};
        return [image.key, entry];
      }));
      const output = {version: 4, exportedAt: new Date().toISOString(), projects: state.projects, images, articles: state.articles};
      const link = el('a', {href: URL.createObjectURL(new Blob([JSON.stringify(output, null, 2) + '\n'], {type: 'application/json'})), download: 'reddy-world-image-metadata.json'});
      link.click();
      URL.revokeObjectURL(link.href);
    });
    $('load').addEventListener('click', () => $('load-file').click());
    $('load-file').addEventListener('change', async (event) => {
      const file = event.target.files?.[0];
      event.target.value = '';
      if (!file) return;
      try {
        const loaded = JSON.parse(await file.text());
        if (!window.deskSync) throw new Error('the desk is still starting, try again in a moment');
        const opened = window.deskSync.load(state, loaded);
        state.cursor = Math.max(0, firstIncomplete());
        save();
        render();
        $('note').textContent = `Loaded ${opened.length} projects from ${file.name}.`;
      } catch (error) {
        $('note').textContent = `Could not load ${file.name}: ${error.message}.`;
      }
    });

    // ---------- articles: new pieces for the wall, kept as private drafts until Ryan publishes them ----------
    // Ryan, 2026-10-26: "would be great to park them as "drafts" until publication right?" They are part of the
    // desk's state, so they save to his account like the rest (desk-store.js merges them entry by entry).
    // "Send to site" reads projects and pictures only, so a draft never reaches the site. Deleting leaves a
    // stamped {deleted: true}, so a copy on another device can't bring the article back.
    state.articles ??= {};
    function drafts() {
      return Object.entries(state.articles).filter(([, article]) => article && !article.deleted)
        .sort(([, a], [, b]) => (b.created ?? 0) - (a.created ?? 0));
    }
    function openArticleRecord() {
      const article = state.article ? state.articles?.[state.article] : null;
      return article && !article.deleted ? article : null;
    }
    const articleTitle = (article) => String(article?.title ?? '').trim() || 'Untitled article';
    function fillPicker() {
      const groups = [];
      const own = drafts();
      if (own.length) groups.push(el('optgroup', {label: 'Your articles (drafts)'}, ...own.map(([id, article]) => new Option(`${articleTitle(article)} · draft`, `article:${id}`))));
      groups.push(el('optgroup', {label: 'Projects'}, ...DATA.projects.map((project, index) => new Option(`${project.title} · ${project.portfolio}`, String(index)))));
      $('project-picker').replaceChildren(...groups);
    }
    // an article's text as its page will show it: the tags the post text keeps, links only to web or site addresses
    // (the same tidy() as the post text: a pasted div becomes a paragraph, pasted pictures and styles go)
    function cleanHtml(html) {
      const template = document.createElement('template');
      template.innerHTML = String(html ?? '');
      tidy(template.content);
      return template.innerHTML;
    }
    const started = (article) => new Date(article.created ?? Date.now()).toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'});
    function renderReading() {
      const article = openArticleRecord();
      if (!article) return;
      const text = el('div', {className: 'reading-text'});
      text.innerHTML = cleanHtml(article.content);
      const summary = String(article.summary ?? '').trim();
      $('reading').replaceChildren(
        el('span', {className: 'when', textContent: `Draft · started ${started(article)}`}),
        el('h2', {className: 'reading-title', textContent: articleTitle(article)}),
        summary ? el('p', {className: 'sum', textContent: summary}) : el('p', {className: 'sum empty-note', textContent: 'No summary yet.'}),
        text,
      );
      $('article-heading').textContent = articleTitle(article);
      $('article-when').textContent = `Started ${started(article)}`;
      document.title = `${articleTitle(article)} (draft) — Portfolio desk`;
    }
    function renderArticleMode() {
      const article = openArticleRecord();
      // a field Ryan is typing in keeps his caret: only the others are filled again
      if (document.activeElement !== $('article-title')) $('article-title').value = article.title ?? '';
      if (document.activeElement !== $('article-summary')) $('article-summary').value = article.summary ?? '';
      // an empty text starts with one paragraph, so the first line typed is a paragraph too
      if (document.activeElement !== $('article-text')) $('article-text').innerHTML = cleanHtml(article.content) || '<p><br></p>';
      $('project-picker').value = `article:${state.article}`;
      resetDelete();
      renderReading();
    }
    function setArticle(field, value) {
      state.articles[state.article] = {...state.articles[state.article], [field]: value};
      save();
      renderReading();
    }
    $('article-title').addEventListener('input', () => {
      setArticle('title', $('article-title').value);
      fillPicker();
      $('project-picker').value = `article:${state.article}`;
    });
    $('article-summary').addEventListener('input', () => setArticle('summary', $('article-summary').value));
    // stored cleaned, so a pasted page or picture never fills the account copy
    $('article-text').addEventListener('input', () => setArticle('content', cleanHtml($('article-text').innerHTML)));
    function newArticle() {
      const id = `a${Date.now().toString(36)}`;
      state.articles[id] = {title: '', summary: '', content: '', status: 'draft', created: Date.now()};
      state.article = id;
      save();
      render();
      $('article-note').textContent = '';
      $('article-title').focus();
    }
    function openArticle(id) {
      if (!state.articles[id] || state.articles[id].deleted) return;
      state.article = id;
      save();
      render();
    }
    function leaveArticle() {
      state.article = null;
      save();
      render();
    }
    $('new-article').addEventListener('click', newArticle);
    $('back-to-projects').addEventListener('click', leaveArticle);
    let deleteTimer = 0;
    function resetDelete() {
      clearTimeout(deleteTimer);
      $('delete-article').textContent = 'Delete this draft';
      delete $('delete-article').dataset.armed;
    }
    // two clicks, no pop-up: the first one asks, the second deletes
    $('delete-article').addEventListener('click', () => {
      if (!$('delete-article').dataset.armed) {
        $('delete-article').dataset.armed = 'yes';
        $('delete-article').textContent = 'Click again to delete it for good';
        deleteTimer = setTimeout(resetDelete, 5000);
        return;
      }
      const title = articleTitle(openArticleRecord());
      state.articles[state.article] = {deleted: true, created: state.articles[state.article].created};
      state.article = null;
      save();
      render();
      $('note').textContent = `“${title}” deleted.`;
    });
    Object.assign(window.imageDesk, {newArticle, openArticle});

    render();
  </script>
  <section id="overview" class="overview" hidden aria-labelledby="ov-title">
    <div class="ov-wrap">
      <header class="ov-head"><h2 id="ov-title">Where you are</h2><button id="ov-close" type="button">Back to the desk</button></header>
      <button id="ov-next" class="primary ov-next" type="button">Next up</button>
      <p class="ov-big" id="ov-total"></p>
      <div id="ov-total-bar"></div>
      <p class="ov-line" id="ov-legend"></p>
      <p class="ov-line"><span data-desk-saved></span> <button data-desk-signin type="button" hidden>Sign in</button></p>
