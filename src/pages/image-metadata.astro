          el('h4', {className: 'title', textContent: title}),
          el('span', {className: 'line', textContent: kind}),
          wallText ? el('p', {className: 'desc', textContent: wallText}) : el('p', {className: 'desc empty-note', textContent: 'No summary yet.'}),
          el('span', {className: 'go', textContent: 'The project page →'})));
      const card = el('div', {className: 'linkcard'}, lead ? el('div', {className: 'pic'}, photoImg(lead, '')) : null,
        el('div', {className: 'words'}, el('span', {className: 'site', textContent: 'reddy.world'}), el('strong', {textContent: pageTitle}),
          description ? el('span', {className: 'd', textContent: description}) : null));
      const serp = el('div', {className: 'serp'}, el('span', {className: 'u', textContent: address}),
        el('span', {className: 't', textContent: cutAt(pageTitle, 60)}),
        el('span', {className: 'd', textContent: description || 'No description yet: it needs 50 characters of summary or text.'}));
      $('elsewhere').replaceChildren(
        el('div', {className: 'preview'}, el('h3', {textContent: 'On the wall'}),
          el('p', {className: 'hint', textContent: `In the row “${row}”, at the month you publish it. ${lead ? '' : 'With no lead picture the tile shows only its words.'}`.trim()}),
          el('div', {className: 'wall'}, el('span', {className: 'hint', textContent: 'As a tile'}), tile,
            el('span', {className: 'hint', textContent: 'As a lead row (when you pick it as one of the year’s two leads)'}), leadRow)),
        el('div', {className: 'preview'}, el('h3', {textContent: 'As a shared link'}),
          el('p', {className: 'hint', textContent: lead ? 'LinkedIn, WhatsApp and the like show this card. The lead picture is cut to 1200 × 628 when you send it.' : 'LinkedIn, WhatsApp and the like show this card. With a lead picture it gets a picture too.'}), card),
        el('div', {className: 'preview'}, el('h3', {textContent: 'In search results'}),
          pageTitle.length > 60 ? el('p', {className: 'hint', textContent: 'Search results cut titles after about 60 characters.'}) : null, serp),
      );
    }
    // ready to publish: a title, enough words for a search result (50 characters, from the summary and the text),
    // and for an interview the person
    function missingFor(article) {
      const missing = [];
      if (!String(article.title ?? '').trim()) missing.push('a title');
      if ((String(article.summary ?? '').trim() + ' ' + plainText(article.content)).trim().length < 50) missing.push('a few more words (50 characters)');
      if (kindOf(article) === 'interview' && !(article.person?.name?.trim() && article.person?.role?.trim() && String(article.byline ?? '').trim())) missing.push('the person: their name, role and the words before their name');
      if (shownPictures(article).some((id) => !String(article.pictures?.[id]?.alt ?? '').trim())) missing.push('what every picture shows (for someone who can\'t see it)');
      return missing;
    }
    function renderPublish() {
      const article = openArticleRecord();
      if (!article) return;
      const ready = article.status === 'ready';
      const missing = missingFor(article);
      $('article-state').textContent = ready ? 'Ready for the site' : 'Draft: only you see it';
      $('article-state').dataset.ready = String(ready);
      $('publish-article').hidden = ready;
      $('unpublish-article').hidden = !ready;
      $('publish-article').disabled = missing.length > 0;
      $('publish-hint').textContent = ready
        ? 'Included in your next publish. Publish changes runs the checks and puts it live automatically. Back to draft removes it from the next published version.'
        : missing.length ? `A draft, only in your account. To publish it needs ${missing.join(', ')}.` : 'A draft, only in your account, until you publish it.';
      const slug = slugOf(article);
      $('article-address').textContent = slug ? `Its address: reddy.world/portfolio/${kinds[kindOf(article)]?.path ?? 'stories'}/${slug}/` : '';
      $('article-person').hidden = kindOf(article) !== 'interview';
      refreshBoxes('article');
    }
    // what each box of an article holds
    const LANGUAGES = {en: 'English', nl: 'Nederlands'};
    boxSpecs.article = (name) => {
      const article = openArticleRecord();
      if (!article) return null;
      const said = (value) => String(value ?? '').replace(/\s+/g, ' ').trim();
      const mark = (ok, empty = 'todo') => (ok ? 'done' : empty);
      switch (name) {
        case 'title': return [mark(said(article.title)), said(article.title) || 'No title yet'];
        case 'about': return ['done', [kinds[kindOf(article)]?.label ?? 'Story', LANGUAGES[article.lang ?? 'en'] ?? article.lang, article.year ?? new Date(article.created ?? Date.now()).getFullYear()].join(' · ')];
        case 'person': {
          const person = article.person ?? {};
          const line = said(person.name) ? `${said(article.byline)} ${said(person.name)}${said(person.role) ? `, ${said(person.role)}` : ''}`.trim() : 'Name, role and the words before the name';
          return [mark(said(person.name) && said(person.role) && said(article.byline)), line];
        }
        case 'related': { const study = (DATA.software ?? []).find((item) => item.id === article.related); return [mark(study, 'quiet'), study?.title ?? 'None']; }
        case 'summary': return [mark(said(article.summary)), said(article.summary) || 'Not written yet'];
        case 'text': { const n = wordCount(article.content); return [mark(n), n ? `${n} words` : 'Not written yet']; }
        case 'pictures': {
          const pictures = livePictures(article);
          const open = pictures.filter(([, picture]) => !pictureHandled(picture)).length;
          if (!pictures.length) return ['quiet', 'None yet'];
          return [mark(!open), `${pictures.length} picture${pictures.length === 1 ? '' : 's'}${open ? ` · ${open} to finish` : ''}`];
        }
        case 'publish': {
          if (article.status === 'ready') return ['done', 'Ready for the site'];
          const missing = missingFor(article);
          return ['todo', missing.length ? `Draft · needs ${missing.length === 1 ? missing[0] : `${missing.length} things`}` : 'Draft · ready to publish'];
        }
        default: return null;
      }
    };
    function setPerson(field, value) {
      if (!openArticleRecord()) return;
      const article = state.articles[state.article];
      state.articles[state.article] = {...article, person: {...article.person, [field]: value}};
      save();
      renderReading();
      renderPublish();
    }
    $('article-kind').addEventListener('change', () => {
      setArticle('kind', $('article-kind').value);
      renderPublish();
      // an interview: the person is the next thing to fill in
      if (!$('article-person').hidden && $('article-person').dataset.state === 'todo') $('article-person').open = true;
    });
    $('article-lang').addEventListener('change', () => setArticle('lang', $('article-lang').value));
    $('article-year').addEventListener('input', () => setArticle('year', Number($('article-year').value) || undefined));
    $('article-byline').addEventListener('input', () => { setArticle('byline', $('article-byline').value); renderPublish(); });
    $('article-related').addEventListener('change', () => setArticle('related', $('article-related').value || undefined));
    for (const [id, field] of [['person-name', 'name'], ['person-role', 'role'], ['person-org', 'org'], ['person-org-url', 'orgUrl'], ['person-profile', 'profile']]) {
      $(id).addEventListener('input', () => setPerson(field, $(id).value));
    }
    $('publish-article').addEventListener('click', () => {
      const article = state.articles[state.article];
      if (missingFor(article).length) return;
      // the address and the day it was first published stay as they are from now on
      state.articles[state.article] = {...article, status: 'ready', slug: slugOf(article), readyAt: article.readyAt ?? Date.now()};
      save();
      renderPublish();
      $('article-note').textContent = 'Included in your next publish. Use Publish changes when you are ready to put it live.';
    });
    $('unpublish-article').addEventListener('click', () => {
      state.articles[state.article] = {...state.articles[state.article], status: 'draft'};
      save();
      renderPublish();
      $('article-note').textContent = 'Back to draft: your next publish takes it off the site if it was there.';
    });
    function renderArticleMode() {
      const article = openArticleRecord();
      const fill = (id, value) => { if (document.activeElement !== $(id)) $(id).value = value ?? ''; };
      $('article-kind').value = kindOf(article);
      $('article-lang').value = article.lang ?? 'en';
      fill('article-year', article.year ?? new Date(article.created ?? Date.now()).getFullYear());
      fill('article-byline', article.byline);
      fill('person-name', article.person?.name);
      fill('person-role', article.person?.role);
      fill('person-org', article.person?.org);
      fill('person-org-url', article.person?.orgUrl);
      fill('person-profile', article.person?.profile);
      $('article-related').value = article.related ?? '';
      renderPublish();
      // a field Ryan is typing in keeps his caret: only the others are filled again
      if (document.activeElement !== $('article-title')) $('article-title').value = article.title ?? '';
      if (document.activeElement !== $('article-summary')) $('article-summary').value = article.summary ?? '';
      $('page-note').textContent = '';
      renderPictureList();
      $('project-picker').value = `article:${state.article}`;
      resetDelete();
      renderReading();
      refreshBoxes('article', state.article);
    }
    // with no article open (a box of the article's panel changed from a project's page) nothing is written
    function setArticle(field, value) {
      if (!openArticleRecord()) return;
      state.articles[state.article] = {...state.articles[state.article], [field]: value};
      save();
      renderReading();
      renderPublish();
    }
    $('article-title').addEventListener('input', () => {
      setArticle('title', $('article-title').value);
      fillPicker();
      $('project-picker').value = `article:${state.article}`;
    });
    $('article-summary').addEventListener('input', () => setArticle('summary', $('article-summary').value));
    function newArticle() {
      const id = `a${Date.now().toString(36)}`;
      state.articles[id] = {title: '', summary: '', content: '', status: 'draft', kind: 'story', lang: 'en', year: new Date().getFullYear(), created: Date.now()};
      state.article = id;
      save();
      render();
      $('article-note').textContent = '';
      ($('piece-title') ?? $('article-title')).focus();
    }
    function openArticle(id) {
      if (!state.articles[id] || state.articles[id].deleted) return;
      state.article = id;
      save();
      render();
    }
    function leaveArticle() {
      state.article = null;
      save();
      render();
    }
    $('new-article').addEventListener('click', newArticle);
    $('new-article-tools').addEventListener('click',newArticle);
    $('wall-new').addEventListener('click',()=>{$('wall-organiser').hidden=true;newArticle();});
    $('back-to-projects').addEventListener('click', leaveArticle);
    let deleteTimer = 0;
    function resetDelete() {
      clearTimeout(deleteTimer);
      $('delete-article').textContent = 'Delete this draft';
      delete $('delete-article').dataset.armed;
    }
    // two clicks, no pop-up: the first one asks, the second deletes
    $('delete-article').addEventListener('click', () => {
      if (!$('delete-article').dataset.armed) {
        $('delete-article').dataset.armed = 'yes';
        $('delete-article').textContent = 'Click again to delete it for good';
        deleteTimer = setTimeout(resetDelete, 5000);
        return;
      }
      const title = articleTitle(openArticleRecord());
      state.articles[state.article] = {deleted: true, created: state.articles[state.article].created};
      state.article = null;
      save();
      render();
      $('note').textContent = `“${title}” deleted.`;
    });
    Object.assign(window.imageDesk, {newArticle, openArticle, openVideoForm,videoSource:videoPreviewSource,
      piece: () => {
        const article = openArticleRecord();
        if (article) return {type: 'article', id: state.article, ...article, published: article.published || new Date(article.readyAt ?? article.created ?? Date.now()).toISOString().slice(0,10)};
        const {project} = current();
        const record = projectRecord(project);
        return {type: 'project', id: project.id, mode:tab==='picture'?'picture':tab==='preview'?'preview':'page', selectedPicture:current().image, wordpress:project.wordpress, ideas:project.ideas, pageLayout:record.pageLayout ?? project.pageLayout ?? 'cover',bannerVideo:record.bannerVideo ?? project.bannerVideo ?? '',bannerFocus:record.bannerFocus ?? project.bannerFocus ?? 'center', title: pick(record, 'title', project.title), summary: summaryOf(project), tags: projectTags(project).join(', '), published: pick(record, 'published', project.published), craft: record.craft ?? project.craft, images: project.images};
      },
      setPiece: (field, value) => {
        if (field === 'published' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
          const key = (openArticleRecord() ? `a-${state.article}` : `p-${current().project.id.split('/').slice(1).join('/')}`).toLowerCase().replace(/[^a-z0-9]+/g, '-');
          state.wall ??= {}; state.wall[key] = {...DATA.wall?.[key], ...state.wall[key], year: Number(value.slice(0,4))};
        }
        if (openArticleRecord()) setArticle(field, value);
        else {const {project} = current(); setProject(project, field, value, field === 'tags' ? project.keywords.join(', ') : project[field] ?? '');}
        render();
      },
      pieceMode: (mode) => {
        if (openArticleRecord()) {
          elsewhere = mode === 'preview'; renderReading(); showStage();
          if (mode === 'picture') {const box = $('pic-list').closest('details'); box.open = true; box.scrollIntoView({block: 'nearest'});}
        } else showTab(mode === 'page' ? 'project' : mode);
      },
      uploadPictures: () => {placeAdded=false;$('pic-input').click();},
      insertSelectedPicture: () => {
        const {project, image} = current();
        showTab('project'); renderReading();
        if (image.pictureId && editorOn()) {window.deskEditor.insert('picture',image.pictureId);return;}
        const media = Object.keys(project.thumbs).find(index => project.thumbs[index] === image.src);
        if (media === undefined) return;
        if (editorOn()) window.deskEditor.insert('media',media);
        else {$('read-text').append(mediaBlock(project, media)); saveProjectText();}
      },
    });

    render({restorePlace:true});
  </script>
  <section id="overview" class="overview" hidden aria-labelledby="ov-title">
    <div class="ov-wrap">
      <header class="ov-head"><h2 id="ov-title">All items</h2><button id="ov-close" type="button">Back to the desk</button></header>
      <div class="ov-find">
        <label>Search projects and articles<input id="ov-search" type="search" placeholder="Title, text or tag" autocomplete="off" /></label>
        <label>Type<select id="ov-type"><option value="all">All items</option><option value="article">Articles</option><option value="project">Projects</option></select></label>
        <label>Status<select id="ov-status"><option value="all">Any status</option><option value="draft">Draft</option><option value="ready">Ready to publish</option><option value="published">Published articles</option><option value="todo">Projects to review</option><option value="reviewed">Reviewed projects</option><option value="no-text">No body text</option></select></label>
        <button id="ov-new" class="primary" type="button">New item</button>
      </div>
      <p id="ov-results" class="ov-line" role="status"></p>
      <ul id="ov-items" class="ov-items"></ul>
      <details class="ov-progress"><summary>Project review progress</summary>
      <button id="ov-next" class="primary ov-next" type="button">Next up</button>
      <p class="ov-big" id="ov-total"></p>
      <div id="ov-total-bar"></div>
      <p class="ov-line" id="ov-legend"></p>
      <p class="ov-line"><span data-desk-saved></span> <button data-desk-signin type="button" hidden>Sign in</button></p>
      <p class="ov-line" id="ov-days"></p>
      <div id="ov-portfolios"></div>
      </details>
    </div>
  </section>
  <style is:global>
    .ov-find {display:flex;gap:.75rem;flex-wrap:wrap;align-items:end;margin:1rem 0;}
    .ov-find label {display:grid;gap:.3rem;min-width:0;}
    .ov-find label:first-child {flex:1 1 16rem;}
    .ov-find input,.ov-find select {width:100%;min-height:2.75rem;}
    .ov-items {list-style:none;padding:0;display:grid;gap:.4rem;}
    .ov-items .ov-row {width:100%;text-align:left;min-width:0;}
    .ov-items .ov-row strong {overflow-wrap:anywhere;}
    .ov-progress {margin-top:2rem;}
    .ov-progress > summary {cursor:pointer;padding:.75rem 0;}
  </style>
  <section id="piece-fields" hidden aria-label="Piece details">
    <div class="piece-modes" role="group" aria-label="What to work on"><button type="button" data-piece-mode="page" aria-pressed="true">Edit page</button><button type="button" data-piece-mode="picture" aria-pressed="false">Images</button><button type="button" data-piece-mode="preview" aria-pressed="false">Wall preview</button></div>
    <div class="piece-inputs">
      <label>Title<input id="piece-title" autocomplete="off"></label>
      <label>Summary<textarea id="piece-summary" rows="2"></textarea></label>
      <label>Tags<input id="piece-tags" autocomplete="off" placeholder="Add tags, separated by commas"></label>
      <p class="hint">Your tags describe the piece for search and organisation. Choose the type of work below.</p>
      <label>Type of work<select id="piece-craft"><option value="">Automatic</option></select></label>
      <label>Date shown on page<input id="piece-published" type="date" min="1900-01-01" max="2200-12-31"></label>
      <p class="hint">The date shown on its page and used to place it on the wall. Changing the date does not publish a draft.</p>
      <div class="piece-actions"><button id="piece-wall" type="button">Arrange on the wall</button><button id="piece-video" type="button">Add video</button><button id="piece-upload" type="button">Upload images</button><button id="piece-picture" type="button">Add to page</button></div>
      <div id="piece-selection" class="piece-selection"></div>
      <fieldset class="layout-choice"><legend>Opening layout</legend><div id="piece-layouts"></div><p class="hint" id="layout-description"></p></fieldset>
      <label>Banner content<select id="piece-banner-kind"><option value="image">Cover image</option><option value="video">Video</option></select></label>
      <label id="piece-banner-video-label" hidden>Banner video<input id="piece-banner-video" type="url" placeholder="YouTube or Vimeo link"></label>
      <label>Image crop<select id="piece-banner-focus"><option value="center">Centre</option><option value="top">Keep the top visible</option><option value="bottom">Keep the bottom visible</option></select></label>
      <p id="piece-fields-note" class="hint" role="status"></p>
    </div>
  </section>
  <style is:global>
    #piece-fields[hidden] {display:none;}
    #project-bench .tabs[hidden],#project-chips[hidden] {display:none;}
    #piece-fields {margin-bottom:1rem;}
    .piece-inputs {display:grid;gap:.65rem;margin:1rem 0;}
    .piece-inputs > label {display:grid;gap:.3rem;}
    .piece-inputs input,.piece-inputs textarea,.piece-inputs select {width:100%;max-width:100%;min-width:0;}
    .piece-modes,.piece-actions {display:flex;gap:.4rem;flex-wrap:wrap;}
    .piece-modes button[aria-pressed="true"] {background:var(--gold);color:var(--bg);}
  </style>
  <section id="wall-organiser" hidden role="dialog" aria-modal="true" aria-labelledby="wall-title">
    <header><h2 id="wall-title" tabindex="-1">Wall organiser</h2><button id="wall-new" type="button">New item</button><button id="close-wall" type="button">Back to the desk</button></header>
    <p>Arrange the wall without changing the pages. Row 0 is automatic; rows 1–99 stay together at every screen width. Publish changes prepares these changes for the site.</p>
    <div class="wall-tools"><label>Find a tile<input id="wall-search" type="search" placeholder="Title or kind"></label><label>Show<select id="wall-filter"><option value="all">All tiles</option><option value="shown">On the wall</option><option value="hidden">Off the wall</option></select></label><button id="wall-send" type="button" class="primary">Publish changes</button></div>
    <p data-desk-saved aria-live="polite">Saved in this browser</p><p id="wall-status" role="status"></p><p id="wall-catalog-status"></p><div id="wall-tiles"></div>
  </section>
  <style is:global>
    #wall-organiser {position: fixed; inset: 0; z-index: 12; overflow: auto; background: var(--bg); padding: clamp(1rem, 4vw, 3rem);}
    #wall-organiser[hidden] {display: none;}
    #wall-organiser header, .wall-tools, .wall-tile {display: flex; align-items: center; gap: .75rem; flex-wrap: wrap;}
    #wall-organiser header {justify-content: space-between;}
    #wall-organiser h2 {margin: 0;}
    .wall-tools {margin: 1.5rem 0;}
    .wall-tools label, .wall-tile label {display: grid; gap: .3rem; font-size: .8rem;}
    .wall-tools input, .wall-tools select, .wall-tile input {max-width: 100%; width: 8rem;}
    .wall-tools input {width: 16rem;}
    .wall-tile {border-top: 1px solid var(--line); padding: 1rem 0;}
    .wall-group {margin: 2rem 0 .5rem; font-size: 1rem; color: var(--muted);}
    .wall-tile .tile-name {flex: 1 1 16rem; min-width: 0; overflow-wrap: anywhere;}
    .wall-tile .tile-name strong, .wall-tile .tile-name small {display: block;}
    .wall-tile small {color: var(--muted); margin-top: .3rem;}
    .wall-tile[data-hidden="true"] .tile-name {opacity: .55;}
    .wall-tile input {width: 5rem;}
    .wall-tile button {min-height: 2.75rem;}
    .wall-tile .tile-moves {display: flex; gap: .4rem;}
    @media(max-width: 500px) {.wall-tools > label {flex: 1 1 100%;} .wall-tile .tile-name {flex-basis: 100%;}}
  </style>
  <script>import '../lib/desk-sync.js';</script>
  <script>import '../lib/desk-wall-ui.js';</script>
  <script>import '../lib/desk-piece.js';</script>
  <script>import '../lib/desk-editor.js';</script>
</body>
