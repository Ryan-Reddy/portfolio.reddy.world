---
import { deskProjects, ratingCandidates, WORD_BANK } from '../lib/desk-keywords.js';
import { ideasFor, normalize, stems, RISING } from '../lib/keyword-ratings.js';
import ratings from '../data/keyword-ratings.json';
import { archiveCredits } from '../lib/desk-credits.js';
import { getCollection } from 'astro:content';
import { KINDS } from '../lib/article-kinds.js';
import wall from '../data/wall.json';
import {AUTOMATIC_DESK_PUBLISHING} from '../lib/publishing-policy.js';
import {allPosts} from '../lib/portfolios.js';

// Every word idea in one list, each rated (scripts/keyword-ratings.mjs fetches the numbers at build time):
// per project the words and where they came from; each word's rating once, in `ratings`.
const deskList = deskProjects();
const vocabulary = new Set(deskList.flatMap((project) => ratingCandidates(project).flatMap(stems)));
const ideaRatings = {};
const bank = WORD_BANK.flatMap((list) => list.words);
const projects = deskList.map((project) => {
  const ideas = ideasFor([
    { source: 'yours', words: project.originalSuggestions },
    { source: 'search', words: project.searchSuggestions },
    { source: 'bank', words: bank },
  ], ratings, { vocabulary, relatedFrom: project.intent });
  for (const { sources, ...rating } of ideas) ideaRatings[normalize(rating.tag)] ??= rating;
  return { ...project, ideas: ideas.map((idea) => [idea.tag, idea.sources]) };
});
// an article's pictures: the same rated list, from the keywords Ryan gave his projects and the word bank
const articleIdeas = ideasFor([
  { source: 'yours', words: deskList.flatMap((project) => project.keywords) },
  { source: 'bank', words: bank },
], ratings, { vocabulary });
for (const { sources, ...rating } of articleIdeas) ideaRatings[normalize(rating.tag)] ??= rating;
const ratingsInfo = {updatedAt: ratings.updatedAt, bing: Object.keys(ratings.bing ?? {}).length > 0, rising: RISING};
const count = projects.reduce((sum, project) => sum + project.images.length, 0);
// what an article can be, and the case studies it can belong to (src/content/articles/, src/lib/article-kinds.js)
const software = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order).map(({ id, data }) => ({ id, title: data.title, branch: data.branch ?? 'software' }));
// drafts prepared in the repo, by desk id (src/data/article-seeds/<id>.json): each shows up once on the desk
const seeds = Object.fromEntries(Object.entries(import.meta.glob('../data/article-seeds/*.json', { eager: true, import: 'default' }))
  .map(([file, seed]) => [file.split('/').pop().replace(/\.json$/, ''), seed]));
const wallArticles = (await getCollection('articles')).map(({id, data,body}) => ({id, desk: data.desk, title: data.title, summary:data.summary ?? '', tags:data.tags ?? [], text:String(body ?? '').replace(/<[^>]*>/g,' '),href:`/portfolio/${KINDS[data.kind].path}/${id}/`, hasText:Boolean(String(body ?? '').replace(/<[^>]*>/g,' ').trim()),kind: KINDS[data.kind].label, year: (data.published ?? data.updated).getFullYear()}));
const wallProjects = allPosts.filter(p => p.type === 'post' && p.portfolio !== 'maup').map(p => ({id: `${p.portfolio}/${p.slug}`, slug: p.slug, title: p.title.trim(), published: p.published, year: new Date(p.published).getFullYear(), time: new Date(p.published).getTime()}));
const queue = JSON.stringify({ automaticDeskPublishing:AUTOMATIC_DESK_PUBLISHING, projects, count, ratingsInfo, ratings: ideaRatings, articleIdeas: articleIdeas.map((idea) => [idea.tag, idea.sources]), kinds: KINDS, software, seeds, wall, wallArticles, wallProjects }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Portfolio desk — reddy.world</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap">
  <style is:global>
    /* The desk: every kind opens on its page on the left, one tab at a time on the right (Project · Picture · Preview);
       a project's Picture tab shows one picture at a time on the left instead.
       Colours and type follow reddy.world (public/css/mainCSS.css there), so the previews look like the wall. */
    :root {
      color-scheme: dark;
      --bg: #0f0f0f; --surface: #1a1a1a; --raised: #222220; --fg: #f5f5f0; --muted: #a9a69f; --line: #3a3a37;
      --gold: #c7a86d; --gold-ink: #0f0f0f; --chip: #2b251a; --chip-ink: #e7cf9d;
      --display: 'Cormorant Garamond', Georgia, serif; --body: Inter, system-ui, sans-serif;
      font-family: var(--body); background: var(--bg); color: var(--fg);
    }
    * { box-sizing: border-box; }
    body { margin: 0; overflow: hidden; }
    button, input, textarea, select { font: inherit; color: inherit; }
    button { min-height: 2.5rem; border: 1px solid var(--gold); padding: .5rem .85rem; color: var(--gold); background: transparent; cursor: pointer; }
    button.primary { color: var(--gold-ink); background: var(--gold); font-weight: 650; }
    button:disabled { opacity: .45; cursor: not-allowed; }
    button.quiet { border-color: var(--line); color: var(--fg); }
    button.link { min-height: 0; padding: 0; border: 0; color: var(--gold); font-size: .8rem; text-decoration: underline; text-underline-offset: 2px; }
    button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, [contenteditable]:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    a { color: var(--gold); }
    input, textarea, select { width: 100%; background: var(--surface); border: 1px solid #5a5a56; padding: .6rem .7rem; }
    textarea { min-height: 4.5rem; resize: vertical; line-height: 1.45; }
    label { display: grid; gap: .35rem; font-weight: 600; font-size: .9rem; }
    .hint { color: var(--muted); font-size: .8rem; line-height: 1.4; font-weight: 400; margin: 0; }

    /* header */
    .top { height: 4rem; padding: .5rem 1rem; display: flex; align-items: center; gap: .75rem; border-bottom: 1px solid var(--line); }
    .top .brand { font-family: var(--display); font-size: 1.35rem; font-weight: 600; white-space: nowrap; }
    .nav { display: flex; align-items: center; gap: .4rem; min-width: 0; flex: 1 1 26rem; }
    .nav select { min-width: 0; }
    .nav button { flex: 0 0 auto; padding-inline: .6rem; }
    .progress { display: grid; gap: .2rem; min-width: 11rem; font-size: .82rem; }
    .bar { height: .3rem; background: #2a2a28; }
    .bar span { display: block; height: 100%; width: 0; background: var(--gold); transition: width .2s ease; }
    .saved { color: var(--muted); font-size: .72rem; display: flex; gap: .4rem; align-items: center; }
    .saved button { min-height: 0; padding: .05rem .4rem; font-size: .72rem; }
    .actions { display: flex; gap: .4rem; align-items: center; margin-left: auto; }
    details.more { position: relative; }
    details.more > summary { list-style: none; cursor: pointer; border: 1px solid var(--line); padding: .5rem .8rem; min-height: 2.5rem; display: flex; align-items: center; }
    details.more > summary::-webkit-details-marker { display: none; }
    details.more[open] > .menu { position: absolute; right: 0; top: calc(100% + .3rem); z-index: 5; display: grid; gap: .3rem; padding: .5rem; min-width: 12rem; background: var(--raised); border: 1px solid var(--line); }
    .menu button { text-align: left; border-color: var(--line); color: var(--fg); }

    /* workbench */
    .workbench { height: calc(100dvh - 4rem); display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(24rem, 1fr); grid-template-rows: minmax(0, 1fr); }
    .stage { min-width: 0; min-height: 0; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: #090909; }
    .stage-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; padding: .55rem .8rem; border-bottom: 1px solid var(--line); font-size: .85rem; }
    .stage-bar .count { color: var(--muted); font-variant-numeric: tabular-nums; }
    .stage-bar .spacer { flex: 1; }
    .stage-bar a { white-space: nowrap; }
    button.lead[aria-pressed="true"] { color: var(--gold-ink); background: var(--gold); font-weight: 650; }
    /* the picture fits the space left between the bar and the filmstrip, whatever its shape */
    .picture { position: relative; min-height: 0; overflow: hidden; }
    .picture img { position: absolute; inset: 0; margin: auto; display: block; max-width: calc(100% - 2rem); max-height: calc(100% - 2rem); object-fit: contain; background: #151515; }
    .filmstrip { display: flex; gap: .4rem; padding: .5rem .75rem; overflow-x: auto; border-top: 1px solid var(--line); }
    .filmstrip button { flex: 0 0 auto; width: 4.2rem; height: 3.6rem; min-height: 0; padding: .12rem; border-color: #555; position: relative; }
    .filmstrip button[aria-current="true"] { border-color: var(--gold); outline: 2px solid var(--gold); outline-offset: -3px; }
    .filmstrip button[data-lead="true"]::after { content: '★'; position: absolute; top: .05rem; right: .2rem; color: var(--gold); text-shadow: 0 0 3px #000; font-size: .85rem; }
    .filmstrip img { display: block; width: 100%; height: 100%; object-fit: cover; }

    /* panel and tabs */
    .panel { min-width: 0; min-height: 0; display: grid; grid-template-rows: auto auto minmax(0, 1fr); border-left: 1px solid var(--line); }
    /* these set their own display, which would beat [hidden] */
    .panel[hidden], .filmstrip[hidden], .picture[hidden], .read-rest[hidden] { display: none; }
    .head { padding: .8rem 1rem .4rem; display: grid; gap: .2rem; }
    .head small { color: var(--muted); }
    .head h1 { margin: 0; font-family: var(--display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 600; line-height: 1.05; text-wrap: balance; }
    .head .meta { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; color: var(--muted); font-size: .8rem; }
    .state { padding: .1rem .5rem; border: 1px solid var(--line); font-size: .75rem; }
    .state[data-done="true"] { border-color: var(--gold); color: var(--gold); }
    .tabs { display: flex; gap: 0; padding: 0 1rem; border-bottom: 1px solid var(--line); }
    .tabs button { border: 0; border-bottom: 2px solid transparent; color: var(--muted); min-height: 2.6rem; padding: .4rem .9rem; }
    .tabs button[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--gold); font-weight: 600; }
    .tab { overflow-y: auto; padding: 1rem; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1.1rem; }
    .tab[hidden] { display: none; }
    section.block { display: grid; gap: .5rem; }
    section.block > h2 { margin: 0; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }

    /* keyword chips */
    .chips { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; padding: .4rem; min-height: 2.8rem; background: var(--surface); border: 1px solid #5a5a56; }
    .chip { display: inline-flex; align-items: center; gap: .25rem; padding: .2rem .25rem .2rem .55rem; background: var(--chip); color: var(--chip-ink); font-size: .82rem; }
    .chip button { min-height: 0; padding: 0 .3rem; border: 0; color: var(--chip-ink); font-size: .95rem; line-height: 1; }
    .chip.inherited { background: transparent; border: 1px dashed #5a5a56; color: var(--muted); padding-right: .55rem; }
    .chips input { flex: 1 1 8rem; min-width: 8rem; border: 0; padding: .3rem; background: transparent; }
    .chips input:focus-visible { outline: 0; }
    .ideas { display: flex; flex-wrap: wrap; gap: .35rem; }
    .idea { display: inline-flex; align-items: stretch; border: 1px solid #555; border-radius: 999px; overflow: hidden; }
    .idea button { min-height: 0; padding: .28rem .55rem; border: 0; color: #d7d7d1; font-size: .78rem; }
    .idea button[aria-pressed="true"] { color: var(--gold-ink); background: var(--gold); }
    .idea .rating { display: inline-flex; align-items: center; padding: 0 .45rem; border-left: 1px solid #555; color: var(--gold); font-size: .68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .idea .rating[data-level="none"] { color: #888; }
    .idea[data-rising="true"] { border-color: var(--gold); }
    .subtabs button:disabled { opacity: .4; }
    details.drawer { border: 1px solid var(--line); }
    details.drawer > summary { cursor: pointer; padding: .55rem .7rem; font-size: .85rem; font-weight: 600; }
    details.drawer > div { padding: 0 .7rem .7rem; display: grid; gap: .55rem; }
    .subtabs { display: flex; flex-wrap: wrap; gap: .3rem; }
    .subtabs button { min-height: 0; padding: .25rem .6rem; font-size: .78rem; border-color: var(--line); color: var(--muted); }
    .subtabs button[aria-pressed="true"] { border-color: var(--gold); color: var(--gold); }
    .row-label { color: var(--muted); font-size: .75rem; }

    /* boxes: only the next one open; a handled one folds to one line, dims and gets a ✓, a click opens it again */
    details.box { border: 1px solid var(--line); background: var(--bg); transition: opacity .15s ease; }
    details.box > summary { list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: .55rem; padding: .6rem .75rem; min-height: 2.6rem; }
    details.box > summary::-webkit-details-marker { display: none; }
    details.box > summary::before { content: '▸'; color: var(--muted); font-size: .75rem; }
    details.box[open] > summary::before { content: '▾'; }
    details.box > summary .box-name { font-weight: 600; font-size: .88rem; white-space: nowrap; }
    details.box > summary .box-line { flex: 1; min-width: 0; color: var(--muted); font-size: .8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    details.box[open] > summary .box-line { visibility: hidden; }
    details.box > summary .box-tick { color: var(--gold); visibility: hidden; }
    details.box[data-state="done"] > summary .box-tick { visibility: visible; }
    details.box > .box-body { padding: 0 .75rem .75rem; display: grid; gap: .55rem; }
    details.box[data-state="todo"]:not([open]) { border-color: #5a5a56; }
    details.box[data-state="done"]:not([open]), details.box[data-state="quiet"]:not([open]) { opacity: .55; }
    details.box:not([open]):hover, details.box:not([open]):focus-within { opacity: 1; }
    .box-list, .pic-list { display: grid; grid-template-columns: minmax(0, 1fr); gap: .45rem; }
    .box-list > details.box, .pic-list > details.box { min-width: 0; }
    @media (prefers-reduced-motion: reduce) { details.box { transition: none; } }

    /* what WordPress had */
    dl.wp { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: .35rem .6rem; font-size: .82rem; align-items: baseline; }
    dl.wp dt { color: var(--muted); }
    dl.wp dd { margin: 0; overflow-wrap: anywhere; }
    .bottom { display: flex; gap: .5rem; flex-wrap: wrap; }
    .note { color: var(--gold); min-height: 1.2rem; font-size: .85rem; }

    /* previews: reddy.world's own look (overview.ts .tile/.work/.cap and .lead-row; [slug].astro) */
    .preview { display: grid; gap: .5rem; }
    .preview > h3 { margin: 0; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
    .wall { background: #0f0f0f; border: 1px solid var(--line); padding: 1rem; display: grid; gap: 1rem; }
    .tile { position: relative; width: min(100%, 20rem); overflow: hidden; background: #1a1a1a; }
    .tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .tile .cap { position: absolute; inset: auto 0 0; padding: 1.6rem .7rem .55rem; background: linear-gradient(transparent, rgba(0,0,0,.82)); display: grid; gap: .1rem; }
    .tile .cap .t { font-family: var(--display); font-size: 1.15rem; font-weight: 600; line-height: 1.1; color: #f5f5f0; }
    .tile .cap .m { font-size: .72rem; color: rgba(245,245,240,.75); }
    .lead-row { display: grid; grid-template-columns: 3fr 2fr; gap: 1rem; border-top: 2px solid #f5f5f0; border-bottom: 1px solid rgba(245,245,240,.25); padding: .8rem 0; }
    .lead-row .lead-pic { overflow: hidden; background: #1a1a1a; }
    .lead-row .lead-pic img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .lead-text { display: grid; align-content: start; gap: .35rem; }
    .lead-text .kicker { font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(245,245,240,.6); }
    .lead-text .title { font-family: var(--display); font-size: 1.7rem; font-weight: 600; line-height: 1.05; margin: 0; }
    .lead-text .line { font-family: var(--display); font-style: italic; font-size: 1.1rem; }
    .lead-text .desc { color: rgba(245,245,240,.7); font-size: .85rem; line-height: 1.45; margin: 0; }
    .lead-text .go { color: var(--gold); font-size: .82rem; }
    .panel-lines { display: grid; gap: .25rem; border-left: 2px solid var(--gold); padding-left: .7rem; }
    .panel-lines strong { font-family: var(--display); font-size: 1.35rem; font-weight: 600; }
    .panel-lines span { color: rgba(245,245,240,.7); font-size: .82rem; }
    .page { background: #0f0f0f; border: 1px solid var(--line); padding: 1rem; display: grid; gap: .45rem; }
    .page .crumb { font-size: .72rem; color: rgba(245,245,240,.6); }
    .page .when { font-family: ui-monospace, Consolas, monospace; font-size: .75rem; color: rgba(245,245,240,.7); }
    .page h4 { margin: 0; font-family: var(--display); font-size: 2rem; font-weight: 600; line-height: 1.05; color: var(--gold); }
    .page .sum { margin: 0; font-size: .95rem; line-height: 1.5; }
    .page figure { margin: .3rem 0 0; }
    .page figure img { display: block; width: 100%; max-height: 18rem; object-fit: cover; }
    .page figcaption { font-size: .75rem; color: rgba(245,245,240,.7); margin-top: .3rem; }
    /* an article on the wall, as a shared link and in search (the draft's second view) */
    .reading[hidden], .elsewhere[hidden] { display: none; }
    .elsewhere { overflow-y: auto; padding: 1rem clamp(1rem, 3vw, 2rem) 2rem; display: grid; align-content: start; gap: 1.4rem; }
    .tile.text { aspect-ratio: 4 / 3; }
    .tile.text .cap { background: none; }
    .elsewhere, .elsewhere * { min-width: 0; }
    .elsewhere .lead-row { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
    .elsewhere .lead-row.text { grid-template-columns: minmax(0, 1fr); }
    @media (max-width: 640px) { .elsewhere .lead-row { grid-template-columns: minmax(0, 1fr); } }
    .linkcard { width: 100%; max-width: 26rem; border: 1px solid #cfcfcf; background: #fff; color: #1d1d1d; font-family: system-ui, sans-serif; }
    .linkcard .pic { aspect-ratio: 1200 / 628; background: #e6e6e6; overflow: hidden; }
    .linkcard .pic img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .linkcard .words { display: grid; gap: .15rem; padding: .55rem .7rem .65rem; }
    .linkcard .site { font-size: .72rem; color: #666; }
    .linkcard strong { font-size: .95rem; line-height: 1.25; }
    .linkcard .d { font-size: .8rem; color: #555; line-height: 1.35; }
    .serp { display: grid; gap: .1rem; max-width: 36rem; background: #fff; color: #202124; padding: .7rem .8rem; border: 1px solid #ddd; font-family: Arial, sans-serif; }
    .serp .u { font-size: .78rem; color: #4d5156; }
    .serp .t { font-size: 1.1rem; color: #1a0dab; }
    .serp .d { font-size: .85rem; color: #4d5156; line-height: 1.4; }
    .empty-note { color: #888; font-style: italic; }

    /* the page: how it reads on the left, written in place */
    /* the reading view looks like the article's page (src/components/Article.astro, the paper colours of software.css) */
    .reading { overflow-y: auto; padding: 1.5rem clamp(1rem, 4vw, 3rem) 3rem; display: grid; align-content: start; gap: .7rem; background: #f8f4e9; color: #24211c; }
    .reading > * { max-width: 46rem; }
    .reading .when { font-family: ui-monospace, Consolas, monospace; font-size: .72rem; color: #6d675c; }
    .reading-title { margin: 0; font-family: var(--display); font-size: clamp(2rem, 4vw, 2.9rem); font-weight: 600; line-height: 1.1; color: #24211c; }
    .reading .dek { margin: 0; font-family: var(--display); font-style: italic; font-size: 1.35rem; color: #3b362e; }
    .reading .sum { margin: 0; font-size: 1.1rem; line-height: 1.6; }
    .reading .empty-note { color: #8a8376; }
    .reading-text { font-size: 1.02rem; line-height: 1.7; }
    .reading-text h2, .reading-text h3, .reading-text h4 { font-family: var(--display); }
    .reading-text a, .reading .dek a { color: #8b3a1a; }
    .row2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .6rem; }
    details.box.pic-row > summary { align-items: center; }
    .pic-row > summary img { flex: 0 0 auto; width: 3.4rem; height: 2.6rem; object-fit: cover; background: #111; }
    details.box.pic-row[open] > summary .box-line { visibility: visible; }
    .pic-row textarea { min-height: 3.4rem; }
    .pic-row .row { display: flex; flex-wrap: wrap; gap: .3rem; }
    .pic-row .row button { min-height: 2rem; padding: .2rem .55rem; font-size: .78rem; }
    .pic-row button[aria-pressed="true"] { color: var(--gold-ink); background: var(--gold); }
    .add-pics { display: inline-flex; align-items: center; min-height: 2.5rem; padding: .5rem .85rem; border: 1px solid var(--gold); color: var(--gold); cursor: pointer; width: max-content; }
    .add-pics:focus-within { outline: 2px solid var(--gold); outline-offset: 2px; }
    .reading figure { margin: .4rem 0; }
    .reading figure img, .reading .lead img { display: block; width: 100%; max-height: 28rem; object-fit: cover; }
    /* written in place: the editable parts show themselves on hover and focus, a picture carries its own tools */
    .reading [contenteditable="true"] { outline: none; border-radius: 2px; }
    .reading [contenteditable="true"]:hover { box-shadow: 0 0 0 1px #d8cfbb; }
    .reading [contenteditable="true"]:focus { box-shadow: 0 0 0 2px #c9b98f; }
    .reading [contenteditable="true"]:empty::before { content: attr(data-placeholder); color: #8a8376; }
    .reading .reading-text { position: relative; min-height: 8rem; }
    /* each part's row as tall as the part: with that min-height the text's row would stop at the room left on screen,
       and what follows the text (a project's Photographs) would be drawn over its pictures */
    .reading { grid-auto-rows: max-content; }
    .reading #page-note { color: #6d675c; }
    .reading #page-note:empty { display: none; }
    .reading #layout-note { color: var(--muted); }
    .reading [data-layout] { border-left: 2px dashed var(--line); padding-left: .6rem; }
    .reading .reading-text[data-empty="true"]::before { content: "Write the text here."; position: absolute; color: #8a8376; pointer-events: none; }
    .reading .pic-block { position: relative; cursor: grab; }
    .reading .pic-tools { position: absolute; top: .4rem; right: .4rem; display: flex; gap: .25rem; }
    .reading .pic-tools button { min-height: 2rem; min-width: 2rem; padding: 0 .55rem; border: 0; border-radius: 3px; background: rgba(36,33,28,.85); color: #f8f4e9; font-size: .85rem; cursor: pointer; }
    .reading .pic-tools button:focus-visible { outline: 2px solid #f8f4e9; outline-offset: 1px; }
    /* where ✕ took a row of pictures out: one line, its Put it back at the top right, where the ✕ was */
    .reading .out-mark { display: flex; align-items: flex-start; justify-content: space-between; gap: .8rem; min-height: 3rem; margin: .4rem 0; padding: .4rem .4rem .4rem .8rem; border: 1px dashed var(--line); color: var(--muted); font: 400 .9rem/1.4 var(--body); text-align: left; }
    .reading .out-mark span { padding-top: .3rem; }
    .reading .out-mark button { flex: none; min-height: 2rem; padding: 0 .7rem; font-size: .85rem; }
    .reading .video-block .poster { aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center; gap: .5rem; background: #111; color: #f5f5f0; font-size: .95rem; }
    .reading .video-block .poster span { font-size: 2.2rem; line-height: 1; }
    /* an article's text bar (#80): bold, italic, link, headings, lists, quote, undo, redo; it stays at the top while the text scrolls */
    .reading .text-bar { position: sticky; top: 0; z-index: 2; display: flex; flex-wrap: wrap; gap: .25rem; padding: .35rem 0; background: #f8f4e9; border-bottom: 1px solid #d8cfbb; }
    .reading .text-bar[hidden], .reading .link-form[hidden] { display: none; }
    .reading .text-bar button { min-height: 2rem; min-width: 2rem; padding: 0 .55rem; border: 1px solid #d8cfbb; color: #24211c; background: transparent; font-size: .85rem; }
    .reading .text-bar button[aria-pressed="true"] { border-color: #24211c; color: #f8f4e9; background: #24211c; }
    .reading .text-bar button:disabled { opacity: .4; cursor: default; }
    .reading .text-bar button:focus-visible { outline: 2px solid #24211c; outline-offset: 1px; }
    .reading .link-form { flex: 1 1 100%; display: flex; flex-wrap: wrap; gap: .25rem; }
    .reading .link-form input { flex: 1 1 14rem; min-width: 0; min-height: 2rem; }
    .reading .ProseMirror-selectednode { outline: 2px solid #c9b98f; outline-offset: 2px; }
    .video-form { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .video-form[hidden] { display: none; }
    .video-form input { flex: 1 1 14rem; min-width: 0; }
    /* ↑ ↓ beside the paragraph the cursor is in */
    .reading { position: relative; }
    .reading .block-tools { position: absolute; z-index: 1; display: flex; gap: .25rem; }
    .reading .block-tools[hidden] { display: none; }
    .reading .block-tools.beside { flex-direction: column; }
    .reading .block-tools button { min-height: 1.8rem; min-width: 1.8rem; padding: 0 .45rem; border: 0; border-radius: 3px; background: rgba(36,33,28,.85); color: #f8f4e9; font-size: .8rem; cursor: pointer; }
    .reading .block-tools button:disabled { opacity: .35; cursor: default; }
    .reading .block-tools button:focus-visible { outline: 2px solid #24211c; outline-offset: 1px; }
    .reading .drop-above { box-shadow: 0 -3px 0 #8b3a1a; }
    .reading .drop-below { box-shadow: 0 3px 0 #8b3a1a; }
    .reading-text { overflow-wrap: anywhere; }
    /* a project's page: the site's dark look (global.css .modal-title, .post-summary, .modal-body-text) and its order,
       the summary, then the lead, the text and the Photographs ([slug].astro). One column, no wider than the page:
       a row of pictures counts their full size as its narrowest, which would widen an auto column. */
    .reading[data-kind="project"] { grid-template-columns: minmax(0, 1fr); background: var(--bg); color: var(--fg); }
    .reading[data-kind="project"] .reading-title { color: var(--gold); }
    .reading[data-kind="project"] .when, .reading[data-kind="project"] #page-note { color: var(--muted); }
    .reading[data-kind="project"] .reading-text a { color: var(--gold); }
    .reading[data-kind="project"] [contenteditable="true"]:hover { box-shadow: 0 0 0 1px var(--line); }
    .reading[data-kind="project"] [contenteditable="true"]:focus { box-shadow: 0 0 0 2px var(--gold); }
    .reading[data-kind="project"] [contenteditable="true"]:empty::before, .reading[data-kind="project"] .reading-text[data-empty="true"]::before { color: var(--muted); }
    .reading[data-kind="project"] .drop-above { box-shadow: 0 -3px 0 var(--gold); }
    .reading[data-kind="project"] .drop-below { box-shadow: 0 3px 0 var(--gold); }
    .reading[data-kind="project"] .block-tools button { background: var(--raised); color: var(--fg); }
    .reading[data-kind="project"] .block-tools button:focus-visible { outline-color: var(--gold); }
    .reading[data-kind="project"] #read-lead { order: 1; }
    .reading[data-kind="project"] #read-text { order: 2; }
    .reading[data-kind="project"] #read-rest { order: 3; }
    /* a project's pictures in the site's rows of up to three, each as wide as its shape (global.css .post-row) */
    .reading .media-row { display: flex; gap: .4rem; margin-bottom: .4rem; }
    .reading .media-row img { flex: var(--r) 1 0; min-width: 0; width: auto; max-height: none; aspect-ratio: var(--r); object-fit: cover; cursor: zoom-in; }
    .reading .media-row img:only-child { flex: 1 1 auto; width: 100%; max-height: 28rem; object-fit: contain; }
    .reading img[data-current="true"] { outline: 2px solid var(--gold); outline-offset: 2px; }
    .read-rest .rest-title { margin: .8rem 0; font-family: var(--display); font-size: 1.6rem; font-weight: 600; color: var(--gold); }
    .state[data-ready="true"] { border-color: var(--gold); color: var(--gold); }
    .panel.article-panel { grid-template-rows: auto minmax(0, 1fr); }
    .ov-articles ul { list-style: none; margin: .4rem 0; padding: 0; display: grid; gap: .3rem; }
    .ov-articles h3 { margin: .6rem 0 0; font-family: var(--display); font-size: 1.35rem; font-weight: 600; }

    dialog { max-width: 36rem; color: var(--fg); background: #151515; border: 1px solid var(--gold); }
    dialog.map-dialog { width: min(64rem, calc(100% - 2rem)); max-width: none; max-height: calc(100dvh - 2rem); }
    .map-tools { position: sticky; top: 0; display: flex; gap: .6rem; padding-bottom: .75rem; background: #151515; }
    .keyword-map { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .45rem; }
    .keyword-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .3rem; padding: .45rem; border: 1px solid #3a3a38; }
    .keyword-row small { display: block; color: var(--muted); }
    dialog::backdrop { background: rgba(0,0,0,.75); }

    /* the overview (src/lib/desk-sync.js draws it) */
    .overview { position: fixed; inset: 0; z-index: 10; overflow-y: auto; background: var(--bg); }
    .overview[hidden] { display: none; }
    .ov-wrap { max-width: 44rem; margin: 0 auto; padding: 1.5rem 1rem 4rem; display: grid; gap: .9rem; }
    .ov-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .ov-head h2 { margin: 0; font-family: var(--display); font-size: 2rem; font-weight: 600; }
    .ov-next { min-height: 4rem; font-size: 1.25rem; text-align: left; }
    .ov-big { margin: .5rem 0 0; font-size: 1.15rem; font-weight: 600; }
    .ov-line { margin: 0; color: #ccc; line-height: 1.45; }
    .ov-bar { display: flex; height: .7rem; background: #2a2a28; }
    .ov-bar .ov-done { background: var(--gold); }
    .ov-bar .ov-started { background: #7a6a48; }
    .ov-portfolio { border-top: 1px solid var(--line); padding: .7rem 0; }
    .ov-portfolio summary { cursor: pointer; display: grid; gap: .45rem; }
    .ov-portfolio summary span { display: flex; justify-content: space-between; gap: 1rem; }
    .ov-portfolio summary small { color: var(--muted); }
    .ov-portfolio ul { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .3rem; }
    .ov-row { width: 100%; min-height: 0; display: grid; grid-template-columns: .8rem 1fr; gap: .1rem .6rem; text-align: left; border-color: #3a3a38; color: var(--fg); }
    .ov-row small { grid-column: 2; color: var(--muted); }
    .ov-dot { width: .7rem; height: .7rem; margin-top: .3rem; border: 1px solid var(--gold); border-radius: 50%; }
    .ov-dot.ov-done { background: var(--gold); }
    .ov-dot.ov-started { background: #7a6a48; }

    @media (max-width: 900px) {
      body { overflow: auto; }
      .top { height: auto; flex-wrap: wrap; row-gap: .5rem; }
      .top .brand { display: none; }
      .nav { flex: 1 1 100%; }
      .progress { flex: 1 1 10rem; min-width: 0; }
      .workbench { height: auto; grid-template-columns: 1fr; grid-template-rows: auto; }
      /* the window scrolls here: nothing in the stage anchors it, or swapping the page and a picture (another bar)
         would move the tabs under the finger */
      .stage { height: 52dvh; overflow-anchor: none; }
      .stage-bar { padding: .4rem .6rem; gap: .5rem; }
      .stage-bar .count { white-space: nowrap; }
      /* the page's bar label can be long ("On the wall, as a link, in search"): it wraps rather than run off */
      .stage-bar #article-view { white-space: normal; flex: 1 1 100%; }
      .stage-bar .spacer { display: none; }
      .stage-bar button.lead { min-height: 2.2rem; padding: .3rem .6rem; font-size: .82rem; }
      .panel { border-left: 0; border-top: 1px solid var(--line); }
      .tab { overflow: visible; }
      .lead-row { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) { .bar span { transition: none; } }
  </style>
</head>
<body>
  <header class="top">
    <span class="brand">Portfolio desk</span>
    <nav class="nav" aria-label="Projects">
      <button id="previous" class="quiet" type="button" title="Previous project (Alt+←)">←</button>
      <select id="project-picker" aria-label="Project"></select>
      <button id="next-project" class="quiet" type="button" title="Next project to review (Alt+→)">Next to review →</button>
      <button id="new-article" class="quiet" type="button" title="A new item for the wall, kept as a private draft">New item</button>
    </nav>
    <div class="progress">
      <span id="progress-label"></span>
      <div class="bar"><span id="bar"></span></div>
      <span class="saved"><span data-desk-saved aria-live="polite">Saved in this browser</span><button data-desk-signin type="button" hidden>Sign in</button></span>
    </div>
    <div class="actions">
      <button id="open-overview" type="button">All items</button>
      <button id="open-wall" type="button">Arrange wall</button>
      <button id="save-desk" class="quiet" type="button" title="Save privately without publishing">Save</button>
      <button id="send" class="primary" type="button">Publish changes</button>
      <details class="more"><summary>Tools</summary>
        <div class="menu">
          <button id="new-article-tools" class="mobile-new-article" type="button">New item</button>
          <button id="map" type="button">Browse all tags</button>
          <button id="help" type="button">How this desk works</button>
          <button id="export" type="button">Download backup</button>
          <button id="load" type="button">Restore backup file</button>
          <input id="load-file" type="file" accept=".json,application/json" hidden>
        </div>
      </details>
    </div>
  </header>

  <main class="workbench" id="bench">
    <!-- every kind opens on its page, where it is written: the summary and the text edit in place, an article's title too.
         A project's Picture tab shows one picture large here instead. data-for: the views a control of the bar is in. -->
    <section class="stage" aria-label="The page">
      <div class="stage-bar">
        <span class="count" id="article-view" data-for="article page">Edit page · changes save privately</span>
        <span class="count" id="image-counter" data-for="picture"></span>
        <span class="spacer"></span>
        <button id="back-to-page" class="quiet" type="button" data-for="picture">Back to page</button>
        <button id="make-hero" class="lead" type="button" aria-pressed="false" data-for="picture">Use as cover image</button>
        <a id="project-link" target="_blank" rel="noreferrer" data-for="page picture">View live page ↗</a>
        <div id="page-add" class="page-add" role="group" aria-label="Add to page" data-for="article page">
          <button id="add-text-here" class="quiet" type="button">Add text</button>
          <button id="add-picture-here" class="quiet" type="button">Add images</button>
          <button id="add-video-here" class="quiet" type="button">Add video</button>
          <span>Click text to edit · Enter adds a paragraph · select words to format</span>
        </div>
        <button id="show-elsewhere" class="quiet" type="button" data-for="article">Preview wall card</button>
        <button id="back-to-projects" class="quiet" type="button" data-for="article">Back to projects</button>
      </div>
      <article class="reading" id="reading">
        <span class="when" id="read-when"></span>
        <p class="hint" id="page-note" aria-live="polite"></p>
        <form class="video-form" id="video-form" hidden>
          <label>Add video<select id="video-source"><option value="link">YouTube or Vimeo link</option><option value="file">Upload a video file</option></select></label>
          <label id="video-file-label" hidden>MP4 or WebM · up to 25 MB<input id="video-file" type="file" accept="video/mp4,video/webm,.mp4,.webm"></label>
          <label><input id="video-banner" type="checkbox"> Use as the page banner</label><input id="video-url" type="url" inputmode="url" autocomplete="off" placeholder="Paste a YouTube or Vimeo link" aria-label="A YouTube or Vimeo link"><label><input id="video-embed" type="checkbox" checked> Embed a player</label><button type="submit">Add video to page</button><p id="video-status" class="hint" role="status"></p><button id="video-cancel" class="quiet" type="button">Cancel</button></form>
        <h2 class="reading-title" id="read-title" contenteditable="true" data-placeholder="The article's title" aria-label="The article's title"></h2>
        <p class="dek" id="read-dek" hidden></p>
        <div class="lead" id="read-lead" hidden></div>
        <p class="sum" id="read-sum" contenteditable="true" data-placeholder="A short summary: one or two lines, shown on the wall and under the title" aria-label="Short summary"></p>
        <p class="hint" id="layout-note" hidden>Marked at the left: the old site's own layout. Words changed there make it plain paragraphs on the site.</p>
        <div class="text-bar" id="text-bar" role="toolbar" aria-label="Text" hidden>
          <button type="button" data-cmd="bold" aria-label="Bold" aria-pressed="false"><b>B</b></button>
          <button type="button" data-cmd="italic" aria-label="Italic" aria-pressed="false"><i>I</i></button>
          <button type="button" data-cmd="link" aria-label="Link" aria-pressed="false">Link</button>
          <button type="button" data-cmd="h2" aria-label="Heading" aria-pressed="false">Heading</button>
          <button type="button" data-cmd="h3" aria-label="Small heading" aria-pressed="false">Subheading</button>
          <button type="button" data-cmd="bullet" aria-label="List" aria-pressed="false">Bullet list</button>
          <button type="button" data-cmd="ordered" aria-label="Numbered list" aria-pressed="false">Numbered list</button>
          <button type="button" data-cmd="quote" aria-label="Quote" aria-pressed="false">Quote</button>
          <button type="button" data-cmd="undo" aria-label="Undo">Undo</button>
          <button type="button" data-cmd="redo" aria-label="Redo">Redo</button>
          <form class="link-form" id="link-form" hidden><input id="link-url" type="text" inputmode="url" autocomplete="off" placeholder="https://… or /portfolio/…" aria-label="The link's address"><button type="submit">Set link</button><button id="link-remove" class="quiet" type="button">Remove link</button></form>
        </div>
        <details id="page-source" class="field-source"><summary>Original text and writing help</summary><div id="page-source-content"></div></details>
        <div class="reading-text" id="read-text" contenteditable="true" role="textbox" aria-multiline="true" aria-label="The article's text"></div>
        <section class="read-rest" id="read-rest" hidden><h3 class="rest-title"></h3><div class="rest-rows"></div></section>
        <div class="block-tools" id="block-tools" hidden><button type="button" data-move="up" aria-label="Move this paragraph up (Alt+↑)">↑ Move up</button><button type="button" data-move="down" aria-label="Move this paragraph down (Alt+↓)">↓ Move down</button></div>
      </article>
      <div class="elsewhere" id="elsewhere" hidden></div>
      <div class="picture" id="picture-view" hidden><img id="picture" alt=""></div>
      <nav class="filmstrip" id="filmstrip" hidden aria-label="All images in this project"></nav>
    </section>

    <section class="panel" id="project-bench" aria-label="This project">
      <div class="head">
        <small id="portfolio"></small>
        <h1 id="project-title"></h1>
        <div class="meta"><span id="project-when"></span><span class="state" id="project-state"></span></div>
      </div>
      <div class="tabs" role="tablist" aria-label="What to work on">
        <button role="tab" id="tab-project" aria-controls="pane-project" aria-selected="true" type="button">Project</button>
        <button role="tab" id="tab-picture" aria-controls="pane-picture" aria-selected="false" type="button">Picture</button>
        <button role="tab" id="tab-preview" aria-controls="pane-preview" aria-selected="false" type="button">Preview</button>
      </div>

      <div class="tab" role="tabpanel" id="pane-project" aria-labelledby="tab-project">
        <div class="box-list" data-boxes="project">
          <details class="box" data-box="summary">
            <summary><span class="box-name">Summary</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <textarea id="summary" aria-label="Short summary" placeholder="One or two lines in your own words"></textarea>
              <p class="hint" id="summary-hint"></p>
            </div>
          </details>

          <details class="box" data-box="keywords">
            <summary><span class="box-name">Tags</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <div class="chips" id="project-chips"></div>
              <p class="hint" id="project-keywords-hint"></p>
              <details class="drawer" id="ideas">
                <summary>Ideas</summary>
                <div>
                  <div class="subtabs" id="idea-tabs"></div>
                  <div id="idea-list" class="ideas"></div>
                  <p class="hint" id="idea-hint"></p>
                </div>
              </details>
            </div>
          </details>

          <details class="box" data-box="text">
            <summary><span class="box-name">The text</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <p class="hint">Write on the page, left. Move a picture row with ↑ ↓ or drag it; ✕ takes it out of the text, to Photographs below, unless it is all the text has. A click on a picture opens it large. <button class="link" id="story-reset" type="button" hidden>Undo my changes to the text</button></p>
            </div>
          </details>

          <details class="box" data-box="wordpress">
            <summary><span class="box-name">From WordPress</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body"><dl class="wp" id="wp-project"></dl></div>
          </details>
        </div>

        <div class="bottom">
          <button id="done" class="primary" type="button">Save & next →</button>
          <button id="reopen" class="quiet" type="button" hidden>Mark as not reviewed</button>
        </div>
        <p class="hint">Save &amp; next saves privately and marks this project reviewed.</p>
        <p class="note" id="note" aria-live="polite"></p>
      </div>

      <div class="tab" role="tabpanel" id="pane-picture" aria-labelledby="tab-picture" hidden>
        <div class="box-list" data-boxes="picture">
          <details class="box" data-box="description">
            <summary><span class="box-name">Image description</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <textarea id="description" aria-label="What someone who can't see this picture should hear" placeholder="Who or what is in it, and where"></textarea>
              <p class="hint">Its alt text on the site, for someone who can't see it.</p>
            </div>
          </details>
          <details class="box" data-box="keywords">
            <summary><span class="box-name">Tags</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <div class="chips" id="image-chips"></div>
              <p class="hint">Dashed: from the project.</p>
              <div class="ideas" id="image-ideas"></div>
            </div>
          </details>
          <details class="box" data-box="credit" id="credit-panel">
            <summary><span class="box-name">Photographer</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <label>Photographer for this image <input id="credit-image-name" autocomplete="off" placeholder="Name as it should appear"></label>
              <label>Photographer website <input id="credit-image-url" inputmode="url" autocomplete="off" placeholder="https://…"></label>
              <label>Photographer for all project images <input id="credit-project-name" autocomplete="off" placeholder="Name as it should appear"></label>
              <label>Photographer website <input id="credit-project-url" inputmode="url" autocomplete="off" placeholder="https://…"></label>
              <p class="hint" id="credit-shown" aria-live="polite"></p>
              <button id="next-uncredited" type="button">Next image missing a credit →</button>
            </div>
          </details>
          <details class="box" data-box="wordpress">
            <summary><span class="box-name">From WordPress</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body"><dl class="wp" id="wp-picture"></dl></div>
          </details>
        </div>
      </div>

      <div class="tab" role="tabpanel" id="pane-preview" aria-labelledby="tab-preview" hidden>
        <div class="preview">
          <h3>On the wall</h3>
          <div class="wall" id="preview-wall"></div>
        </div>
        <div class="preview">
          <h3>On its page</h3>
          <div class="page" id="preview-page"></div>
        </div>
      </div>
    </section>

    <section class="panel article-panel" id="article-bench" aria-label="This article" hidden>
      <div class="head">
        <small>Article</small>
        <h1 id="article-heading"></h1>
        <div class="meta"><span id="article-when"></span><span class="state" id="article-state">Draft: only you see it</span></div>
      </div>
      <div class="tab">
        <div class="box-list" data-boxes="article">
          <details class="box" data-box="title">
            <summary><span class="box-name">Title</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body"><input id="article-title" aria-label="Title" autocomplete="off" placeholder="The article's title"></div>
          </details>
          <details class="box" data-box="about">
            <summary><span class="box-name">Kind</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body row2">
              <label>Kind <select id="article-kind"></select></label>
              <label>Language <select id="article-lang"><option value="en">English</option><option value="nl">Nederlands</option></select></label>
              <label>Year of work <input id="article-year" type="number" min="1990" max="2100" inputmode="numeric"></label>
            </div>
          </details>
          <details class="box" data-box="person" id="article-person">
            <summary><span class="box-name">The person</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <label>The words before their name <input id="article-byline" autocomplete="off" placeholder="Inzichten van, In conversation with…"></label>
              <div class="row2">
                <label>Name <input id="person-name" autocomplete="off"></label>
                <label>Their profile <input id="person-profile" inputmode="url" autocomplete="off" placeholder="https://…"></label>
              </div>
              <label>Role <input id="person-role" autocomplete="off" placeholder="As they describe it"></label>
              <div class="row2">
                <label>Organisation <input id="person-org" autocomplete="off"></label>
                <label>Its site <input id="person-org-url" inputmode="url" autocomplete="off" placeholder="https://…"></label>
              </div>
              <p class="hint">The organisation's name in the role links to its site.</p>
            </div>
          </details>
          <details class="box" data-box="related">
            <summary><span class="box-name">Case study</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body"><select id="article-related" aria-label="Belongs to a case study"><option value="">None</option></select></div>
          </details>
          <details class="box" data-box="summary">
            <summary><span class="box-name">Summary</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <textarea id="article-summary" aria-label="Short summary" placeholder="One or two lines in your own words"></textarea>
              <p class="hint">On the wall and under the title.</p>
            </div>
          </details>
          <details class="box" data-box="text">
            <summary><span class="box-name">The text</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body"><p class="hint">Write on the page, left. Ctrl+B and Ctrl+I work; move a picture or video with ↑ ↓ or drag it. Add video accepts a YouTube/Vimeo link or an MP4/WebM file up to 25 MB.</p></div>
          </details>
          <details class="box" data-box="pictures">
            <summary><span class="box-name">Images</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <div class="pic-list" id="pic-list" data-boxes="pictures"></div>
              <label class="add-pics">＋ Add pictures <input id="pic-input" type="file" accept="image/*" multiple hidden></label>
              <p class="hint" id="pic-hint">Uploads stay private until you publish. Add to page places an image after your cursor.</p>
            </div>
          </details>
          <details class="box" data-box="publish">
            <summary><span class="box-name">Publishing</span><span class="box-line"></span><span class="box-tick" aria-hidden="true">✓</span></summary>
            <div class="box-body">
              <p class="hint" id="publish-hint"></p>
              <div class="bottom"><button id="publish-article" class="primary" type="button">Include in next publish</button><button id="unpublish-article" class="quiet" type="button" hidden>Back to draft</button></div>
              <p class="hint" id="article-address"></p>
            </div>
          </details>
        </div>
        <div class="bottom"><button id="delete-article" class="quiet" type="button">Delete this draft</button></div>
        <p class="note" id="article-note" aria-live="polite"></p>
      </div>
    </section>
  </main>

  <dialog id="keyword-map" class="map-dialog"><h2>Keyword map</h2><p class="hint">Every keyword in the archive and on this desk, and how many projects use it.</p><div class="map-tools"><input id="map-filter" type="search" placeholder="Filter keywords…" aria-label="Filter keywords"><button id="close-map" type="button">Close</button></div><div class="keyword-map" id="map-list"></div></dialog>
  <dialog id="sent" aria-labelledby="sent-title">
    <h2 id="sent-title">Publish changes</h2>
    <p id="sent-text"></p>
    <p><a id="sent-link" target="_blank" rel="noreferrer"></a></p>
    <button id="close-sent" class="primary" type="button">Close</button>
  </dialog>
  <dialog id="keys">
    <h2>How this desk works</h2>
    <p>Each project opens on what the site has today. Change anything; it saves by itself, to your account when you are signed in.</p>
    <p>Only the next thing to do is open. A box you finished folds to one dim line with a ✓; click it to open it again.</p>
    <p><strong>Project</strong>: its page on the left, where you write the summary and the text; on the right the keywords every picture gets. <strong>Picture</strong>: one picture large with all of the project's pictures below it, and what it shows, its own keywords and its photographer; a click on a picture on the page opens it here. <strong>Preview</strong>: how it looks on the wall and on its page.</p>
    <p>The ★ is the lead picture: the card and the wall show it. Keys: Alt+← and Alt+→ change project, Ctrl+Enter saves, marks reviewed and opens the next project to review.</p>
    <p><strong>＋ Article</strong> starts a new piece for the wall. It stays a draft, only for you and saved to your account, until you publish it.</p>
    <button id="close-keys" class="primary" type="button">Got it</button>
  </dialog>
  <script type="application/json" id="queue-data" set:html={queue}></script>
  <script type="application/json" id="credit-data" set:html={archiveCredits()}></script>
  <script>
    import {nextToReview,rememberPlace,resumeCursor} from '../lib/desk-progress.js';
    import {VIDEO_KEY,videoKey,videoFor} from '../lib/article-video.js';
    import {uploadedVideoUrl,VIDEO_UPLOAD_LIMIT} from '../lib/uploaded-video.js';
    import {placeTextImages,projectEditorText} from '../lib/text-media.js';
    import {labelSourceLinks} from '../lib/source-links.js';
    const DATA = JSON.parse(document.querySelector('#queue-data').textContent);
    const STORE = 'reddy-world-image-metadata-v4';
    const PREVIOUS = 'reddy-world-image-metadata-v3';
    const OLDER = 'reddy-world-image-metadata-v2';
    // no saved place yet: the desk opens on the first project that is not done (set below)
    const empty = {projects: {}, images: {}, session: 0};
    const read = () => {
      try {
        const saved = localStorage.getItem(STORE) || localStorage.getItem(PREVIOUS) || localStorage.getItem(OLDER) || '{}';
        return {...empty, ...JSON.parse(saved)};
      } catch { return {...empty}; }
    };
    const state = read();
    // A draft prepared in the repo joins Ryan's drafts once, before the account copy merges in (desk-sync.js).
    // Unstamped, so a draft he deleted on another device stays deleted in the merge.
    state.articles ??= {};
    for (const [id, seed] of Object.entries(DATA.seeds ?? {})) {
      if (!(id in state.articles)) state.articles[id] = {...seed, status: 'draft', created: Date.now()};
    }
    function hydrateProjectPictures() {
      for(const project of DATA.projects)project.images=project.images.filter(image=>!image.pictureId || !state.projects[project.id]?.pictures?.[image.pictureId]?.removed);
      for (const project of DATA.projects) for (const [id,picture] of Object.entries(state.projects[project.id]?.pictures ?? {})) {
        if (picture.removed || project.images.some(image=>image.pictureId===id)) continue;
        const url='/portfolio/images/project-uploads/'+project.id+'/'+id+'.webp';
        project.images.push({key:project.id+'::'+url,url,src:photoUrls.get(picture.path) || url,pictureId:id,index:project.images.length+1,width:0,height:0,existingDescription:'',alt:picture.alt ?? '',description:'',keywords:[],credit:null,wordpress:{title:picture.name,caption:'',alt:'',file:picture.name},nearby:[],nearbySuggestions:[],suggestions:[]});
        if (!photoUrls.has(picture.path) && window.deskSync?.picture) window.deskSync.picture(picture.path).then(src=>{if(src){photoUrls.set(picture.path,src);const image=project.images.find(image=>image.pictureId===id);if(image)image.src=src;render();}}).catch(()=>{});
      }
    }
    const flat = DATA.projects.flatMap((project, projectIndex) => project.images.map((image, imageIndex) => ({project, projectIndex, image, imageIndex})));
    const $ = (id) => document.getElementById(id);
    const el = (tag, props = {}, ...children) => { const node = Object.assign(document.createElement(tag), props); node.append(...children.filter((c) => c !== null && c !== undefined && c !== false)); return node; };
    const tags = (value = '') => [...new Map(String(value).split(',').map((tag) => tag.trim()).filter(Boolean).map((tag) => [tag.toLowerCase(), tag])).values()];
    const same = (a, b) => a.toLowerCase() === b.toLowerCase();
    // desk-sync.js (below) stamps each change and copies it to Ryan's account when he is signed in
    // (and the boxes follow: one Ryan just handled folds, below)
    let localSaveError=null;
    const save = () => { rememberPlace(state,flat); window.deskSync?.stamp(state); try { localStorage.setItem(STORE, JSON.stringify(state));localSaveError=null; } catch(error) {localSaveError=error;} window.deskSync?.saved(); refreshAllBoxes(); window.dispatchEvent(new Event('desk-saved')); };
    const current = () => flat[state.cursor] ?? flat[0];
    const projectRecord = (project) => state.projects[project.id] ?? {};
    const recordFor = (image) => state.images[image.key] ?? state.images[image.url] ?? {};

    // What the desk shows: Ryan's change when he made one, else what the archive has today.
    // A record is only written once he changes something, so opening a project changes nothing.
    // A blank field counts as unchanged: earlier desks wrote blanks just by showing a project (and
    // "Publish changes" reads blanks the same way). A field Ryan empties on purpose is named in `cleared`.
    const isCleared = (record, field) => Array.isArray(record?.cleared) && record.cleared.includes(field);
    const pick = (record, field, base) => (isCleared(record, field) ? '' : String(record[field] ?? '').trim() ? record[field] : base);
    // the record with its new value, `cleared` kept in step: emptying a field the archive fills clears it on purpose
    function withValue(record, field, value, base) {
      const cleared = (record?.cleared ?? []).filter((name) => name !== field);
      if (!String(value ?? '').trim() && String(base ?? '').trim()) cleared.push(field);
      const next = {...record, [field]: value};
      if (cleared.length) next.cleared = cleared;
      else delete next.cleared;
      return next;
    }
    const projectTags = (project) => tags(pick(projectRecord(project), 'tags', project.keywords.join(', ')));
    const isDone = (project) => Boolean(projectRecord(project).reviewed ?? project.done);
    const summaryOf = (project) => pick(projectRecord(project), 'summary', project.summary);
    const titleOf = (project) => pick(projectRecord(project), 'title', project.title);
    const dateLabelOf = (project) => projectRecord(project).published ? new Date(`${projectRecord(project).published}T00:00:00Z`).toLocaleDateString('en-GB', {year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}) : project.dateLabel;
    const ownKeywords = (project, image) => image.keywords.filter((word) => !project.keywords.some((shared) => same(shared, word)));
    const imageTags = (project, image) => tags(pick(recordFor(image), 'tags', ownKeywords(project, image).join(', ')));
    const descriptionOf = (image) => pick(recordFor(image), 'description', image.description || image.existingDescription || image.alt || '');
    const heroOf = (project) => projectRecord(project).hero || project.hero;
    function setProject(project, field, value, base) {
      const record = state.projects[project.id];
      if (!record && value === base) return;
      state.projects[project.id] = withValue(record, field, value, base);
      save();
    }
    function setImage(image, field, value, base) {
      const record = state.images[image.key] ?? state.images[image.url];
      if (!record && value === base) return;
      state.images[image.key] = withValue(record, field, value, base);
      save();
    }
    const completed = () => DATA.projects.filter(isDone).length;
    const firstIncomplete = () => {
      const projectIndex = DATA.projects.findIndex((project) => !isDone(project));
      return projectIndex < 0 ? 0 : flat.findIndex((item) => item.projectIndex === projectIndex);
    };
    state.cursor=resumeCursor(flat,state)??Math.max(0,firstIncomplete());
    // the edit bar on a project page links here as #project=<id>: open that project, and keep it open
    const linked = decodeURIComponent((location.hash.match(/^#project=(.+)$/) ?? [])[1] ?? '');
    const linkedIndex = DATA.projects.findIndex((project) => project.id === linked);
    if (linkedIndex >= 0) {
      state.cursor = flat.findIndex((item) => item.projectIndex === linkedIndex);
      state.article = null;rememberPlace(state,flat);
      history.replaceState(null, '', location.pathname + location.search);
    }
    window.imageDesk = {DATA, STORE, state, flat, save, resumeCursor:copy=>resumeCursor(flat,copy)??Math.max(0,firstIncomplete()),
      saveCurrent:()=>{if(!state.article){const {project}=current();state.projects[project.id]={...projectRecord(project),title:titleOf(project),summary:summaryOf(project),tags:projectTags(project).join(', '),reviewed:projectRecord(project).reviewed??project.done};}save();if(localSaveError)throw new Error('Could not save in this browser. Download a backup from Tools before leaving.');}, pinned: linkedIndex >= 0, render: (options) => { render(options); window.dispatchEvent(new Event('desk-render')); },
      // for scripts/desk-sync-check.mjs: the pieces a text is read in, and the piece a node of the page was drawn from
      pieces: (html) => textPieces(html).map((piece) => piece.source), pieceSource: (node) => pieceOf.get(node)?.source};

    // ---------- boxes: only the next thing open ----------
    // Ryan, 2026-10-27: "progressive dicsclosure and also boxes that autocompact once they have been handled, also
    // become more dim less contrast once tackled". Each box is handled ('done', a ✓), still to do ('todo') or optional
    // and empty ('quiet'), and says in one line what it holds. Another project, picture or article opens only the
    // first box still to do. A box that becomes handled folds: at once when Ryan filled it from elsewhere, or when
    // he moves on from it; then the next one to do opens. A click opens any box again.
    const boxSpecs = {}; // per list (data-boxes): box name -> () => [state, line], filled in below
    const boxContext = {};
    const boxesOf = (scope) => [...document.querySelectorAll(`[data-boxes="${scope}"] > details.box`)].filter((box) => !box.hidden);
    function openNext(scope, except = null) {
      const list = boxesOf(scope);
      if (list.some((box) => box.open && box !== except)) return;
      const next = list.find((box) => box.dataset.state === 'todo');
      if (next) next.open = true;
    }
    function refreshBoxes(scope, context) {
      const specs = boxSpecs[scope];
      const fresh = context !== undefined && boxContext[scope] !== context;
      if (context !== undefined) boxContext[scope] = context;
      for (const box of boxesOf(scope)) {
        const spec = typeof specs === 'function' ? specs(box.dataset.box) : specs?.[box.dataset.box]?.();
        if (!spec) continue;
        const [state, line] = spec;
        const was = box.dataset.state;
        box.dataset.state = state;
        box.querySelector(':scope > summary .box-line').textContent = line;
        if (!fresh && was === 'todo' && state === 'done' && box.open && !box.contains(document.activeElement)) {
          box.open = false;
          openNext(scope, box);
        }
      }
      if (fresh) {
        let opened = false;
        for (const box of boxesOf(scope)) {
          box.open = !opened && box.dataset.state === 'todo';
          opened ||= box.open;
        }
      }
    }
    const refreshAllBoxes = () => { for (const scope of Object.keys(boxSpecs)) refreshBoxes(scope); };
    // the boxes Ryan is working in, with their state when he went in: one handled since folds once he moves on
    const entered = new Map();
    function leave(target) {
      for (const [box, was] of entered) {
        if (box.contains(target)) continue;
        entered.delete(box);
        const scope = box.parentElement?.dataset.boxes;
        if (!box.isConnected || !scope) continue;
        refreshBoxes(scope);
        if (was === 'done' || box.dataset.state !== 'done' || !box.open) continue;
        box.open = false;
        // the next one to do opens, unless Ryan is going into another box of the list himself
        if (!boxesOf(scope).some((other) => other.contains(target))) openNext(scope, box);
      }
    }
    function enter(target) {
      for (let box = target?.closest?.('details.box'); box; box = box.parentElement?.closest('details.box')) {
        if (!entered.has(box)) entered.set(box, box.dataset.state);
      }
    }
    // with the mouse, only on the click: a box folding while the button is down would move what is under it
    let pressing = false;
    document.addEventListener('pointerdown', () => { pressing = true; }, true);
    document.addEventListener('pointerup', () => setTimeout(() => { pressing = false; }), true);
    document.addEventListener('focusin', (event) => { if (!pressing) leave(event.target); enter(event.target); });
    document.addEventListener('click', (event) => { leave(event.target); enter(event.target); }, true);

    // ---------- tabs ----------
    let tab = 'project';
    function showTab(name) {
      // from the picture back to the page: the page shows where that picture sits (render() calls this on every render)
      const leaving = tab === 'picture' && name !== 'picture';
      tab = name;
      for (const t of ['project', 'picture', 'preview']) {
        $(`tab-${t}`).setAttribute('aria-selected', String(t === name));
        $(`pane-${t}`).hidden = t !== name;
      }
      if (name === 'preview') renderPreview();
      showStage();
      if (leaving) {
        renderReading();
        // only the page scrolls: scrollIntoView scrolls the window too, and on a phone the tab tapped would move away
        const reading = $('reading');
        const img = reading.querySelector(`img[data-key="${CSS.escape(current().image.key)}"]`);
        if (img) {
          const box = img.getBoundingClientRect();
          const view = reading.getBoundingClientRect();
          reading.scrollTop += box.top - view.top - (view.height - box.height) / 2;
        }
      }
    }
    for (const t of ['project', 'picture', 'preview']) $(`tab-${t}`).addEventListener('click', () => showTab(t));

    // ---------- keyword chips ----------
    // The callers bind onAdd and onRemove to the project or picture the chips were drawn for, so a word still
    // in the box when Ryan moves on lands where he typed it, not on the next project.
    // `container`: the box's id, or the box itself (an article picture's)
    function renderChips(container, words, {inherited = [], onRemove, onAdd, placeholder}) {
      const box = typeof container === 'string' ? $(container) : container;
      const input = el('input', {type: 'text', placeholder, autocomplete: 'off'});
      input.setAttribute('aria-label', placeholder);
      const refocus = () => box.querySelector('input')?.focus();
      input.addEventListener('keydown', (event) => {
        if ((event.key === 'Enter' || event.key === ',') && input.value.trim()) {
          event.preventDefault();
          const word = input.value.trim();
          input.value = '';
          onAdd(word);
          refocus();
        } else if (event.key === 'Backspace' && !input.value && words.length) {
          onRemove(words.at(-1));
          refocus();
        }
      });
      // leaving the box keeps the word, but quietly: no redraw under the pointer (a click on × or an idea
      // still lands) and the focus stays where Ryan put it
      input.addEventListener('blur', () => {
        const word = input.value.trim();
        if (!word) return;
        input.value = '';
        onAdd(word, {quiet: true});
      });
      box.replaceChildren(
        ...inherited.map((word) => el('span', {className: 'chip inherited', textContent: word, title: 'From the project'})),
        ...words.map((word) => {
          const remove = el('button', {type: 'button', textContent: '×', title: `Remove “${word}”`});
          remove.setAttribute('aria-label', `Remove ${word}`);
          remove.addEventListener('click', () => { onRemove(word); refocus(); });
          return el('span', {className: 'chip'}, word, remove);
        }),
        input,
      );
      return input;
    }
    const toggled = (words, word) => (words.some((w) => same(w, word)) ? words.filter((w) => !same(w, word)) : [...words, word]);
    // a quiet change is drawn a moment later, unless Ryan is typing in those chips again
    const later = (container, draw) => setTimeout(() => { if (!(typeof container === 'string' ? $(container) : container).contains(document.activeElement)) draw(); }, 300);
    function setProjectTags(list, project = current().project, {quiet = false} = {}) {
      setProject(project, 'tags', list.join(', '), project.keywords.join(', '));
      const draw = () => { if (current().project === project) { renderProjectWords(); renderPreview(); } };
      if (quiet) later('project-chips', draw);
      else draw();
    }
    function setImageTags(list, project = current().project, image = current().image, {quiet = false} = {}) {
      setImage(image, 'tags', list.join(', '), ownKeywords(project, image).join(', '));
      const draw = () => { if (current().image === image) renderImageWords(); };
      if (quiet) later('image-chips', draw);
      else draw();
    }
    function ideaButton(word, pressed, onClick, rating) {
      const button = el('button', {type: 'button', textContent: word});
      button.setAttribute('aria-pressed', String(pressed));
      button.addEventListener('click', onClick);
      const wrap = el('span', {className: 'idea'}, button);
      if (rating) {
        const badge = el('span', {className: 'rating', textContent: rating.badge + (rating.bing != null ? ` · Bing ${rating.bing}` : ''), title: rating.title});
        badge.dataset.level = rating.level === null ? 'none' : String(rating.level);
        wrap.append(badge);
        wrap.dataset.rising = String(typeof rating.trend === 'number' && rating.trend >= (DATA.ratingsInfo?.rising ?? 0.25));
      }
      return wrap;
    }

    // ---------- the Project tab ----------
    // Every idea in one list, all rated, most searched or read first (Ryan, 2026-10-26: "why seperated?
    // bring them together, and please can we get them all rated?"). The filters only narrow it.
    const IDEA_FILTERS = [
      {id: 'all', label: 'All'},
      {id: 'rising', label: 'Rising ↑'},
      {id: 'yours', label: 'Your words'},
      {id: 'search', label: 'Clients search'},
      {id: 'related', label: 'Related'},
      {id: 'bank', label: 'Word bank'},
    ];
    const FROM = {yours: 'from your captions', search: 'what clients search for', related: 'related, more read', bank: 'your word lists'};
    const key = (word) => String(word).toLowerCase().replace(/\s+/g, ' ').trim();
    // the filter chosen per list: the project's ideas, and the one for every article picture
    const ideaFilters = {};
    // the rated ideas `pairs` ([word, sources]) into `tabs`, `list` and `hint`; `toggle(word)` adds or removes one
    function drawIdeas({tabs, list, hint}, pairs, chosen, toggle, filterKey) {
      const filter = ideaFilters[filterKey] ?? 'all';
      const has = (word) => chosen.some((w) => same(w, word));
      const ideas = pairs.map(([tag, sources]) => ({...(DATA.ratings[key(tag)] ?? {tag, badge: '', level: null, trend: null}), tag, sources}));
      const rising = (idea) => typeof idea.trend === 'number' && idea.trend >= DATA.ratingsInfo.rising;
      tabs.replaceChildren(...IDEA_FILTERS.map((f) => {
        const n = f.id === 'all' ? ideas.length : f.id === 'rising' ? ideas.filter(rising).length : ideas.filter((idea) => idea.sources.includes(f.id)).length;
        const button = el('button', {type: 'button', textContent: `${f.label} ${n}`});
        button.setAttribute('aria-pressed', String(f.id === filter));
        button.disabled = !n && f.id !== 'all';
        button.addEventListener('click', () => { ideaFilters[filterKey] = f.id; drawIdeas({tabs, list, hint}, pairs, chosen, toggle, filterKey); });
        return button;
      }));
      const shown = ideas.filter((idea) => filter === 'all' || (filter === 'rising' ? rising(idea) : idea.sources.includes(filter)));
      list.replaceChildren(...(shown.length
        ? shown.map((idea) => ideaButton(idea.tag, has(idea.tag), () => toggle(idea.tag), idea.badge ? {...idea, title: [idea.title, idea.sources.map((s) => FROM[s]).join(', ')].filter(Boolean).join(' · ')} : null))
        : [el('span', {className: 'hint', textContent: 'Nothing here.'})]));
      const day = DATA.ratingsInfo.updatedAt ? ` Numbers of ${new Date(DATA.ratingsInfo.updatedAt).toLocaleDateString('en-GB', {day: 'numeric', month: 'short'})}.` : '';
      hint.textContent = `● 100+ · ●● 1,000+ · ●●● 10,000+ Wikipedia readers in 30 days. ≈ closest page. ↑ rising${DATA.ratingsInfo.bing ? '. Bing: searches in NL, 4 weeks' : ''}.${day}`;
    }
    function renderIdeas() {
      const {project} = current();
      drawIdeas({tabs: $('idea-tabs'), list: $('idea-list'), hint: $('idea-hint')}, project.ideas, projectTags(project),
        (word) => setProjectTags(toggled(projectTags(current().project), word)), 'project');
    }
    function renderProjectWords() {
      const {project} = current();
      const words = projectTags(project);
      const input = renderChips('project-chips', words, {
        placeholder: 'Add a tag',
