---
import { portfolios, photos, picture, SITE } from '../lib/portfolios.js';

const groups = portfolios.flatMap((portfolio) => portfolio.posts.map((post) => ({
  portfolio: portfolio.name,
  post,
  images: photos(post).filter((image) => !image.alt?.trim() && !image.caption?.trim()),
}))).filter((group) => group.images.length);
const count = groups.reduce((sum, group) => sum + group.images.length, 0);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Image-description queue — reddy.world</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, system-ui, sans-serif; background: #0f0f0f; color: #f5f5f0; }
    body { margin: 0; }
    main { width: min(74rem, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 6rem; }
    h1, h2 { font-family: Georgia, serif; }
    h1 { font-size: clamp(2.2rem, 6vw, 4.5rem); margin: 0 0 1rem; }
    .lead { max-width: 65ch; color: #c9c9c4; }
    .tools { position: sticky; top: 0; z-index: 2; display: flex; gap: .75rem; align-items: center; padding: 1rem 0; background: #0f0f0f; border-bottom: 1px solid #444; }
    button, .project { color: #0f0f0f; background: #c7a86d; border: 0; padding: .7rem 1rem; font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
    #status { color: #c9c9c4; }
    details { border-top: 1px solid #444; padding: 1rem 0; }
    summary { cursor: pointer; font-size: 1.15rem; font-weight: 700; }
    .project { display: inline-block; margin: 1rem 0; background: transparent; border: 1px solid #c7a86d; color: #c7a86d; }
    .images { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1rem; }
    figure { margin: 0; display: grid; gap: .6rem; align-content: start; }
    img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: contain; background: #1a1a1a; }
    textarea { width: 100%; min-height: 6rem; box-sizing: border-box; resize: vertical; padding: .7rem; color: #f5f5f0; background: #1a1a1a; border: 1px solid #666; font: inherit; }
    textarea:focus { outline: 2px solid #c7a86d; outline-offset: 2px; }
    small { color: #aaa; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <main>
    <h1>Describe the pictures</h1>
    <p class="lead">{count} pictures still have an automatic “project title, photo number” description. Open one project at a time, write only what is useful to someone who cannot see the picture, and export whenever you want. Your text stays in this browser until you export or clear it.</p>
    <div class="tools">
      <button id="export" type="button">Export descriptions</button>
      <button id="clear" type="button">Clear saved text</button>
      <span id="status" aria-live="polite">0 described</span>
    </div>
    {groups.map(({ portfolio, post, images }) => (
      <details>
        <summary>{post.title.trim()} · {portfolio} · {images.length}</summary>
        <a class="project" href={`${SITE}${post.path}`} target="_blank" rel="noreferrer">Open the project ↗</a>
        <div class="images">
          {images.map((image, index) => {
            const pic = picture(image);
            return (
              <figure>
                <img src={pic.src} srcset={pic.srcset} sizes="(max-width: 600px) 100vw, 280px" width={pic.width} height={pic.height} alt="" loading="lazy" decoding="async">
                <textarea data-image={image.url} aria-label={`Description for ${post.title.trim()}, picture ${index + 1}`} placeholder="Describe the useful visual information…"></textarea>
                <small>{image.url}</small>
              </figure>
            );
          })}
        </div>
      </details>
    ))}
  </main>
  <script is:inline>
    const STORE = 'reddy-world-image-descriptions-v1';
    const fields = [...document.querySelectorAll('textarea[data-image]')];
    const status = document.querySelector('#status');
    const read = () => { try { return JSON.parse(localStorage.getItem(STORE) || '{}'); } catch { return {}; } };
    const update = () => {
      const values = Object.fromEntries(fields.map((field) => [field.dataset.image, field.value.trim()]).filter(([, value]) => value));
      localStorage.setItem(STORE, JSON.stringify(values));
      status.textContent = `${Object.keys(values).length} described`;
      return values;
    };
    const saved = read();
    fields.forEach((field) => { field.value = saved[field.dataset.image] || ''; field.addEventListener('input', update); });
    update();
    document.querySelector('#export').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(update(), null, 2) + '\n'], {type: 'application/json'});
      const link = Object.assign(document.createElement('a'), {href: URL.createObjectURL(blob), download: 'reddy-world-image-descriptions.json'});
      link.click();
      URL.revokeObjectURL(link.href);
    });
    document.querySelector('#clear').addEventListener('click', () => {
      if (!confirm('Clear every saved description on this device?')) return;
      fields.forEach((field) => { field.value = ''; });
      update();
    });
  </script>
</body>
</html>
