---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { shot } from '../../lib/software.js';
import { PERSON_ID, ORIGIN, SITE, BASE } from '../../lib/portfolios.js';
import '../../styles/software.css';

const entries = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const cards = await Promise.all(entries.map(async (e) => ({
  e,
  hero: e.data.screenshots[0] && await shot(e.id, e.data.screenshots[0]),
})));
const pageUrl = `${SITE}/software/`;
const description = 'Software and websites by Ryan Reddy and Reddy.World Enterprises: apps for reading, focus, mail, speech, food and family passwords, with real screens and live links.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#software`,
    url: pageUrl,
    name: 'Software and websites',
    description,
    author: { '@type': 'Person', '@id': PERSON_ID, name: 'Ryan Reddy', url: `${ORIGIN}/` },
    hasPart: entries.map((e) => ({ '@id': `${SITE}/software/${e.id}/#work`, name: e.data.title, url: `${SITE}/software/${e.id}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Software', item: pageUrl },
    ],
  },
];
---
<Base
  title="Software and websites by Ryan Reddy · reddy.world"
  description={description}
  active="software"
  jsonLd={jsonLd}
  theme="paper"
  footnote="Software and websites, made by Reddy.World Enterprises."
>
  <section class="case software-index" aria-labelledby="software-title">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}/`}>Portfolio</a>
    </nav>
    <header class="case-head">
      <p class="eyebrow">Made by Reddy.World Enterprises</p>
      <h1 id="software-title">Software and websites</h1>
    </header>

    <ul class="app-cards">
      {cards.map(({ e, hero }) => (
        <li class="app-card">
          {hero && (
            <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 820px) 100vw, 540px" width={hero.width} height={hero.height} alt={hero.alt} loading="lazy" decoding="async">
          )}
          <div class="app-card-text">
            <p class="eyebrow">{e.data.eyebrow}</p>
            <h2><a href={`${BASE}/software/${e.id}/`}>{e.data.title}</a></h2>
            <p class="dek">{e.data.dek}</p>
            <p>{e.data.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
