---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import Compare from '../../components/Compare.astro';
import { shot } from '../../lib/software.js';
import { appFacts } from '../../lib/app-json.js';
import { PERSON_ID, ORIGIN, SITE, BASE, contactUrl } from '../../lib/portfolios.js';
import '../../styles/software.css';

export async function getStaticPaths() {
  const entries = await getCollection('software');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const pageUrl = `${SITE}/software/${entry.id}/`;
const shots = await Promise.all(d.screenshots.map((s) => shot(entry.id, s)));
// a before and an after picture head the page as a slider; otherwise the first picture does
const pairOf = (side) => shots.find((s, i) => d.screenshots[i].pair === side);
const before = pairOf('before');
const after = pairOf('after');
const compare = before && after && {
  before, after,
  beforeLabel: d.screenshots[shots.indexOf(before)].label ?? 'Before',
  afterLabel: d.screenshots[shots.indexOf(after)].label ?? 'After',
};
const rest = compare ? shots.filter((s) => s !== before && s !== after) : shots;
const hero = compare ? after : rest[0];
const figs = compare ? rest : rest.slice(1);
// version and date come from the app's own /app.json, read now (never typed by hand); the button is its store listing
const { stores, button, release } = await appFacts(d);
const day = (iso) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const host = (url) => new URL(url).host;

const author = { '@type': 'Person', '@id': PERSON_ID, name: 'Ryan Reddy', url: `${ORIGIN}/` };
const imageObject = (s) => ({
  '@type': 'ImageObject',
  contentUrl: `${ORIGIN}${s.url}`,
  url: `${ORIGIN}${s.url}`,
  width: s.width,
  height: s.height,
  caption: s.caption,
  creator: { '@id': PERSON_ID },
});
const work = d.kind === 'app'
  ? {
    '@type': 'SoftwareApplication',
    applicationCategory: d.category,
    operatingSystem: d.platform,
    url: d.live ?? stores[0]?.url ?? pageUrl,
    downloadUrl: stores[0]?.url,
    softwareVersion: release?.version,
    screenshot: shots.length ? shots.map(imageObject) : undefined,
  }
  : { '@type': 'CreativeWork', url: pageUrl, image: shots.length ? shots.map(imageObject) : undefined };
if (d.credit) work.isBasedOn = { '@type': 'CreativeWork', name: d.credit.name, url: d.credit.url };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...work,
    '@id': `${pageUrl}#work`,
    name: d.title,
    description: d.summary,
    mainEntityOfPage: pageUrl,
    author,
    dateModified: d.updated.toISOString().slice(0, 10),
    sameAs: d.repo,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Software', item: `${SITE}/software/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
const shareImage = hero && { url: `${ORIGIN}${hero.url}`, width: hero.width, height: hero.height, alt: hero.alt };
const facts = [
  ['For', d.audience],
  ['Made by', d.maker],
  ['Role', d.role],
  ['When', d.when],
  ['Built with', d.stack.join(', ')],
  ['Status', d.status],
  ['Version', release && `${release.version}${release.updated ? `, updated ${day(release.updated)}` : ''}`],
].filter(([, v]) => v);
---
<Base
  title={`${d.title}: ${d.dek.replace(/\.$/, '')} · reddy.world`}
  description={d.summary}
  image={shareImage}
  active="software"
  jsonLd={jsonLd}
  theme="paper"
  footnote="Software and websites by Ryan Reddy."
>
  <article class="case">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}/`}>Portfolio</a> <span aria-hidden="true">/</span> <a href={`${BASE}/software/`}>Software</a>
    </nav>

    <header class="case-head">
      <p class="eyebrow">{d.eyebrow}</p>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
    </header>

    {compare && (
      <div class="case-hero">
        <Compare before={compare.before} after={compare.after} beforeLabel={compare.beforeLabel} afterLabel={compare.afterLabel} caption={compare.after.caption} />
      </div>
    )}
    {!compare && hero && (
      <figure class="case-hero">
        <picture>
          {hero.dark && <source media="(prefers-color-scheme: dark)" srcset={hero.dark} sizes="(max-width: 1152px) 100vw, 1120px">}
          <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 1152px) 100vw, 1120px" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" decoding="async">
        </picture>
        <figcaption>{hero.caption}</figcaption>
      </figure>
    )}

    <div class="story"><Content /></div>

    <aside class="facts" aria-label={`${d.title} at a glance`}>
      <dl>
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        {stores.length > 0 && <div><dt>Get it</dt><dd>{stores.map((st, i) => <>{i > 0 && ', '}<a href={st.url}>{st.name}</a></>)}</dd></div>}
        {d.live && stores.length > 0 && <div><dt>Website</dt><dd><a href={d.live}>{host(d.live)}</a></dd></div>}
        {d.repo && <div><dt>Code</dt><dd><a href={d.repo}>{host(d.repo)}{new URL(d.repo).pathname}</a></dd></div>}
        {d.credit && <div><dt>Based on</dt><dd><a href={d.credit.url}>{d.credit.name}</a></dd></div>}
        {d.disclaimer && <div><dt>Note</dt><dd>{d.disclaimer}</dd></div>}
      </dl>
      {button && <a class="live" href={button.url}>{button.label} →</a>}
    </aside>

    {figs.length > 0 && (
      <div class="figs">
        {figs.map((s) => (
          <figure class:list={{ tall: s.tall }}>
            <picture>
              {s.dark && <source media="(prefers-color-scheme: dark)" srcset={s.dark} sizes={s.tall ? '260px' : '(max-width: 820px) 100vw, 360px'}>}
              <img src={s.src} srcset={s.srcset} sizes={s.tall ? '260px' : '(max-width: 820px) 100vw, 360px'} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async">
            </picture>
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <aside class="doors" aria-label="More">
      <a href="/">See all my work →</a>
      <a href={`${BASE}/software/`}>All software and websites</a>
      <a href={contactUrl({ project: entry.id })}>Plan a free 30-minute talk</a>
    </aside>
  </article>
</Base>
