---
import '../styles/global.css';
import { contactUrl, ORIGIN, SITE } from '../lib/portfolios.js';
import { jsonLdText } from '../lib/safe-output.js';

interface Props {
  title: string;
  description: string;
  image?: { url: string; width?: number; height?: number; alt?: string };
  active?: string;
  jsonLd?: object | object[];
  type?: string;
  article?: { published?: string; modified?: string; section?: string; tags?: string[] };
  // 'paper': reddy.world's light paper colours (the software pages); default the archive's dark
  theme?: 'paper';
  footnote?: string;
  // the page's main language; the header and footer stay marked English (an interview in Dutch, reddy.world#176)
  lang?: string;
}

const { title, description, image, active, jsonLd, type = 'website', article, theme,
  footnote = 'Selected work, notes and experiments by Ryan Reddy.', lang = 'en' } = Astro.props;
const chromeLang = lang === 'en' ? undefined : 'en';
// Astro.url includes the base, so this is the page's reddy.world/portfolio URL
const canonical = new URL(Astro.url.pathname, ORIGIN).href;
---
<!doctype html>
<html lang={lang} class={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="author" content="Ryan Reddy">
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content="reddy.world">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {image && <meta property="og:image" content={image.url}>}
  {image?.width && <meta property="og:image:width" content={String(image.width)}>}
  {image?.height && <meta property="og:image:height" content={String(image.height)}>}
  {image?.alt && <meta property="og:image:alt" content={image.alt}>}
  {article?.published && <meta property="article:published_time" content={article.published}>}
  {article?.modified && <meta property="article:modified_time" content={article.modified}>}
  {article && <meta property="article:author" content={`${ORIGIN}/`}>}
  {article?.section && <meta property="article:section" content={article.section}>}
  {article?.tags?.map((t) => <meta property="article:tag" content={t}>)}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
  {image && <meta name="twitter:image" content={image.url}>}
  {image?.alt && <meta name="twitter:image:alt" content={image.alt}>}
  <link rel="alternate" type="application/rss+xml" title="Ryan Reddy: projects" href={`${SITE}/rss.xml`}>
  <link rel="sitemap" href={`${ORIGIN}/sitemap.xml`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  {jsonLd && <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
  <!-- Google Analytics, the same property as the reddy.world app, so archive visits count as reddy.world's
       (Ryan, 2026-10-19). Only on reddy.world itself: previews and local builds are not counted. No ads. -->
  <script is:inline>
    if (location.hostname === 'reddy.world') {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-12SFENLZLH';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', 'G-12SFENLZLH');
    }
  </script>
</head>
<body>
  <header class="site-header" lang={chromeLang}>
    <div class="header-inner">
      <a href="https://reddy.world/?at=work" class="brand-link" title="Ryan Reddy — the wall">
        <span class="brand-sub">Ryan Reddy</span>
        <span class="brand-main">the work</span>
      </a>

      <nav class="portfolio-nav" aria-label="Browse work">
        <a href="https://reddy.world/?at=work" class="tab-btn">
          <span class="tab-title">The wall</span>
        </a>
      </nav>

      <div class="header-actions">
        <a href={contactUrl()} class="btn-back">Let’s get in touch</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer" lang={chromeLang}>
    <div class="footer-inner">
      <div>
        <p class="footer-name">Ryan Reddy</p>
        <p class="footer-copy">{footnote}</p>
      </div>
      <div class="footer-links">
        <a href="https://reddy.world">reddy.world</a>
        <a href={contactUrl()}>Contact</a>
        <a href="https://reddymaekers.com">ReddyMaekers</a>
        <a href="https://github.com/Ryan-Reddy">GitHub</a>
        <a href="https://www.linkedin.com/in/ryan-reddy-productions/">LinkedIn</a>
      </div>
    </div>
  </footer>
  <script>
    // Ryan's edit bar (src/lib/edit-bar.js): only in a browser where he is signed in to the desk,
    // or on a preview address with ?edit; nobody else loads it
    try {
      const preview = location.hostname !== 'reddy.world' && new URLSearchParams(location.search).has('edit');
      if (preview || localStorage.getItem('reddy-desk-owner') === '1') import('../lib/edit-bar.js');
    } catch {}
  </script>
</body>
</html>
